  $('ldCopy').addEventListener('click', function () {
    var link = inviteLink();
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(link).then(function () { toast('📋 Invite link copied'); }, function () { prompt('Copy this link', link); });
    else prompt('Copy this link', link);
  });

  // ---------- Start ----------
  S = null; applyState(init.state);
  if (init.autoJoin && S.me < 0 && S.status === 'waiting' && S.players.length < S.max) act({ type: 'join' });
  if (init.autoJoin && history.replaceState) history.replaceState(null, '', '/ludo/' + code);
  schedule(nextDelay(init.state.nextIn));
})();
</script>

