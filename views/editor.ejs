<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h2 class="mb-4"><%= heading %></h2>

        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="<%= action %>" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" id="title" name="title" maxlength="200"
                   value="<%= form.title || '' %>" required>
          </div>

          <div class="mb-3">
            <label for="slug" class="form-label">URL slug <span class="text-body-secondary">(optional)</span></label>
            <div class="input-group">
              <span class="input-group-text">/posts/</span>
              <input type="text" class="form-control" id="slug" name="slug" maxlength="100"
                     value="<%= form.slug || '' %>" placeholder="title se khud ban jayega">
            </div>
            <div class="form-text">
              Chhote English letters, numbers aur "-" (jaise <code>cricket-batting-tips</code>).
              <% if (isEdit) { %>Edit par purana slug wahi rehta hai; badlein ge to purana link kaam nahi karega.<% } %>
            </div>
          </div>

          <div class="row">
            <div class="col-md-5 mb-3">
              <label for="category" class="form-label">Category</label>
              <select class="form-select" id="category" name="category">
                <% categories.forEach(c => { %>
                  <option value="<%= c %>" <%= form.category === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
                <option value="__new__" <%= form.category === '__new__' ? 'selected' : '' %>>＋ Add new category…</option>
              </select>
              <input type="text" class="form-control mt-2" id="newCategory" name="new_category" maxlength="50"
                     value="<%= form.new_category || '' %>" placeholder="Nayi category ka naam (jaise Travel)"
                     <%= form.category === '__new__' ? '' : 'hidden' %>>
              <script>
                (function () {
                  var sel = document.getElementById('category');
                  var inp = document.getElementById('newCategory');
                  function sync() {
                    var isNew = sel.value === '__new__';
                    inp.hidden = !isNew;
                    inp.required = isNew;
                    if (isNew) inp.focus();
                  }
                  sel.addEventListener('change', sync);
                  inp.required = sel.value === '__new__';
                })();
              </script>
            </div>
            <div class="col-md-7 mb-3">
              <label for="cover_url" class="form-label">Cover image <span class="text-body-secondary">(optional)</span></label>
              <div class="input-group">
                <input type="text" class="form-control" id="cover_url" name="cover_url"
                       value="<%= form.cover_url || '' %>" placeholder="https://... ya Upload dabayein">
                <button type="button" class="btn btn-outline-primary" id="coverUploadBtn">Upload</button>
              </div>
              <input type="file" id="coverFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
              <div class="form-text" id="coverStatus">JPG, PNG, WebP ya GIF. Bari images upload se pehle khud chhoti ho jati hain.</div>
              <img id="coverPreview" src="<%= form.cover_url || '' %>" alt="" class="img-fluid rounded mt-2"
                   style="max-height:120px; <%= form.cover_url ? '' : 'display:none;' %>">
            </div>
          </div>

          <div class="mb-3">
            <label for="excerpt" class="form-label">Short summary <span class="text-body-secondary">(optional)</span></label>
            <input type="text" class="form-control" id="excerpt" name="excerpt" maxlength="300"
                   value="<%= form.excerpt || '' %>" placeholder="One or two lines shown on the home page">
          </div>

          <div class="mb-3">
            <label for="tags" class="form-label">Tags <span class="text-body-secondary">(comma separated, up to 8)</span></label>
            <input type="text" class="form-control" id="tags" name="tags"
                   value="<%= form.tags || '' %>" placeholder="nodejs, railway, deployment">
          </div>

          <div class="mb-3">
            <label for="poll_id" class="form-label">Vote contest <span class="text-body-secondary">(optional)</span></label>
            <select class="form-select" id="poll_id" name="poll_id">
              <option value="">— No contest in this post —</option>
              <% (locals.polls || []).forEach(pl => { %>
                <option value="<%= pl.id %>" <%= String(form.poll_id || '') === String(pl.id) ? 'selected' : '' %>><%= pl.kind === 'knockout' ? '[Knockout] ' : '' %><%= pl.title %></option>
              <% }) %>
            </select>
            <div class="form-text">Chuna hua contest post ke neeche (comments se pehle) vote widget ban kar nazar aayega, taake blog padhne wale wahin vote kar saken. Pehle 🗳️ Vote mein contest banayein.</div>
          </div>

          <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label for="content" class="form-label mb-0">Content (Markdown supported)</label>
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="insertImageBtn">Insert image</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="insertVideoBtn">Insert video</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="insertYoutubeBtn">YouTube</button>
              </div>
            </div>
            <input type="file" id="contentFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
            <input type="file" id="videoFile" accept="video/mp4,video/webm" hidden>
            <div class="form-text mb-1" id="videoStatus">Video: MP4 ya WebM, max <%= locals.videoMaxMb || 30 %> MB. Bari video ke liye YouTube par upload karke "YouTube" button se link daalein.</div>
            <textarea class="form-control font-monospace" id="content" name="content" rows="16" required><%= form.content || '' %></textarea>
          </div>
          <div class="form-text mb-4">
            Examples: <code># Heading</code>, <code>**bold**</code>, <code>*italic*</code>,
            <code>[link](https://...)</code>, <code>![alt](https://image-url)</code>, <code>- list item</code>,
            <code>&gt; quote</code>, <code>`code`</code>
          </div>

          <div class="card bg-body-tertiary border-0 mb-4">
            <div class="card-body">
              <h6 class="fw-bold mb-3">Publishing</h6>
              <div class="row g-3">
                <div class="col-md-5">
                  <label for="status" class="form-label">Status</label>
                  <select class="form-select" id="status" name="status">
                    <option value="publish" <%= form.status !== 'draft' ? 'selected' : '' %>>Publish</option>
                    <option value="draft" <%= form.status === 'draft' ? 'selected' : '' %>>Save as draft (sirf mujhe nazar aaye)</option>
                  </select>
                </div>
                <div class="col-md-7">
                  <label for="publish_at" class="form-label">Schedule <span class="text-body-secondary">(optional, <%= tz %> time)</span></label>
                  <input type="datetime-local" class="form-control" id="publish_at" name="publish_at"
                         value="<%= form.publish_at || '' %>">
                  <div class="form-text">Khali chhorein to abhi publish hogi. Future ki date dein to us waqt khud publish hogi.</div>
                </div>
              </div>

              <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="send_newsletter" name="send_newsletter"
                       <%= form.send_newsletter ? 'checked' : '' %> <%= locals.newsletterAlreadySent ? 'disabled' : '' %>>
                <label class="form-check-label" for="send_newsletter">
                  Publish hone par subscribers ko email bhejo
                  <% if (locals.newsletterAlreadySent) { %><span class="text-body-secondary">(is post ki email pehle ja chuki hai)</span><% } %>
                </label>
              </div>
            </div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.querySelector('form[method="POST"]');
    var csrf = form.querySelector('input[name="_csrf"]').value;
    var MAX_SIDE = 1600;            // is se bari image chhoti kar di jati hai
    var MAX_BYTES = 5 * 1024 * 1024;

    // Bari photo ko browser mein hi resize + compress karta hai (GIF jaisi hai waisi jati hai)
    async function prepare(file) {
      if (file.type === 'image/gif' || typeof createImageBitmap !== 'function') return file;
      try {
        var bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        var scale = Math.min(1, MAX_SIDE / Math.max(bmp.width, bmp.height));
        var canvas = document.createElement('canvas');
        canvas.width = Math.round(bmp.width * scale);
        canvas.height = Math.round(bmp.height * scale);
        canvas.getContext('2d').drawImage(bmp, 0, 0, canvas.width, canvas.height);
        var blob = await new Promise(function (res) { canvas.toBlob(res, 'image/webp', 0.82); });
        return blob && blob.size < file.size ? blob : file;
      } catch (e) { return file; }
    }

    async function upload(file) {
      var blob = await prepare(file);
      if (blob.size > MAX_BYTES) throw new Error('Image 5 MB se bari hai. Chhoti image chunein.');
      var res = await fetch('/upload-image', {
        method: 'POST',
        headers: { 'Content-Type': blob.type, 'x-csrf-token': csrf },
        body: blob
      });
      var data = {};
      try { data = await res.json(); } catch (e) {}
      if (!res.ok || !data.url) throw new Error(data.error || 'Upload nahi hui (' + res.status + ').');
      return data.url;
    }

    // ----- Cover image -----
    var coverUrl = document.getElementById('cover_url');
    var coverFile = document.getElementById('coverFile');
    var coverBtn = document.getElementById('coverUploadBtn');
    var coverStatus = document.getElementById('coverStatus');
    var coverPreview = document.getElementById('coverPreview');
    var showPreview = function () {
      if (coverUrl.value) { coverPreview.src = coverUrl.value; coverPreview.style.display = ''; }
      else { coverPreview.style.display = 'none'; }
    };
    coverUrl.addEventListener('change', showPreview);
    coverBtn.addEventListener('click', function () { coverFile.click(); });
    coverFile.addEventListener('change', async function () {
      var f = coverFile.files[0];
      if (!f) return;
      coverBtn.disabled = true; coverStatus.textContent = 'Uploading...';
      try {
        coverUrl.value = await upload(f);
        showPreview();
        coverStatus.textContent = 'Upload ho gayi. Post save karna na bhoolein.';
      } catch (e) { coverStatus.textContent = e.message; }
      coverBtn.disabled = false; coverFile.value = '';
    });

    // ----- Image inside content (Markdown mein ![alt](url) lagata hai) -----
    var content = document.getElementById('content');
    var contentFile = document.getElementById('contentFile');
    var insertBtn = document.getElementById('insertImageBtn');
    insertBtn.addEventListener('click', function () { contentFile.click(); });
    contentFile.addEventListener('change', async function () {
      var f = contentFile.files[0];
      if (!f) return;
      var label = insertBtn.textContent;
      insertBtn.disabled = true; insertBtn.textContent = 'Uploading...';
      try {
        var url = await upload(f);
        var alt = f.name.replace(/\.[^.]+$/, '').replace(/[\[\]]/g, '');
        var md = '\n![' + alt + '](' + url + ')\n';
        var pos = content.selectionStart != null ? content.selectionStart : content.value.length;
        content.value = content.value.slice(0, pos) + md + content.value.slice(content.selectionEnd || pos);
        content.focus(); content.selectionStart = content.selectionEnd = pos + md.length;
      } catch (e) { alert(e.message); }
      insertBtn.disabled = false; insertBtn.textContent = label; contentFile.value = '';
    });

    // ----- Cursor par text daalne ka helper -----
    function insertAtCursor(md) {
      var pos = content.selectionStart != null ? content.selectionStart : content.value.length;
      content.value = content.value.slice(0, pos) + md + content.value.slice(content.selectionEnd || pos);
      content.focus(); content.selectionStart = content.selectionEnd = pos + md.length;
    }

    // ----- Video upload (progress ke saath) -----
    var VIDEO_MAX = <%= locals.videoMaxMb || 30 %> * 1024 * 1024;
    var videoFile = document.getElementById('videoFile');
    var videoBtn = document.getElementById('insertVideoBtn');
    var videoStatus = document.getElementById('videoStatus');
    var videoHint = videoStatus.textContent;

    function uploadVideo(file) {
      return new Promise(function (resolve, reject) {
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/upload-video');
        xhr.setRequestHeader('Content-Type', file.type);
        xhr.setRequestHeader('x-csrf-token', csrf);
        xhr.upload.onprogress = function (e) {
          if (e.lengthComputable) videoStatus.textContent = 'Uploading video... ' + Math.round(e.loaded / e.total * 100) + '%';
        };
        xhr.onload = function () {
          var data = {};
          try { data = JSON.parse(xhr.responseText); } catch (e) {}
          if (xhr.status >= 200 && xhr.status < 300 && data.url) resolve(data.url);
          else reject(new Error(data.error || 'Video upload nahi hui (' + xhr.status + ').'));
        };
        xhr.onerror = function () { reject(new Error('Network error. Dobara try karein.')); };
        xhr.send(file);
      });
    }

    videoBtn.addEventListener('click', function () { videoFile.click(); });
    videoFile.addEventListener('change', async function () {
      var f = videoFile.files[0];
      if (!f) return;
      if (f.type !== 'video/mp4' && f.type !== 'video/webm') {
        videoStatus.textContent = 'Sirf MP4 ya WebM video chalti hai (iPhone .mov ko pehle MP4 mein export karein).';
        videoFile.value = ''; return;
      }
      if (f.size > VIDEO_MAX) {
        videoStatus.textContent = 'Video ' + Math.round(f.size / 1048576) + ' MB ki hai; hadd ' + Math.round(VIDEO_MAX / 1048576) + ' MB hai. Chhoti karein ya YouTube use karein.';
        videoFile.value = ''; return;
      }
      videoBtn.disabled = true;
      try {
        var url = await uploadVideo(f);
        insertAtCursor('\n\n<video src="' + url + '" controls></video>\n\n');
        videoStatus.textContent = 'Video daal di gayi. Post save karna na bhoolein.';
      } catch (e) { videoStatus.textContent = e.message; }
      videoBtn.disabled = false; videoFile.value = '';
    });

    // ----- YouTube link se embed -----
    document.getElementById('insertYoutubeBtn').addEventListener('click', function () {
      var link = prompt('YouTube video ka link paste karein:');
      if (!link) return;
      var m = link.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|shorts\/|embed\/|live\/))([\w-]{11})/);
      if (!m) { alert('Ye YouTube ka sahi link nahi lagta.'); return; }
      insertAtCursor('\n\n<iframe src="https://www.youtube-nocookie.com/embed/' + m[1] + '" title="YouTube video"></iframe>\n\n');
      videoStatus.textContent = videoHint;
    });
  })();
</script>

<%- include('partials/footer') %>