<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-3 p-md-4">
        <h1 class="fw-bold h3 mb-3"><%= st.title %></h1>

        <%- include('partials/sponsor-banner', { ex: ex, pollId: st.id }) %>

        <% if (notice) { %><div class="alert alert-info py-2"><%= notice %></div><% } %>

        <% if (pickPreview) { %>
          <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>You are voting for <strong><%= pickPreview.name %></strong></span>
            <form action="/votes/<%= st.id %>/vote" method="POST" class="mb-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button name="option" value="<%= pickPreview.id %>" class="btn btn-warning fw-semibold">✔ Confirm my vote</button>
            </form>
          </div>
        <% } %>

        <%- include('partials/poll-block', { st: st, compact: false, ret: '' }) %>

        <hr>
        <h6 class="fw-bold">📣 Share this contest</h6>
        <div class="d-flex flex-wrap gap-2" id="contestShare">
          <a class="btn btn-success" data-share="whatsapp" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent(waText) %>">WhatsApp</a>
          <a class="btn btn-primary" data-share="facebook" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrls.facebook) %>">Facebook</a>
          <button type="button" class="btn btn-outline-secondary" data-share="copy" data-url="<%= shareUrls.copy %>">Copy link</button>
          <button type="button" class="btn btn-outline-secondary d-none" data-share="native" id="nativeShare" data-url="<%= shareUrls.copy %>" data-title="<%= st.title %>">More…</button>
        </div>

        <% if (isAdmin) { %>
          <hr>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="small fw-semibold">Admin:</span>
            <% if (st.kind === 'knockout' && st.open) { %>
              <form action="/votes/<%= st.id %>/advance" method="POST" class="mb-0"
                    onsubmit="return confirm('Close the current round now and move the winners to the next round?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-warning">⏭ End this round now</button>
              </form>
            <% } %>
            <form action="/votes/<%= st.id %>/toggle" method="POST" class="mb-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-secondary"><%= st.isClosed ? 'Reopen voting' : 'Close voting' %></button>
            </form>
            <form action="/votes/<%= st.id %>/delete" method="POST" class="mb-0" onsubmit="return confirm('Contest aur uske saare votes delete karein?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </div>
          <% if (st.kind === 'knockout') { %>
            <p class="small text-body-secondary mt-2 mb-0">Tie in a match: the contender listed first in the bracket goes through.</p>
          <% } %>
          <p class="small text-body-secondary mt-1 mb-0">To show this contest inside a blog post: edit the post and pick it under “Vote contest”.</p>

          <hr id="sponsor-admin">
          <h6 class="fw-bold">🤝 Sponsor, prize &amp; giveaway</h6>
          <form action="/votes/<%= st.id %>/sponsor" method="POST" class="mb-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%- include('partials/sponsor-fields', { v: ex }) %>
            <button class="btn btn-sm btn-primary mt-3">Save sponsor &amp; prize</button>
            <a href="/votes/<%= st.id %>/report" class="btn btn-sm btn-outline-secondary mt-3 ms-1">📊 Sponsor report</a>
          </form>

          <% if (ex.prize && adminX) { %>
            <div class="border rounded-3 p-3">
              <div class="fw-semibold mb-1">🎁 Giveaway draw</div>
              <div class="small text-body-secondary mb-2">
                Eligible: <%= ex.giveaway_pool === 'winner' ? (adminX.eligibleWinner == null ? 'available once there is a clear winner' : adminX.eligibleWinner + ' verified voters who backed the winner') : adminX.eligibleAll + ' verified voters' %>
                (admin and unverified accounts are never included).
                <% if (ex.giveaway_ref_bonus) { %><br>🤝 Invite bonus is ON: every friend a voter brought (verified + active) adds 1 extra entry, up to 5.<% } %>
              </div>
              <% if (ex.giveaway_username) { %>
                <div class="mb-2">Winner: <strong><%= ex.giveaway_username %></strong><% if (adminX.winnerEmail) { %> · <a href="mailto:<%= adminX.winnerEmail %>"><%= adminX.winnerEmail %></a><% } %>
                  <span class="small text-body-secondary">(drawn from <%= ex.giveaway_count %><%= ex.giveaway_redraws ? ', redrawn ' + ex.giveaway_redraws + 'x' : '' %>)</span></div>
                <form action="/votes/<%= st.id %>/giveaway" method="POST" class="mb-0" onsubmit="return confirm('Redraw? The current winner will be replaced (and cannot win again).')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="redraw" value="1">
                  <button class="btn btn-sm btn-outline-warning">Winner not reachable? Redraw</button>
                </form>
              <% } else if (st.open) { %>
                <button class="btn btn-sm btn-secondary" disabled>Close the contest (or wait for it to end) to draw</button>
              <% } else { %>
                <form action="/votes/<%= st.id %>/giveaway" method="POST" class="mb-0" onsubmit="return confirm('Pick a random winner now?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-success">🎲 Pick a random winner</button>
                </form>
              <% } %>
            </div>
          <% } else if (!ex.prize) { %>
            <p class="small text-body-secondary mb-0">Add a prize above to enable the giveaway draw.</p>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Comments -->
    <section id="comments" class="card border-0 shadow-sm mt-4">
      <div class="card-body p-4">
        <h5 class="mb-3">Comments (<%= commentCount %>)</h5>

        <% if (commentError) { %><div class="alert alert-danger"><%= commentError %></div><% } %>
        <% if (locals.commentNotice) { %><div class="alert alert-info"><%= commentNotice %></div><% } %>
        <% if (locals.reportedFlash) { %><div class="alert alert-success">Thanks! Your report was sent to the site owner.</div><% } %>

        <% if (user) { %>
          <form action="/votes/<%= st.id %>/comments" method="POST" class="mb-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <textarea class="form-control mb-2" name="body" rows="3" maxlength="1000" placeholder="Who gets your vote, and why?" required></textarea>
            <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
          </form>
        <% } else { %>
          <p class="text-body-secondary"><a href="/login">Log in</a> or <a href="/signup">sign up</a> to comment.</p>
        <% } %>

        <% if (commentCount === 0) { %><p class="text-body-secondary mb-0">No comments yet. Be the first!</p><% } %>

        <% const renderComment = (c, isReply) => { %>
          <% const canSee = !c.is_hidden || isAdmin || (user && user.id === c.user_id); %>
          <% if (!canSee) { %>
            <div id="c<%= c.id %>" class="py-3 border-top text-body-secondary fst-italic <%= isReply ? 'reply-box' : '' %>">This comment is hidden while the site owner reviews it.</div>
          <% return; } %>
          <div id="c<%= c.id %>" class="d-flex gap-3 py-3 border-top <%= isReply ? 'reply-box' : '' %>">
            <span class="avatar"><%= c.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(c.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><a href="/u/<%= encodeURIComponent(c.username) %>" class="text-reset text-decoration-none"><%= c.username %></a></strong>
                  <small class="text-body-secondary ms-2"><%= new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
                  <% if (c.is_hidden) { %><span class="badge text-bg-warning ms-1">Under review<%= isAdmin ? '' : ' (only you can see this)' %></span><% } %>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <% if (user && user.id !== c.user_id) { %>
                    <button type="button" class="btn btn-link btn-sm text-body-secondary p-0" data-bs-toggle="modal" data-bs-target="#reportModal"
                            data-report-type="poll_comment" data-report-id="<%= c.id %>">Report</button>
                  <% } %>
                  <% if (user && (isAdmin || user.id === c.user_id)) { %>
                    <form action="/vote-comments/<%= c.id %>/delete" method="POST" class="mb-0" onsubmit="return confirm('Delete this comment?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
              <div class="comment-body"><%= c.body %></div>

              <% if (user) { %>
                <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#reply-<%= c.id %>">Reply</button>
                <div class="collapse mt-2" id="reply-<%= c.id %>">
                  <form action="/votes/<%= st.id %>/comments" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="parent_id" value="<%= c.id %>">
                    <textarea class="form-control form-control-sm mb-2" name="body" rows="2" maxlength="1000" placeholder="Reply to <%= c.username %>..." required></textarea>
                    <button type="submit" class="btn btn-primary btn-sm">Post Reply</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% }; %>

        <% threads.forEach(t => { %>
          <% renderComment(t, false); %>
          <% t.replies.forEach(r => { renderComment(r, true); }); %>
        <% }) %>
      </div>
    </section>

    <div class="text-center mt-3">
      <a href="/votes" class="text-decoration-none">← All contests</a>
      <% if (user) { %>
        <span class="text-body-secondary mx-2">·</span>
        <button type="button" class="btn btn-link btn-sm text-body-secondary p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#reportModal"
                data-report-type="poll" data-report-id="<%= st.id %>">🚩 Report this contest</button>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/poll-script') %>

<script>
  // Contest share buttons (upar wale): ginti + copy + native share
  (function () {
    var box = document.getElementById('contestShare');
    var csrf = document.querySelector('.poll-block [name=_csrf]').value;
    var pid = <%= st.id %>;
    function count(ch) {
      try { var fd = new URLSearchParams(); fd.set('ch', ch); fd.set('_csrf', csrf); navigator.sendBeacon('/votes/' + pid + '/share', fd); } catch (e) {}
    }
    var ns = document.getElementById('nativeShare');
    if (navigator.share) ns.classList.remove('d-none');
    box.addEventListener('click', function (e) {
      var t = e.target.closest('[data-share]');
      if (!t) return;
      var ch = t.dataset.share;
      count(ch);
      if (ch === 'copy') {
        var url = t.dataset.url;
        (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject()).then(function () {
          t.textContent = 'Copied ✅'; setTimeout(function () { t.textContent = 'Copy link'; }, 2000);
        }).catch(function () { window.prompt('Copy this link:', url); });
      } else if (ch === 'native') {
        navigator.share({ title: t.dataset.title, url: t.dataset.url }).catch(function () {});
      }
    });
  })();
</script>

<%- include('partials/report-modal') %>

<%- include('partials/footer') %>
