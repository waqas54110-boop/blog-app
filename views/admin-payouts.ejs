<%- include('partials/header') %>

<% const fmt = (d) => new Date(d).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }); %>
<% const mLabel = { jazzcash: 'JazzCash', easypaisa: 'Easypaisa' }; %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">💸 Payouts <% if (d.pending.length) { %><span class="badge bg-danger align-middle fs-6"><%= d.pending.length %></span><% } %></h2>
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.text %></div><% } %>

<div class="row g-3 mb-4">
  <div class="col-6"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="small text-body-secondary">Owed to users (wallets)</div><div class="fs-4 fw-bold">Rs <%= rs(d.owed) %></div>
  </div></div></div>
  <div class="col-6"><div class="card border-0 shadow-sm"><div class="card-body">
    <div class="small text-body-secondary">Paid so far</div><div class="fs-4 fw-bold">Rs <%= rs(d.paid) %></div>
  </div></div></div>
</div>

<p class="small text-body-secondary">
  Send the money from your own JazzCash / Easypaisa app to the number shown, then press <strong>Mark paid</strong>.
  Reject returns the amount to the user's balance.
</p>

<% if (!d.pending.length) { %>
  <div class="card border-0 shadow-sm mb-4"><div class="card-body text-center text-body-secondary py-5">No pending requests. 🎉</div></div>
<% } %>

<% d.pending.forEach(r => { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <span class="fs-5 fw-bold">Rs <%= rs(r.amount_paisa) %></span>
        <span class="badge text-bg-secondary"><%= mLabel[r.method] %></span>
        <span class="small text-body-secondary ms-auto"><%= fmt(r.created_at) %></span>
      </div>
      <div class="mb-2">
        <div><strong><%= r.account_number %></strong> · <%= r.account_name %></div>
        <div class="small text-body-secondary">
          User: <a href="/u/<%= encodeURIComponent(r.username) %>"><%= r.username %></a> · <%= r.email %> ·
          earned Rs <%= rs(r.total_earned_paisa) %> total, paid Rs <%= rs(r.total_paid_paisa) %>
        </div>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <form action="/admin/payouts/<%= r.id %>/paid" method="POST" class="d-flex gap-2 flex-grow-1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="txn_ref" class="form-control form-control-sm" maxlength="60" placeholder="Transaction ID (optional)">
          <button class="btn btn-success btn-sm text-nowrap" type="submit" onclick="return confirm('Did you already send Rs <%= rs(r.amount_paisa) %> to <%= r.account_number %>?')">Mark paid</button>
        </form>
        <form action="/admin/payouts/<%= r.id %>/reject" method="POST" class="d-flex gap-2 flex-grow-1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="note" class="form-control form-control-sm" maxlength="200" placeholder="Reason (shown to user)">
          <button class="btn btn-outline-danger btn-sm text-nowrap" type="submit">Reject</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>

<% if (d.done.length) { %>
  <h5 class="mt-4 mb-3">Recent</h5>
  <div class="card border-0 shadow-sm"><div class="card-body">
    <% d.done.forEach(r => { %>
      <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom py-2 gap-2">
        <div>
          <strong>Rs <%= rs(r.amount_paisa) %></strong> · <%= r.username %> · <%= mLabel[r.method] %> <%= r.account_number %>
          <div class="small text-body-secondary"><%= r.processed_at ? fmt(r.processed_at) : '' %><% if (r.txn_ref) { %> · Ref <%= r.txn_ref %><% } %><% if (r.admin_note) { %> · <%= r.admin_note %><% } %></div>
        </div>
        <span class="badge text-bg-<%= r.status === 'paid' ? 'success' : 'danger' %>"><%= r.status === 'paid' ? 'Paid' : 'Rejected' %></span>
      </div>
    <% }) %>
  </div></div>
<% } %>

<%- include('partials/footer') %>
