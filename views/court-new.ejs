<%- include('partials/header') %>
<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm"><div class="card-body p-3 p-md-4">
      <h1 class="h3 fw-bold mb-1">File a new case</h1>
      <p class="text-body-secondary">Ask one clear question with two honest sides. Keep the background neutral: the lawyers do the persuading.</p>
      <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
      <form action="/court" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label fw-semibold" for="title">The question</label>
          <input class="form-control" id="title" name="title" maxlength="160" required placeholder="Should the government cut petrol prices before the budget?">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold" for="summary">Neutral background</label>
          <textarea class="form-control" id="summary" name="summary" rows="5" maxlength="1200" required placeholder="What happened, who is involved, why people disagree. Facts only, no opinions."></textarea>
          <div class="form-text">At least 40 characters. Do not accuse named people of crimes. Stick to public facts and public statements.</div>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold" for="side_a">Side A</label>
            <input class="form-control" id="side_a" name="side_a" maxlength="60" required placeholder="Yes, cut prices now">
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold" for="side_b">Side B</label>
            <input class="form-control" id="side_b" name="side_b" maxlength="60" required placeholder="No, wait for the budget">
          </div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-6">
            <label class="form-label fw-semibold" for="recruit_hours">Lawyers can join for (hours)</label>
            <input class="form-control" type="number" id="recruit_hours" name="recruit_hours" value="48" min="1" max="336" required>
          </div>
          <div class="col-6">
            <label class="form-label fw-semibold" for="jury_hours">Jury votes for (hours)</label>
            <input class="form-control" type="number" id="jury_hours" name="jury_hours" value="24" min="1" max="168" required>
            <div class="form-text">The jury clock starts when the second lawyer argues.</div>
          </div>
        </div>
        <button class="btn btn-primary">File case</button>
        <a href="/court" class="btn btn-outline-secondary ms-1">Cancel</a>
      </form>
    </div></div>
  </div>
</div>
<%- include('partials/footer') %>
