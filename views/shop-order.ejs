<%- include('partials/header') %>
<%- include('partials/shop-style') %>

<%
  const _idx = STATUSES.indexOf(o.status);
  const _ret = o.status === 'returned';
%>
<div style="max-width:640px;margin:0 auto;">
  <% if (fresh) { %>
    <div class="text-center py-3">
      <div style="font-size:3rem;">🎉</div>
      <h1 class="fs-3 fw-bold mb-1">Order placed!</h1>
      <p class="text-body-secondary mb-0">Order <b>#<%= o.id %></b> has been sent to <%= o.shop_name %>.</p>
    </div>
    <% if (wa) { %>
      <div class="alert alert-success">
        <b>Important:</b> for faster confirmation, also send your order details on WhatsApp.
        <a class="btn btn-success w-100 rounded-pill mt-2 fw-semibold" target="_blank" rel="noopener noreferrer" href="<%= wa %>">💬 Send to seller on WhatsApp</a>
      </div>
    <% } %>
  <% } else { %>
    <h1 class="fs-3 fw-bold my-3">Order #<%= o.id %></h1>
  <% } %>

  <div class="sh-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <div class="sh-h mb-0">Order status</div>
      <span class="sh-pill" style="background:<%= _ret ? '#dc3545' : '#12a37f' %>;"><%= STATUS_LABEL[o.status] %></span>
    </div>
    <% if (_ret) { %>
      <div class="sh-stat">This order was returned.</div>
    <% } else { %>
      <div class="d-flex justify-content-between text-center" style="font-size:.8rem;">
        <% ['new', 'shipped', 'delivered'].forEach((s, i) => { %>
          <div style="flex:1;">
            <div style="width:28px;height:28px;border-radius:50%;margin:0 auto .2rem;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;background:<%= i <= _idx ? '#12a37f' : 'var(--bs-secondary-bg)' %>;"><%= i <= _idx ? '✓' : (i + 1) %></div>
            <%= STATUS_LABEL[s] %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <div class="sh-stat mt-2">Bookmark this page to check your order status anytime.</div>
  </div>

  <% if (courier) { %>
  <div class="sh-card" style="border-color:#3b82f6;">
    <div class="sh-h">📦 Courier and tracking</div>
    <div><b><%= courier.name %></b><% if (courier.no) { %> · Tracking number: <b id="trkNo"><%= courier.no %></b><% } %></div>
    <% if (courier.no && courier.link) { %>
      <div class="d-flex gap-2 flex-wrap mt-2">
        <a class="btn btn-primary rounded-pill" id="trkBtn" target="_blank" rel="noopener noreferrer" href="<%= courier.link.url %>" data-copy="<%= courier.link.direct ? '' : courier.no %>">🔎 Track package</a>
        <button type="button" class="btn btn-outline-secondary rounded-pill" id="trkCopy" data-copy="<%= courier.no %>">📋 Copy number</button>
      </div>
      <% if (!courier.link.direct) { %><div class="sh-stat mt-1">Paste this number on the <%= courier.name %> official page (the number is copied automatically when you click “Track package”).</div><% } %>
    <% } else if (courier.no) { %>
      <div class="sh-stat mt-1">Use this number to track your parcel on the courier's website / app.</div>
    <% } %>
  </div>
  <% } %>

  <div class="sh-card">
    <% o.items.forEach((it, idx) => { %>
      <div class="d-flex gap-3 <%= idx ? 'pt-2 mt-2 border-top' : '' %>">
        <% if (!idx && o.image_id && o.items.length === 1) { %><img src="/img/<%= o.image_id %>" alt="" style="width:72px;height:72px;object-fit:cover;border-radius:12px;"><% } %>
        <div class="flex-grow-1">
          <div class="fw-bold"><% if (it.product_slug) { %><a class="text-decoration-none text-body" href="/shop/<%= o.shop_slug %>/<%= it.product_slug %>"><%= it.product_name %></a><% } else { %><%= it.product_name %><% } %></div>
          <% if (it.variant_label) { %><div class="sh-stat">Option: <b><%= it.variant_label %></b></div><% } %>
          <div class="sh-stat">Rs <%= rs(it.unit_price_rs) %> x <%= it.qty %></div>
        </div>
        <div class="fw-semibold text-nowrap">Rs <%= rs(it.unit_price_rs * it.qty) %></div>
      </div>
    <% }) %>
    <hr class="my-2">
    <% if (o.items.length > 1 || o.discount_rs > 0) { %><div class="d-flex justify-content-between small"><span>Items</span><span>Rs <%= rs(o.subtotal_rs) %></span></div><% } %>
    <% if (o.discount_rs > 0) { %><div class="d-flex justify-content-between small text-success"><span>Coupon <%= o.coupon_code || '' %></span><span>- Rs <%= rs(o.discount_rs) %></span></div><% } %>
    <div class="d-flex justify-content-between small"><span>Delivery</span><span><%= o.delivery_rs ? 'Rs ' + rs(o.delivery_rs) : 'Free' %></span></div>
    <div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span style="color:#12a37f;">Rs <%= rs(o.total_rs) %></span></div>
    <div class="sh-stat"><%= PAY_LABEL[o.payment_method] || o.payment_method %></div>
  </div>

  <div class="sh-card small">
    <div class="sh-h">Delivery details</div>
    <div><b><%= o.customer_name %></b> · <%= showPhone(o.phone) %></div>
    <div><%= o.address %>, <%= o.city %></div>
    <% if (o.note) { %><div class="text-body-secondary mt-1">Note: <%= o.note %></div><% } %>
  </div>

  <div class="d-flex gap-2 flex-wrap justify-content-center mb-4">
    <% if (!fresh && wa) { %><a class="btn btn-outline-success rounded-pill" target="_blank" rel="noopener noreferrer" href="https://wa.me/<%= o.shop_whatsapp %>">💬 Chat with seller</a><% } %>
    <a class="btn btn-outline-secondary rounded-pill" href="/shop/<%= o.shop_slug %>">Back to shop</a>
  </div>
</div>

<script>
(function () {
  function copy(t, done) {
    if (!t) return;
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(done || function () {}, function () {});
    else { var ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); if (done) done(); } catch (e) {} ta.remove(); }
  }
  var b = document.getElementById('trkBtn');
  if (b) b.addEventListener('click', function () { copy(b.getAttribute('data-copy')); }); /* copy the number as soon as the link opens */
  var c = document.getElementById('trkCopy');
  if (c) c.addEventListener('click', function () {
    copy(c.getAttribute('data-copy'), function () { var o = c.textContent; c.textContent = '✓ Copied'; setTimeout(function () { c.textContent = o; }, 1400); });
  });
})();
</script>

<%- include('partials/footer') %>
