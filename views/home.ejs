<%- include('partials/header') %>

<% const kfmt = (n) => { n = Number(n) || 0; return n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'K' : String(n); }; %>

<style>
  .kz-home a { color: inherit; text-decoration: none; }
  .kz-art { display: block; position: relative; overflow: hidden; border-radius: 14px; aspect-ratio: 16 / 9; }
  .kz-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .kz-art b { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 800 clamp(48px, 9vw, 96px)/1 var(--kz-serif); color: rgba(255,255,255,.3); }
  .g1 { background: linear-gradient(135deg, #12355b, #0a6b4d 60%, #9bd1a8); }
  .g2 { background: linear-gradient(135deg, #5a1e3a, #c1553b); }
  .g3 { background: linear-gradient(135deg, #1c3d5a, #3d8fb5); }
  .g4 { background: linear-gradient(135deg, #3b2a63, #8a63d2); }
  .g5 { background: linear-gradient(135deg, #1b4d3e, #5fb98a); }
  .kz-chip { display: inline-block; font: 700 12px/1 var(--kz-sans); padding: 6px 12px; border-radius: 99px; background: var(--c, var(--kz-accent)); color: #fff; position: relative; z-index: 3; box-shadow: 0 4px 14px color-mix(in srgb, var(--c, var(--kz-accent)) 45%, transparent); }
  .kz-chip:hover { filter: brightness(1.12); }
  .kz-cat { font: 700 13px var(--kz-sans); color: var(--c, var(--kz-accent)); position: relative; z-index: 3; }
  [data-bs-theme="dark"] .kz-cat { color: color-mix(in srgb, var(--c, var(--kz-accent)) 55%, #fff); }
  .kz-cat:hover { text-decoration: underline; text-underline-offset: 3px; }
  .kz-by { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; font: 400 13px var(--kz-sans); color: var(--kz-muted); }
  .kz-by .avatar { width: 26px; height: 26px; font-size: 12px; background: var(--c, var(--kz-accent)); }
  .kz-by .sep { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: .55; }
  .kz-hd { display: flex; align-items: center; gap: 10px; font: 800 24px var(--kz-serif); margin: 0 0 16px; }
  .kz-hd::before { content: ""; width: 5px; height: 24px; border-radius: 3px; background: var(--kz-accent); }

  /* ticker */
  .kz-ticker { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; background: var(--kz-paper); border: 1px solid var(--kz-line); border-radius: 99px; padding: 6px 14px 6px 6px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,.04); }
  .kz-ticker > b { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 7px; font: 700 12px/1 var(--kz-sans); background: var(--kz-live, #c8102e); color: #fff; padding: 7px 12px; border-radius: 99px; }
  .kz-ticker > b i { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: kzpulse 1.6s ease-in-out infinite; }
  @keyframes kzpulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .35; transform: scale(.7); } }
  .kz-track { flex: 1; min-width: 0; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .kz-roll { display: flex; width: max-content; animation: kzroll 55s linear infinite; }
  .kz-track:hover .kz-roll, .kz-track:focus-within .kz-roll { animation-play-state: paused; }
  .kz-roll div { display: flex; flex: 0 0 auto; }
  .kz-roll a { font: 600 14px var(--kz-sans); white-space: nowrap; padding: 0 22px; border-right: 1px solid var(--kz-line); }
  .kz-roll a:hover { color: var(--kz-accent); }
  @keyframes kzroll { to { transform: translateX(-50%); } }

  /* layout */
  .kz-front { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 28px; }

  /* slider */
  .kz-slider { position: relative; border-radius: 18px; overflow: hidden; height: clamp(360px, 46vw, 500px); background: #0e1a2b; isolation: isolate; box-shadow: 0 18px 50px rgba(8,15,28,.22); }
  .kz-slide { position: absolute; inset: 0; display: flex; align-items: flex-end; color: #fff; opacity: 0; visibility: hidden; transition: opacity .8s ease, visibility .8s; }
  .kz-slide.is-on { opacity: 1; visibility: visible; z-index: 1; }
  .kz-slide .kz-art { position: absolute; inset: 0; border-radius: 0; aspect-ratio: auto; z-index: -2; }
  .kz-slide.is-on .kz-art img { transform: scale(1.06); transition: transform 7s ease-out; }
  .kz-slide:not(.is-on) .kz-art img { transform: scale(1); transition: none; }
  .kz-slide::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(7,13,24,.95) 0%, rgba(7,13,24,.6) 40%, rgba(7,13,24,.06) 74%); }
  .kz-slide-in { padding: clamp(18px, 3.2vw, 34px); padding-bottom: clamp(34px, 4.4vw, 52px); width: 100%; }
  .kz-slide h1 { font: 800 clamp(26px, 4.2vw, 44px)/1.08 var(--kz-serif); letter-spacing: -.015em; margin: 12px 0 10px; text-wrap: balance; text-shadow: 0 2px 18px rgba(0,0,0,.35); }
  .kz-slide h1 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .kz-slide p { font: 400 17px/1.5 var(--kz-serif); color: rgba(255,255,255,.84); margin: 0 0 14px; max-width: 60ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .kz-slide .kz-by { color: rgba(255,255,255,.8); }
  .kz-pill { padding: 4px 10px; border-radius: 99px; background: rgba(255,255,255,.14); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.18); font-size: 12px; }
  .kz-dots { position: absolute; left: clamp(18px, 3.2vw, 34px); right: clamp(18px, 3.2vw, 34px); bottom: 16px; z-index: 5; display: flex; gap: 8px; }
  .kz-dot { flex: 1; height: 18px; padding: 8px 0; border: 0; background: none; cursor: pointer; }
  .kz-dot span { display: block; height: 3px; border-radius: 2px; background: rgba(255,255,255,.3); overflow: hidden; }
  .kz-dot i { display: block; height: 100%; width: 0; background: #fff; }
  .kz-dot.is-done i { width: 100%; }
  .kz-dot.is-on i { animation: kzfill 6.5s linear forwards; }
  .kz-slider.is-paused .kz-dot.is-on i { animation-play-state: paused; }
  @keyframes kzfill { to { width: 100%; } }
  .kz-nbtn { position: absolute; z-index: 5; top: 16px; width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(255,255,255,.28); background: rgba(8,15,28,.35); color: #fff; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: inline-flex; align-items: center; justify-content: center; font-size: 15px; cursor: pointer; transition: background .15s; }
  .kz-nbtn:hover { background: rgba(8,15,28,.6); }
  .kz-nbtn.pp { right: 16px; } .kz-nbtn.pv { right: 112px; } .kz-nbtn.nx { right: 64px; }
  .kz-slider.one .kz-dots, .kz-slider.one .kz-nbtn { display: none; }

  /* pair */
  .kz-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 26px; }
  .kz-pair article { position: relative; transition: transform .25s ease; }
  .kz-pair article:hover { transform: translateY(-4px); }
  .kz-pair article:hover .kz-art img, .kz-card:hover .kz-art img, .kz-sec .lead:hover .kz-art img { transform: scale(1.06); }
  .kz-pair .kz-art { aspect-ratio: 3 / 2; margin-bottom: 12px; }
  .kz-pair h2 { font: 700 21px/1.2 var(--kz-serif); margin: 5px 0 6px; }
  .kz-pair h2 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .kz-pair p { font: 400 15px/1.45 var(--kz-serif); color: var(--kz-muted); margin: 0 0 8px; }

  /* most read */
  .kz-rail { background: var(--kz-paper); border: 1px solid var(--kz-line); border-radius: 18px; padding: 8px 22px 14px; align-self: start; box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 14px 36px rgba(0,0,0,.06); position: sticky; top: 70px; }
  .kz-rail h3 { font: 800 21px var(--kz-serif); margin: 14px 0 6px; display: flex; align-items: center; gap: 10px; }
  .kz-rail h3::before { content: ""; width: 5px; height: 24px; border-radius: 3px; background: var(--kz-accent); }
  .kz-rail ol { list-style: none; margin: 0; padding: 0; counter-reset: n; }
  .kz-rail li { counter-increment: n; display: grid; grid-template-columns: 44px 1fr; gap: 8px; padding: 15px 0; border-top: 1px solid var(--kz-line); }
  .kz-rail li:first-child { border-top: 0; }
  .kz-rail li::before { content: counter(n); font: 800 38px/.95 var(--kz-serif); background: linear-gradient(160deg, var(--kz-accent), color-mix(in srgb, var(--kz-accent) 25%, transparent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .kz-rail h4 { font: 600 17px/1.28 var(--kz-serif); margin: 0 0 4px; }
  .kz-rail a:hover h4 { color: var(--kz-accent); }
  .kz-rail small { font: 400 12px var(--kz-sans); color: var(--kz-muted); }

  /* more stories strip */
  .kz-strip-wrap { margin-top: 46px; }
  .kz-strip { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 2px 18px; scrollbar-width: thin; }
  .kz-card { position: relative; flex: 0 0 min(280px, 78%); scroll-snap-align: start; transition: transform .25s ease; }
  .kz-card:hover { transform: translateY(-4px); }
  .kz-card .kz-art { aspect-ratio: 16 / 10; margin-bottom: 12px; }
  .kz-card h3 { font: 700 18px/1.25 var(--kz-serif); margin: 5px 0 6px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .kz-card h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* category sections */
  .kz-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; margin-top: 34px; }
  .kz-sec h3 { font: 800 24px var(--kz-serif); margin: 0 0 16px; }
  .kz-sec h3 a::after { content: ""; display: block; width: 44px; height: 4px; border-radius: 2px; background: var(--c, var(--kz-accent)); margin-top: 8px; transition: width .25s ease; }
  .kz-sec h3 a:hover::after { width: 90px; }
  .kz-sec .lead .kz-art { margin-bottom: 12px; }
  .kz-sec h4 { font: 700 19px/1.22 var(--kz-serif); margin: 0 0 6px; }
  .kz-sec .lead:hover h4, .kz-sec li a:hover { color: var(--c, var(--kz-accent)); }
  .kz-sec ul { list-style: none; margin: 14px 0 0; padding: 0; }
  .kz-sec li { padding: 12px 0 12px 14px; border-top: 1px solid var(--kz-line); font: 600 16px/1.3 var(--kz-serif); position: relative; }
  .kz-sec li::before { content: ""; position: absolute; left: 0; top: 19px; width: 6px; height: 6px; border-radius: 50%; background: var(--c, var(--kz-accent)); }
  .kz-sec li span { display: block; font: 400 12px var(--kz-sans); color: var(--kz-muted); margin-top: 3px; }
  .kz-more { text-align: center; margin: 44px 0 8px; }
  .kz-more a { display: inline-block; font: 700 14px var(--kz-sans); padding: 13px 30px; border-radius: 99px; background: var(--bs-body-color); color: var(--bs-body-bg); box-shadow: 0 10px 26px rgba(0,0,0,.18); transition: transform .2s, box-shadow .2s; }
  .kz-more a:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(0,0,0,.24); }

  /* scroll reveal (JS sirf neeche wale blocks par lagata hai) */
  .kz-rv { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
  .kz-rv.in { opacity: 1; transform: none; }

  @media (max-width: 860px) { .kz-front { grid-template-columns: 1fr; } .kz-rail { position: static; } }
  @media (max-width: 575px) {
    .kz-pair { grid-template-columns: 1fr; }
    .kz-slider { border-radius: 14px; height: 380px; }
    .kz-slide p { display: none; }
    .kz-nbtn.pv, .kz-nbtn.nx { display: none; }
    .kz-nbtn.pp { right: 12px; top: 12px; }
    .kz-ticker > b { padding: 7px 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kz-roll { animation: none; } .kz-track { overflow-x: auto; }
    .kz-dot.is-on i { animation: none; width: 100%; }
    .kz-slide, .kz-art img, .kz-rv, .kz-pair article, .kz-card { transition: none; }
    .kz-slide.is-on .kz-art img { transform: none; }
    .kz-rv { opacity: 1; transform: none; }
  }
</style>

<div class="kz-home">

<% if (locals.liveContest) { const lc = liveContest; %>
  <section class="card border-0 shadow-sm mb-4" id="live-contest">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h5 class="fw-bold mb-0">🔥 Live now: <%= lc.st.title %></h5>
        <a href="/votes/<%= lc.st.id %>#comments" class="small text-decoration-none">Open contest &amp; comments →</a>
      </div>
      <% if (lc.notice) { %><div class="alert alert-info py-2"><%= lc.notice %></div><% } %>
      <%- include('partials/sponsor-banner', { ex: lc.extras, pollId: lc.st.id }) %>
      <%- include('partials/poll-block', { st: lc.st, compact: true, ret: '/' }) %>
    </div>
  </section>
  <%- include('partials/poll-script') %>
<% } %>


<% if (locals.ticker && ticker.length > 1) { %>
  <div class="kz-ticker" role="region" aria-label="Latest headlines">
    <b><i></i>Latest</b>
    <div class="kz-track">
      <div class="kz-roll">
        <div><% ticker.forEach(t => { %><a href="/posts/<%= t.slug %>"><%= t.title %></a><% }) %></div>
        <div aria-hidden="true"><% ticker.forEach(t => { %><a href="/posts/<%= t.slug %>" tabindex="-1"><%= t.title %></a><% }) %></div>
      </div>
    </div>
  </div>
<% } %>

<% if (!slides.length) { %>
  <div class="text-center py-5">
    <h4 class="text-body-secondary">No posts yet</h4>
    <% if (isAdmin) { %><a href="/posts/new" class="btn btn-primary mt-2">Write a post</a><% } %>
  </div>
<% } else { %>

  <div class="kz-front">
    <div>
      <div class="kz-slider <%= slides.length === 1 ? 'one' : '' %>" id="kzSlider" role="region" aria-roledescription="carousel" aria-label="Top stories">
        <% slides.forEach((s, i) => { %>
          <article class="kz-slide <%= i === 0 ? 'is-on' : '' %>" style="--c: <%= s.color %>" aria-label="Story <%= i + 1 %> of <%= slides.length %>">
            <%- include('partials/home-art', { p: s, eager: i === 0 }) %>
            <div class="kz-slide-in">
              <a class="kz-chip" href="/blog?category=<%= encodeURIComponent(s.category) %>"><%= s.category %></a>
              <h1><a class="stretched-link" href="/posts/<%= s.slug %>"><%= s.title %></a></h1>
              <% if (s.preview) { %><p><%= s.preview %></p><% } %>
              <div class="kz-by">
                <span class="avatar"><%= s.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(s.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
                <strong><%= s.username %></strong>
                <span class="kz-pill"><%= s.ago %></span>
                <span class="kz-pill"><%= s.reading_time %> min read</span>
                <span class="kz-pill"><%= kfmt(s.views) %> views</span>
              </div>
            </div>
          </article>
        <% }) %>
        <button type="button" class="kz-nbtn pv" id="kzPrev" aria-label="Previous story">&#10094;</button>
        <button type="button" class="kz-nbtn nx" id="kzNext" aria-label="Next story">&#10095;</button>
        <button type="button" class="kz-nbtn pp" id="kzPause" aria-label="Pause slideshow">&#10074;&#10074;</button>
        <div class="kz-dots">
          <% slides.forEach((s, i) => { %><button type="button" class="kz-dot <%= i === 0 ? 'is-on' : '' %>" aria-label="Show story <%= i + 1 %>"><span><i></i></span></button><% }) %>
        </div>
      </div>

      <% if (pair.length) { %>
        <div class="kz-pair">
          <% pair.forEach(p => { %>
            <article style="--c: <%= p.color %>">
              <a href="/posts/<%= p.slug %>" tabindex="-1" aria-hidden="true"><%- include('partials/home-art', { p }) %></a>
              <a class="kz-cat" href="/blog?category=<%= encodeURIComponent(p.category) %>"><%= p.category %></a>
              <h2><a class="stretched-link" href="/posts/<%= p.slug %>"><%= p.title %></a></h2>
              <% if (p.preview) { %><p><%= p.preview.length > 110 ? p.preview.slice(0, 110).trim() + '...' : p.preview %></p><% } %>
              <div class="kz-by"><%= p.ago %><span class="sep"></span><%= p.reading_time %> min read</div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (mostRead.length) { %>
      <aside class="kz-rail" aria-label="Most read">
        <h3>Most read</h3>
        <ol>
          <% mostRead.forEach(p => { %>
            <li>
              <div>
                <a href="/posts/<%= p.slug %>"><h4><%= p.title %></h4></a>
                <small><%= kfmt(p.views) %> view<%= p.views === 1 ? '' : 's' %></small>
              </div>
            </li>
          <% }) %>
        </ol>
      </aside>
    <% } %>
  </div>

  <% if (strip.length) { %>
    <section class="kz-strip-wrap" aria-label="More stories">
      <h2 class="kz-hd">More stories</h2>
      <div class="kz-strip">
        <% strip.forEach(p => { %>
          <article class="kz-card" style="--c: <%= p.color %>">
            <a href="/posts/<%= p.slug %>" tabindex="-1" aria-hidden="true"><%- include('partials/home-art', { p }) %></a>
            <a class="kz-cat" href="/blog?category=<%= encodeURIComponent(p.category) %>"><%= p.category %></a>
            <h3><a class="stretched-link" href="/posts/<%= p.slug %>"><%= p.title %></a></h3>
            <div class="kz-by"><%= p.ago %><span class="sep"></span><%= p.reading_time %> min read</div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (sections.length) { %>
    <div class="kz-sections">
      <% sections.forEach(s => { %>
        <section class="kz-sec" style="--c: <%= s.color %>">
          <h3><a href="/blog?category=<%= encodeURIComponent(s.name) %>"><%= s.name %></a></h3>
          <a class="lead d-block" href="/posts/<%= s.lead.slug %>"><%- include('partials/home-art', { p: s.lead }) %><h4><%= s.lead.title %></h4><div class="kz-by"><%= s.lead.ago %></div></a>
          <% if (s.rest.length) { %>
            <ul>
              <% s.rest.forEach(p => { %>
                <li><a href="/posts/<%= p.slug %>"><%= p.title %></a><span><%= p.ago %></span></li>
              <% }) %>
            </ul>
          <% } %>
        </section>
      <% }) %>
    </div>
  <% } %>

  <p class="kz-more"><a href="/blog">View all posts</a></p>
<% } %>

</div>

<script>
(function () {
  var root = document.getElementById('kzSlider');
  if (root) {
    var slides = [].slice.call(root.querySelectorAll('.kz-slide'));
    var dots = [].slice.call(root.querySelectorAll('.kz-dot'));
    var n = slides.length, cur = 0, hover = false, userPaused = false, startX = null;
    var pauseBtn = document.getElementById('kzPause');

    function show(i) {
      cur = (i + n) % n;
      slides.forEach(function (s, k) {
        var on = k === cur;
        s.classList.toggle('is-on', on);
        s.setAttribute('aria-hidden', on ? 'false' : 'true');
        [].forEach.call(s.querySelectorAll('a'), function (a) { a.tabIndex = on ? 0 : -1; });
      });
      dots.forEach(function (d, k) {
        d.classList.toggle('is-on', k === cur);
        d.classList.toggle('is-done', k < cur);
        if (k === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
        var bar = d.querySelector('i');
        if (k === cur) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
      });
    }
    function syncPause() {
      root.classList.toggle('is-paused', hover || userPaused || document.hidden);
    }
    dots.forEach(function (d, k) {
      d.addEventListener('click', function () { show(k); });
      d.querySelector('i').addEventListener('animationend', function () { if (k === cur) show(cur + 1); });
    });
    document.getElementById('kzPrev').addEventListener('click', function () { show(cur - 1); });
    document.getElementById('kzNext').addEventListener('click', function () { show(cur + 1); });
    pauseBtn.addEventListener('click', function () {
      userPaused = !userPaused;
      pauseBtn.innerHTML = userPaused ? '&#9654;' : '&#10074;&#10074;';
      pauseBtn.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
      syncPause();
    });
    root.addEventListener('mouseenter', function () { hover = true; syncPause(); });
    root.addEventListener('mouseleave', function () { hover = false; syncPause(); });
    root.addEventListener('focusin', function () { hover = true; syncPause(); });
    root.addEventListener('focusout', function () { hover = false; syncPause(); });
    document.addEventListener('visibilitychange', syncPause);
    root.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX; startX = null;
      if (Math.abs(dx) > 45) show(cur + (dx < 0 ? 1 : -1));
    });
    show(0);
  }

  // Neeche wale blocks scroll par halke se aayen (jo pehle se nazar aa rahe hon unhein chhoda jata hai)
  if ('IntersectionObserver' in window && !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.08 });
    [].forEach.call(document.querySelectorAll('.kz-strip-wrap, .kz-sec, .kz-more'), function (el) {
      if (el.getBoundingClientRect().top < window.innerHeight) return;
      el.classList.add('kz-rv'); io.observe(el);
    });
  }
})();
</script>

