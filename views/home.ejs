<%- include('partials/header') %>

<style>
  .kz-front { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 28px; margin-top: .25rem; }
  .kz-front a, .kz-sec a, .kz-rail a { color: inherit; text-decoration: none; }
  .kz-front a:hover h1, .kz-front a:hover h2, .kz-sec a:hover h4, .kz-sec li a:hover, .kz-rail a:hover h4, .kz-sec h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .kz-tag { font: 700 13px var(--kz-sans); color: var(--kz-accent); margin-top: 12px; }
  .kz-tag a:hover { text-decoration: underline; }
  .kz-art { display: block; position: relative; overflow: hidden; border-radius: 4px; aspect-ratio: 16 / 9; }
  .kz-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .kz-art b { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 800 clamp(48px, 9vw, 96px)/1 var(--kz-serif); color: rgba(255,255,255,.35); }
  .g1 { background: linear-gradient(135deg, #12355b, #0a6b4d 60%, #9bd1a8); }
  .g2 { background: linear-gradient(135deg, #5a1e3a, #c1553b); }
  .g3 { background: linear-gradient(135deg, #1c3d5a, #3d8fb5); }
  .g4 { background: linear-gradient(135deg, #3b2a63, #8a63d2); }
  .g5 { background: linear-gradient(135deg, #1b4d3e, #5fb98a); }

  .kz-lead h1 { font: 800 clamp(28px, 4.6vw, 44px)/1.08 var(--kz-serif); letter-spacing: -.015em; margin: 8px 0 8px; }
  .kz-lead p { font: 400 18px/1.5 var(--kz-serif); color: var(--kz-muted); margin: 0 0 8px; max-width: 62ch; }
  .kz-by { font: 400 13px var(--kz-sans); color: var(--kz-muted); }
  .kz-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--kz-line); }
  .kz-pair .kz-art { aspect-ratio: 3 / 2; }
  .kz-pair h2 { font: 700 21px/1.18 var(--kz-serif); margin: 6px 0 6px; }
  .kz-pair p { font: 400 15px/1.45 var(--kz-serif); color: var(--kz-muted); margin: 0 0 6px; }

  .kz-rail { background: var(--kz-paper); border: 1px solid var(--kz-line); border-top: 4px solid var(--kz-accent); padding: 6px 18px 10px; align-self: start; }
  .kz-rail h3 { font: 700 18px var(--kz-sans); margin: 14px 0 4px; }
  .kz-rail ol { list-style: none; margin: 0; padding: 0; counter-reset: n; }
  .kz-rail li { counter-increment: n; display: grid; grid-template-columns: 34px 1fr; gap: 6px; padding: 13px 0; border-top: 1px solid var(--kz-line); }
  .kz-rail li:first-child { border-top: 0; }
  .kz-rail li::before { content: counter(n); font: 800 30px/1 var(--kz-serif); color: var(--kz-accent); }
  .kz-rail h4 { font: 600 17px/1.25 var(--kz-serif); margin: 0 0 3px; }
  .kz-rail small { font: 400 12px var(--kz-sans); color: var(--kz-muted); }

  .kz-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 26px; margin-top: 34px; }
  .kz-sec h3 { font: 800 22px var(--kz-serif); margin: 0 0 12px; padding-bottom: 8px; border-bottom: 3px solid var(--bs-body-color); }
  .kz-sec .kz-art { margin-bottom: 10px; }
  .kz-sec h4 { font: 700 19px/1.2 var(--kz-serif); margin: 0 0 6px; }
  .kz-sec ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .kz-sec li { padding: 10px 0; border-top: 1px solid var(--kz-line); font: 600 16px/1.3 var(--kz-serif); }
  .kz-sec li span { display: block; font: 400 12px var(--kz-sans); color: var(--kz-muted); margin-top: 2px; }
  .kz-more { text-align: center; margin: 34px 0 6px; }
  @media (max-width: 860px) { .kz-front { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .kz-pair { grid-template-columns: 1fr; } .kz-lead p { font-size: 16px; } }
</style>

<% if (locals.liveContest) { const lc = liveContest; %>
  <section class="card border-0 shadow-sm mb-4" id="live-contest">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h5 class="fw-bold mb-0">🔥 Live now: <%= lc.st.title %></h5>
        <a href="/votes/<%= lc.st.id %>#comments" class="small text-decoration-none">Open contest &amp; comments →</a>
      </div>
      <% if (lc.notice) { %><div class="alert alert-info py-2"><%= lc.notice %></div><% } %>
      <%- include('partials/sponsor-banner', { ex: lc.extras, pollId: lc.st.id }) %>
      <%- include('partials/poll-block', { st: lc.st, compact: true, ret: '/' }) %>
    </div>
  </section>
  <%- include('partials/poll-script') %>
<% } %>

<% if (!top) { %>
  <div class="text-center py-5">
    <h4 class="text-body-secondary">Abhi koi post nahi hai</h4>
    <% if (isAdmin) { %><a href="/posts/new" class="btn btn-primary mt-2">Write a post</a><% } %>
  </div>
<% } else { %>

  <div class="kz-front">
    <div>
      <article class="kz-lead">
        <a href="/posts/<%= top.slug %>" aria-label="<%= top.title %>"><%- include('partials/home-art', { p: top }) %></a>
        <div class="kz-tag"><a href="/blog?category=<%= encodeURIComponent(top.category) %>"><%= top.category %></a></div>
        <a href="/posts/<%= top.slug %>"><h1><%= top.title %></h1></a>
        <% if (top.preview) { %><p><%= top.preview %></p><% } %>
        <div class="kz-by"><%= top.username %>, <%= top.ago %>, <%= top.reading_time %> min parhai</div>
      </article>

      <% if (pair.length) { %>
        <div class="kz-pair">
          <% pair.forEach(p => { %>
            <article>
              <a href="/posts/<%= p.slug %>" aria-label="<%= p.title %>"><%- include('partials/home-art', { p }) %></a>
              <div class="kz-tag"><a href="/blog?category=<%= encodeURIComponent(p.category) %>"><%= p.category %></a></div>
              <a href="/posts/<%= p.slug %>"><h2><%= p.title %></h2></a>
              <% if (p.preview) { %><p><%= p.preview.length > 110 ? p.preview.slice(0, 110).trim() + '...' : p.preview %></p><% } %>
              <div class="kz-by"><%= p.ago %></div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (mostRead.length) { %>
      <aside class="kz-rail" aria-label="Sab se zyada parhi gayi">
        <h3>Sab se zyada parhi gayi</h3>
        <ol>
          <% mostRead.forEach(p => { %>
            <li>
              <div>
                <a href="/posts/<%= p.slug %>"><h4><%= p.title %></h4></a>
                <small><%= p.views %> bar parhi gayi</small>
              </div>
            </li>
          <% }) %>
        </ol>
      </aside>
    <% } %>
  </div>

  <% if (sections.length) { %>
    <div class="kz-sections">
      <% sections.forEach(s => { %>
        <section class="kz-sec">
          <h3><a href="/blog?category=<%= encodeURIComponent(s.name) %>"><%= s.name %></a></h3>
          <a href="/posts/<%= s.lead.slug %>"><%- include('partials/home-art', { p: s.lead }) %><h4><%= s.lead.title %></h4></a>
          <% if (s.rest.length) { %>
            <ul>
              <% s.rest.forEach(p => { %>
                <li><a href="/posts/<%= p.slug %>"><%= p.title %></a><span><%= p.ago %></span></li>
              <% }) %>
            </ul>
          <% } %>
        </section>
      <% }) %>
    </div>
  <% } %>

  <p class="kz-more"><a href="/blog" class="btn btn-outline-secondary">Sab posts dekhein</a></p>
<% } %>

<%- include('partials/footer') %>
