<%- include('partials/header') %>
<%- include('partials/shop-style') %>
<%- include('partials/seller-nav') %>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3">
    <a href="/seller/orders?status=new" class="text-decoration-none text-body">
      <div class="sh-card text-center mb-0">
        <div class="fs-2 fw-bold" style="color:#f59e0b;"><%= st.new_orders %></div>
        <div class="sh-stat">New Orders</div>
      </div>
    </a>
  </div>

  <div class="col-6 col-md-3">
    <a href="/seller/orders?status=shipped" class="text-decoration-none text-body">
      <div class="sh-card text-center mb-0">
        <div class="fs-2 fw-bold" style="color:#3b82f6;"><%= st.shipped %></div>
        <div class="sh-stat">In Transit</div>
      </div>
    </a>
  </div>

  <div class="col-6 col-md-3">
    <div class="sh-card text-center mb-0">
      <div class="fs-2 fw-bold"><%= st.today %></div>
      <div class="sh-stat">Today's Orders</div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="sh-card text-center mb-0">
      <div class="fs-2 fw-bold" style="color:#12a37f;">
        Rs <%= rs(st.delivered_rs) %>
      </div>
      <div class="sh-stat">Total Delivered Value</div>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-12 col-md-6">
    <div class="sh-card h-100">
      <div class="sh-h">📦 Products</div>

      <div class="mb-2">
        <b><%= st.products %></b> products

        <% if (st.sold_out > 0) { %>
          · <span class="text-danger">
            <b><%= st.sold_out %></b> Sold Out
          </span>
        <% } %>

        <% if (st.low > 0) { %>
          · <span class="text-warning">
            <b><%= st.low %></b> Low Stock
          </span>
        <% } %>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a href="/seller/products/new" class="btn btn-success btn-sm rounded-pill">
          ➕ Add New Product
        </a>

        <a href="/seller/products" class="btn btn-outline-secondary btn-sm rounded-pill">
          All Products
        </a>

        <a href="/seller/share" class="btn btn-outline-primary btn-sm rounded-pill">
          📣 Share with Groups
        </a>
      </div>

      <% if (st.pending_rs > 0) { %>
        <div class="sh-stat mt-2">
          Current Cart / New Orders Value: Rs <%= rs(st.pending_rs) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-12 col-md-6">
    <div class="sh-card h-100">
      <div class="sh-h">🔗 Your Shop Link</div>

      <% if (shop.status === 'active') { %>
        <input
          class="form-control form-control-sm mb-2"
          readonly
          value="<%= (locals.siteUrl || '') %>/shop/<%= shop.slug %>"
          id="shopLink"
          onclick="this.select()"
        >

        <button
          class="btn btn-outline-secondary btn-sm rounded-pill"
          id="copyShop"
          type="button"
        >
          🔗 Copy Link
        </button>

        <a
          class="btn btn-outline-success btn-sm rounded-pill"
          target="_blank"
          rel="noopener noreferrer"
          href="https://wa.me/?text=<%= encodeURIComponent(shop.name + ' - all products here: ') %>"
        >
          📤 Share on WhatsApp
        </a>
      <% } else { %>
        <div class="sh-stat">
          Your shop link will appear here once your shop is published.
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="sh-card">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <div class="sh-h mb-0">🧾 Recent Orders</div>
    <a href="/seller/orders" class="small">View All →</a>
  </div>

  <% if (recent.length === 0) { %>
    <p class="text-body-secondary mb-0">
      No orders yet. Add products and share your shop with your groups to start receiving orders.
    </p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <tbody>
          <% recent.forEach(o => { %>
            <tr>
              <td>#<%= o.id %></td>

              <td>
                <%= o.product_name %> × <%= o.qty %>
                <div class="sh-stat">
                  <%= o.customer_name %> · <%= o.city %>
                </div>
              </td>

              <td class="text-end">
                Rs <%= rs(o.total_rs) %>
              </td>

              <td class="text-end">
                <span
                  class="sh-pill"
                  style="background:<%= STATUS_COLOR[o.status] %>;"
                ><%= STATUS_LABEL[o.status] %></span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
(function () {
  var b = document.getElementById('copyShop');
  var i = document.getElementById('shopLink');

  if (!b || !i) return;

  if (!/^https?:/.test(i.value)) {
    i.value = location.origin + i.value;
  }

  b.addEventListener('click', function () {
    i.select();

    try {
      document.execCommand('copy');
    } catch (e) {}

    if (navigator.clipboard) {
      navigator.clipboard.writeText(i.value).catch(function () {});
    }

    var originalText = b.textContent;
    b.textContent = '✓ Link Copied!';

    setTimeout(function () {
      b.textContent = originalText;
    }, 1400);
  });
})();
</script>

<%- include('partials/footer') %>