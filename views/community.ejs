<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm text-center">
      <div class="card-body p-4 p-md-5">
        <h1 class="fw-bold mb-2">👥 Join Our Community</h1>
        <p class="text-body-secondary mb-4">
          Naye posts, updates aur discussions ke liye humari community join karein. Yahan aap doosre
          readers se baat kar sakte hain aur sab se pehle naye posts ki khabar pa sakte hain.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
          <% if (locals.whatsappChannelUrl) { %>
            <a href="<%= whatsappChannelUrl %>" target="_blank" rel="noopener" class="btn btn-outline-success btn-lg">
              WhatsApp Channel Follow Karein
            </a>
          <% } %>
          <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" class="btn btn-success btn-lg">
            WhatsApp Group Join Karein
          </a>
          <a href="<%= facebookUrl %>" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            Facebook Group Join Karein
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
