<%
  // Blog post ke neeche "Ye product kharido" card. pr = product row, post = blog post.
  const _rs = (n) => Number(n).toLocaleString('en-PK');
  const _camp = ('post-' + String(post.slug || post.id)).slice(0, 60);
  const _href = '/shop/' + pr.shop_slug + '/' + pr.slug + '?utm_source=blog&utm_medium=post_card&utm_campaign=' + encodeURIComponent(_camp);
  const _sold = pr.stock <= 0;
  const _off = (pr.compare_price_rs && pr.compare_price_rs > pr.price_rs) ? Math.round((pr.compare_price_rs - pr.price_rs) * 100 / pr.compare_price_rs) : 0;
%>
<section class="card border-0 shadow-sm mt-4" id="post-product" aria-label="Product">
  <div class="card-body p-3 p-md-4">
    <div class="small text-body-secondary fw-semibold mb-2">🛍️ Ye product kharido</div>
    <div class="d-flex gap-3 align-items-center flex-wrap flex-sm-nowrap">
      <a href="<%= _href %>" class="flex-shrink-0 text-decoration-none" style="width:110px;height:110px;border-radius:14px;overflow:hidden;background:var(--bs-tertiary-bg);display:flex;align-items:center;justify-content:center;font-size:2.4rem;">
        <% if (pr.image_id) { %><img src="/img/<%= pr.image_id %>" alt="<%= pr.name %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;<%= _sold ? 'filter:grayscale(1);opacity:.6;' : '' %>"><% } else { %>🛍️<% } %>
      </a>
      <div class="flex-grow-1" style="min-width:180px;">
        <a href="<%= _href %>" class="fw-bold fs-5 text-decoration-none text-body d-block"><%= pr.name %></a>
        <div class="mb-1">
          <span class="fw-bold fs-5" style="color:#12a37f;">Rs <%= _rs(pr.price_rs) %></span>
          <% if (_off > 0) { %><span class="text-decoration-line-through text-body-secondary small ms-1"><%= _rs(pr.compare_price_rs) %></span> <span class="badge text-bg-warning"><%= _off %>% off</span><% } %>
          <% if (_sold) { %><span class="badge text-bg-danger ms-1">Sold out</span><% } %>
        </div>
        <div class="small text-body-secondary mb-2"><%= pr.shop_name %><%= pr.shop_city ? ' · ' + pr.shop_city : '' %> &middot; 🚚 Cash on Delivery</div>
        <% if (!_sold) { %>
          <a href="<%= _href %>#order" class="btn btn-success rounded-pill px-4 fw-semibold">Abhi order karo</a>
        <% } else { %>
          <a href="<%= _href %>" class="btn btn-outline-secondary rounded-pill px-4">Details dekho</a>
        <% } %>
      </div>
    </div>
  </div>
</section>
