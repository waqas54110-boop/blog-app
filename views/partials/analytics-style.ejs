  .hbar-row { display: flex; align-items: center; gap: .6rem; padding: .3rem 0; }
  .hbar-row .nm { width: 8.5rem; flex: none; font-weight: 700; } .hbar-row .bar { flex: 1; height: 10px; border-radius: 99px; background: color-mix(in srgb, var(--bs-body-color) 8%, transparent); overflow: hidden; }
