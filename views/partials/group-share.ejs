<%# Group page ke sidebar mein: invite link + WhatsApp / Facebook / Telegram share %>
<% const inviteLink = shareBase + '/groups/join/' + group.invite_token; %>
<% const shareText = 'Join "' + group.name + '" on ' + siteName + ': ' + inviteLink; %>

<div class="card border-0 shadow-sm mb-3"><div class="card-body">
  <div class="fw-bold mb-2">🔗 Invite friends</div>
  <div class="input-group input-group-sm mb-2">
    <input id="groupInviteLink" type="text" class="form-control" value="<%= inviteLink %>" readonly>
    <button class="btn btn-outline-secondary" type="button" id="copyGroupInvite">Copy</button>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-sm btn-success rounded-pill" target="_blank" rel="noopener"
       href="https://wa.me/?text=<%= encodeURIComponent(shareText) %>">WhatsApp</a>
    <a class="btn btn-sm btn-primary rounded-pill" target="_blank" rel="noopener"
       href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(inviteLink) %>">Facebook</a>
    <a class="btn btn-sm btn-info text-white rounded-pill" target="_blank" rel="noopener"
       href="https://t.me/share/url?url=<%= encodeURIComponent(inviteLink) %>&text=<%= encodeURIComponent('Join ' + group.name) %>">Telegram</a>
    <button class="btn btn-sm btn-outline-primary rounded-pill d-none" type="button" id="nativeGroupShare">Share…</button>
  </div>

  <% if (user && (isAdmin || group.owner_id === user.id)) { %>
    <form action="/groups/<%= group.slug %>/invite/reset" method="POST" class="mt-3 mb-0"
          onsubmit="return confirm('The old link will stop working. Reset it?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-link btn-sm text-danger p-0">Reset invite link</button>
    </form>
  <% } %>
</div></div>

<script>
  (function () {
    var link = document.getElementById('groupInviteLink').value;
    var copy = document.getElementById('copyGroupInvite');
    copy.addEventListener('click', function () {
      var done = function () { copy.textContent = 'Copied ✓'; setTimeout(function () { copy.textContent = 'Copy'; }, 1500); };
      if (navigator.clipboard) navigator.clipboard.writeText(link).then(done);
      else { var el = document.getElementById('groupInviteLink'); el.select(); document.execCommand('copy'); done(); }
    });
    if (navigator.share) {
      var b = document.getElementById('nativeGroupShare');
      b.classList.remove('d-none');
      b.addEventListener('click', function () {
        navigator.share({ title: <%- JSON.stringify(group.name) %>, text: 'Join this group', url: link });
      });
    }
  })();
</script>
