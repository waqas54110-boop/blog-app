<%# Ek feed post card. Locals: f (post + recent comments), full (post page?), ago, shareBase %>
<% const uname = encodeURIComponent(f.username); %>
<% const isOwn = locals.user && user.id === f.user_id; %>
<% const canDel = isOwn || locals.isAdmin; %>
<% const url = shareBase + '/feed/' + f.id; %>
<% const longText = !full && f.body.length > 420; %>
<article class="card feed-card border-0 shadow-sm mb-3" id="p<%= f.id %>" data-id="<%= f.id %>">
  <div class="d-flex align-items-center gap-2 p-3 pb-2">
    <a href="/u/<%= uname %>" class="text-decoration-none">
      <span class="avatar avatar-md"><%= f.username.charAt(0).toUpperCase() %><img src="/a/<%= uname %>" alt="" loading="lazy" onerror="this.remove()"></span>
    </a>
    <div class="flex-grow-1 lh-sm" style="min-width:0;">
      <a class="fw-semibold text-reset text-decoration-none" href="/u/<%= uname %>"><%= f.username %></a>
      <% if (f.role === 'admin') { %><span class="badge text-bg-primary">Owner</span><% } %>
      <div class="small text-body-secondary">
        <a class="text-reset text-decoration-none" href="/feed/<%= f.id %>" title="<%= new Date(f.created_at).toLocaleString('en-GB') %>"><%= ago(f.created_at) %></a> · 🌍
        <% if (f.is_hidden) { %><span class="badge text-bg-warning ms-1">Pending review</span><% } %>
      </div>
    </div>
    <div class="dropdown">
      <button class="btn btn-sm btn-light rounded-circle px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Post options">⋯</button>
      <ul class="dropdown-menu dropdown-menu-end shadow">
        <li><button type="button" class="dropdown-item" data-copy="<%= url %>">🔗 Copy link</button></li>
        <% if (locals.user && !isOwn) { %>
          <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#reportModal" data-report-type="feed_post" data-report-id="<%= f.id %>">🚩 Report post</button></li>
        <% } %>
        <% if (canDel) { %>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form action="/feed/<%= f.id %>/delete" method="POST" class="mb-0" onsubmit="return confirm('Delete this post?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="dropdown-item text-danger">🗑️ Delete post</button>
            </form>
          </li>
        <% } %>
      </ul>
    </div>
  </div>

  <% if (f.body) { %>
    <div class="feed-text px-3 pb-2 <%= (!f.image_id && f.body.length <= 120) ? 'feed-text-lg' : '' %>"><%= longText ? f.body.slice(0, 400) + '…' : f.body %><% if (longText) { %> <a href="/feed/<%= f.id %>" class="text-decoration-none fw-semibold">See more</a><% } %></div>
  <% } %>

  <% if (f.image_id) { %>
    <a href="/img/<%= f.image_id %>" class="feed-photo js-photo d-block <%= full ? 'feed-photo-full' : '' %>">
      <img src="/img/<%= f.image_id %>" alt="Photo posted by <%= f.username %>" loading="lazy">
    </a>
  <% } %>

  <div class="d-flex justify-content-between px-3 py-2 small text-body-secondary">
    <span class="js-likes <%= f.likes ? '' : 'invisible' %>">❤️ <span class="js-like-count"><%= f.likes %></span></span>
    <a href="/feed/<%= f.id %>#comments" class="text-reset text-decoration-none">💬 <span class="js-comment-count"><%= f.comments %></span></a>
  </div>

  <div class="d-flex border-top mx-3 py-1 gap-1">
    <% if (locals.user) { %>
      <button type="button" class="fa-btn js-like <%= f.liked ? 'on' : '' %>" data-id="<%= f.id %>"><span class="ic"><%= f.liked ? '♥' : '♡' %></span> Like</button>
      <button type="button" class="fa-btn js-focus-comment">💬 Comment</button>
    <% } else { %>
      <a href="/login" class="fa-btn">♡ Like</a>
      <a href="/login" class="fa-btn">💬 Comment</a>
    <% } %>
    <div class="dropdown flex-fill d-flex">
      <button type="button" class="fa-btn flex-fill" data-bs-toggle="dropdown" aria-expanded="false">↗ Share</button>
      <ul class="dropdown-menu dropdown-menu-end shadow">
        <li><a class="dropdown-item" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent(url) %>">🟢 WhatsApp</a></li>
        <li><a class="dropdown-item" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(url) %>">🔵 Facebook</a></li>
        <li><button type="button" class="dropdown-item" data-copy="<%= url %>">🔗 Copy link</button></li>
      </ul>
    </div>
  </div>

  <div class="px-3 pt-3 pb-1 js-comments" <%- full ? 'id="comments"' : '' %>>
    <% if (!full && f.comments > f.recent.length) { %>
      <a class="small fw-semibold text-body-secondary text-decoration-none d-block mb-2" href="/feed/<%= f.id %>#comments">View all <%= f.comments %> comments</a>
    <% } %>
    <% f.recent.forEach(function (c) { %><%- include('feed-comment', { c: c, f: f }) %><% }) %>
  </div>

  <% if (locals.user) { %>
    <form class="js-comment-form d-flex gap-2 align-items-start px-3 pb-3" action="/feed/<%= f.id %>/comments" method="POST" data-id="<%= f.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <span class="avatar avatar-sm mt-1"><%= user.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(user.username) %>" alt="" onerror="this.remove()"></span>
      <div class="flex-grow-1">
        <div class="input-group">
          <input type="text" name="body" class="form-control rounded-start-pill js-comment-input" maxlength="1000" placeholder="Write a comment..." autocomplete="off" required>
          <button class="btn btn-primary rounded-end-pill px-3" type="submit" aria-label="Send comment">➤</button>
        </div>
        <div class="small text-danger mt-1 js-comment-err"></div>
      </div>
    </form>
  <% } else { %>
    <div class="px-3 pb-3 small text-body-secondary"><a href="/login">Log in</a> to like or comment.</div>
  <% } %>
</article>
