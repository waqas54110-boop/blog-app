    background: radial-gradient(600px 240px at 90% 0%, rgba(255,255,255,.18), transparent 70%), linear-gradient(120deg, #d6283a, #7a1230 60%, #2a0f3d); }
  .cr-hero h1 { font: 800 clamp(34px, 6vw, 56px)/1 var(--kz-serif); letter-spacing: -.02em; margin: 0 0 10px; }
  .cr-hero p { font: 400 17px/1.5 var(--kz-sans); max-width: 620px; margin: 0 0 18px; opacity: .93; }
