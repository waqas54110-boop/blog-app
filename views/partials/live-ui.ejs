<%# Live broadcasting: host screen ("🔴 Live" button) + viewer screen ("Watch live" button) + WebRTC. Included on every page (after login) from the footer.
     The cricket pages can "dock" both screens inline (window.KZLive) so the video sits next to the scorer / scorecard instead of covering the page. %>
<style>
  .live-screen { position: fixed; inset: 0; z-index: 2100; background: #0b1020; color: #fff; display: flex; flex-direction: column; }
  .live-screen.d-none { display: none !important; }
  .live-screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #0b1020; }
  #lhVideo.mirror { transform: scaleX(-1); }
  .ls-top { position: relative; z-index: 3; display: flex; align-items: center; gap: .5rem; padding: calc(env(safe-area-inset-top, 0px) + .8rem) .9rem 0; text-shadow: 0 1px 6px rgba(0,0,0,.6); }
  .ls-top .live-badge { background: #ef4444; color: #fff; font-weight: 700; font-size: .78rem; letter-spacing: .04em; padding: .25rem .6rem; border-radius: .45rem; display: inline-flex; align-items: center; gap: .4rem; }
  .ls-top .live-badge .live-dot { background: #fff; width: .5rem; height: .5rem; }
  .ls-pill { background: rgba(0,0,0,.45); border-radius: 2rem; padding: .25rem .7rem; font-size: .85rem; font-weight: 600; max-width: 55vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ls-x { margin-left: auto; width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(0,0,0,.5); color: #fff; font-size: 1.1rem; line-height: 1; cursor: pointer; }
  .ls-msg { position: relative; z-index: 3; margin: auto; padding: 0 1.5rem; text-align: center; font-weight: 600; text-shadow: 0 1px 8px rgba(0,0,0,.8); pointer-events: none; }
  .ls-msg:empty { display: none; }
  .ls-msg.err { color: #fecaca; }
  .ls-setup { position: relative; z-index: 3; margin-top: auto; padding: 1rem 1rem calc(env(safe-area-inset-bottom, 0px) + 1.2rem); background: linear-gradient(transparent, rgba(0,0,0,.78) 35%); }
  .ls-setup .form-control { background: rgba(255,255,255,.14); border: 0; color: #fff; border-radius: .8rem; }
  .ls-setup .form-control::placeholder { color: rgba(255,255,255,.65); }
  .ls-setup .form-control:focus { background: rgba(255,255,255,.2); color: #fff; box-shadow: 0 0 0 .2rem rgba(239,68,68,.4); }
  .ls-save { position: relative; z-index: 3; width: min(320px, 80vw); margin: 0 auto auto; text-align: center; }
  .ls-note { font-size: .8rem; opacity: .8; margin-top: .5rem; }
  .ls-bar { position: relative; z-index: 3; margin-top: auto; display: flex; justify-content: center; gap: 1.1rem; padding: 1rem 1rem calc(env(safe-area-inset-bottom, 0px) + 1.4rem); background: linear-gradient(transparent, rgba(0,0,0,.6)); }
  .ls-btn { width: 56px; height: 56px; border-radius: 50%; border: 0; font-size: 1.45rem; line-height: 1; background: rgba(255,255,255,.18); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: transform .12s, background .12s; }
  .ls-btn:hover { transform: scale(1.07); background: rgba(255,255,255,.28); }
  .ls-btn.off { background: #fff; color: #111; }
  .ls-btn.red { background: #ef4444; } .ls-btn.red:hover { background: #dc2626; }
  #lvPlay { position: relative; z-index: 4; margin: 0 auto auto; }

  /* ===== Cricket score bar (TV broadcast style, with player photos). Shown only when the match's "Show on live stream" switch is ON ===== */
  .sb { position: absolute; z-index: 4; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom, 0px) + 14px); padding: 0 .6rem; pointer-events: none; font-family: var(--kz-sans, system-ui, sans-serif); container-type: inline-size; }
  .sb.sb-host { bottom: calc(env(safe-area-inset-bottom, 0px) + 112px); }
  .sb.d-none { display: none !important; }
  .sb-in { position: relative; max-width: 780px; margin: 0 auto; border-radius: 16px; overflow: hidden; color: #fff; background: linear-gradient(180deg, rgba(16,26,52,.94), rgba(6,10,22,.97)); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 16px 44px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08); }
  .sb-in.sb-enter { animation: sbin .55s cubic-bezier(.2,.9,.3,1) both; }
  .sb-in::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; z-index: 2; background: linear-gradient(90deg, #16a34a, #facc15 55%, #f43f5e); }
  @keyframes sbin { from { transform: translateY(18px); opacity: 0; } to { transform: none; opacity: 1; } }
  .sb-head { display: flex; align-items: stretch; min-height: 56px; padding-top: 3px; position: relative; }
  .sb-tag { flex: 0 0 auto; display: flex; align-items: center; gap: .38rem; padding: 0 1.25rem 0 .75rem; background: linear-gradient(135deg, #e11d48, #9f1239); font: 800 .7rem/1 var(--kz-sans, sans-serif); letter-spacing: .09em; clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%); }
  .sb-tag i { width: .42rem; height: .42rem; border-radius: 50%; background: #fff; animation: sbpulse 1.4s infinite; }
  @keyframes sbpulse { 50% { opacity: .3; transform: scale(.7); } }
  .sb-team { flex: 0 0 auto; display: flex; flex-direction: column; justify-content: center; margin-left: -12px; padding: .3rem 1rem .3rem 1.4rem; background: linear-gradient(135deg, hsl(var(--h, 150) 70% 40%), hsl(var(--h, 150) 75% 24%)); clip-path: polygon(12px 0, 100% 0, calc(100% - 12px) 100%, 0 100%); }
  .sb-ts { font: 900 1.3rem/1 var(--kz-sans, sans-serif); letter-spacing: .03em; }
  .sb-tn { font-size: .6rem; opacity: .85; text-transform: uppercase; letter-spacing: .07em; max-width: 9.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: .18rem; }
  .sb-score { flex: 1 1 auto; min-width: 0; display: flex; align-items: center; flex-wrap: wrap; gap: .1rem .7rem; padding: .3rem .9rem; }
  .sb-runs { font: 900 2.15rem/1 var(--kz-sans, sans-serif); font-variant-numeric: tabular-nums; letter-spacing: -.01em; text-shadow: 0 2px 12px rgba(250,204,21,.28); border-radius: .4rem; padding: 0 .2rem; }
  .sb-runs.flash { animation: sbflash 1.3s ease-out; }
  .sb-runs.wkt { animation: sbwkt 1.6s ease-out; }
  @keyframes sbflash { 0% { background: #16a34a; } 100% { background: transparent; } }
  @keyframes sbwkt { 0% { background: #dc2626; } 100% { background: transparent; } }
  .sb-ov { font-size: .85rem; opacity: .8; white-space: nowrap; }
  .sb-crr { font-size: .72rem; font-weight: 700; padding: .16rem .55rem; border-radius: 99px; background: rgba(255,255,255,.1); white-space: nowrap; }
  .sb-vs { flex: 0 0 auto; display: flex; flex-direction: column; justify-content: center; align-items: flex-end; padding: 0 1rem; font-size: .6rem; text-transform: uppercase; letter-spacing: .09em; opacity: .92; }
  .sb-vs b { font: 800 1rem/1.1 var(--kz-sans, sans-serif); letter-spacing: .03em; }
  .sb-evt { position: absolute; left: 0; right: 0; top: 3px; bottom: 0; z-index: 3; display: flex; align-items: center; justify-content: center; font: 900 1.7rem/1 var(--kz-sans, sans-serif); letter-spacing: .24em; text-transform: uppercase; background: linear-gradient(90deg, #2563eb, #1d4ed8); animation: sbevt 3.2s ease both; }
  .sb-evt.six { background: linear-gradient(90deg, #7c3aed, #5b21b6); }
  .sb-evt.wkt { background: linear-gradient(90deg, #e11d48, #9f1239); }
  @keyframes sbevt { 0% { transform: translateX(-100%); } 12%, 80% { transform: none; } 100% { transform: translateX(100%); opacity: 0; } }
  .sb-pls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,.08); border-top: 1px solid rgba(255,255,255,.08); }
  .sb-pl { display: flex; align-items: center; gap: .55rem; padding: .45rem .7rem; background: rgba(8,14,30,.6); min-width: 0; }
  .sb-pl.on { background: linear-gradient(90deg, rgba(250,204,21,.18), rgba(8,14,30,.6)); }
  .sb-pl.bowl { background: linear-gradient(90deg, rgba(56,189,248,.16), rgba(8,14,30,.6)); }
  .sb-ph { width: 44px; height: 44px; border-radius: 50%; flex: 0 0 auto; overflow: hidden; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #334155, #1e293b); font: 800 1.1rem/1 var(--kz-sans, sans-serif); border: 2px solid rgba(255,255,255,.35); box-shadow: 0 2px 8px rgba(0,0,0,.45); }
  .sb-ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sb-ph.on { border-color: #facc15; box-shadow: 0 0 0 3px rgba(250,204,21,.25), 0 2px 10px rgba(0,0,0,.5); }
  .sb-pl.bowl .sb-ph { border-color: #38bdf8; }
  .sb-pt { min-width: 0; }
  .sb-pn { font: 800 .76rem/1.15 var(--kz-sans, sans-serif); text-transform: uppercase; letter-spacing: .03em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sb-ps { font-size: .8rem; white-space: nowrap; }
  .sb-ps b { font-size: 1.02rem; font-variant-numeric: tabular-nums; }
  .sb-ps span { opacity: .75; }
  .sb-ps em { font-style: normal; font-size: .64rem; opacity: .7; margin-left: .4rem; }
  .sb-foot { display: flex; align-items: center; flex-wrap: wrap; gap: .3rem .8rem; padding: .4rem .8rem; background: rgba(0,0,0,.38); }
  .sb-balls { display: flex; gap: .25rem; align-items: center; }
  .sb-balls em { font-style: normal; font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; opacity: .7; margin-right: .2rem; }
  .sb-b { min-width: 1.5rem; height: 1.5rem; padding: 0 .28rem; border-radius: 99px; display: inline-flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 800; background: #374151; color: #fff; }
  .sb-b.r4 { background: #2563eb; } .sb-b.r6 { background: #7c3aed; } .sb-b.w { background: #dc2626; } .sb-b.x { background: #f59e0b; color: #111; }
  .sb-chase { margin-left: auto; padding: .2rem .7rem; border-radius: 99px; background: linear-gradient(90deg, #fbbf24, #f59e0b); color: #111; font-weight: 800; font-size: .74rem; }
  .sb-chase.res { background: linear-gradient(90deg, #22c55e, #16a34a); color: #fff; margin-left: 0; }
  @container (max-width: 560px) {
    .sb-runs { font-size: 1.7rem; } .sb-tn, .sb-vs, .sb-ps em { display: none; } .sb-ts { font-size: 1.1rem; }
    .sb-ph { width: 32px; height: 32px; font-size: .9rem; } .sb-pl { gap: .4rem; padding: .4rem .45rem; }
    .sb-pn { font-size: .62rem; } .sb-ps { font-size: .7rem; } .sb-ps b { font-size: .9rem; } .sb-evt { font-size: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .sb-tag i, .sb-runs.flash, .sb-runs.wkt, .sb-in.sb-enter, .sb-evt { animation: none; } }

  /* ===== Docked (inline) mode: the camera / viewer panel lives inside a cricket page instead of covering the whole screen ===== */
  .live-screen.live-inline { position: relative; inset: auto; z-index: 1; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,.25); }
  .live-screen.live-inline:fullscreen { aspect-ratio: auto; border-radius: 0; height: 100%; }
  @media (max-width: 600px) { .live-screen.live-inline { aspect-ratio: 4 / 3; } }
  .live-inline .ls-top { padding: .6rem .7rem 0; }
  .live-inline .ls-setup { padding: .6rem .7rem; }
  .live-inline #lhCaption, .live-inline .ls-note { display: none; }
  .live-inline .ls-bar { padding: .5rem .7rem; gap: .7rem; }
  .live-inline .ls-btn { width: 44px; height: 44px; font-size: 1.15rem; }
  .live-inline .sb { bottom: 10px; }
  .live-inline .sb.sb-host { bottom: 66px; }
  #liveHost.live-inline .sb-pls, #liveHost.live-inline .sb-foot { display: none; } /* host preview stays clear: compact score line only */
  .ls-fs { display: none; }
  .live-inline .ls-fs { display: inline-flex; align-items: center; justify-content: center; margin-left: auto; }
  .live-inline .ls-fs + .ls-x { margin-left: .4rem; }
</style>

<%# ---------- HOST screen ---------- %>
<div id="liveHost" class="live-screen d-none" role="dialog" aria-label="Go live">
  <video id="lhVideo" class="mirror" autoplay playsinline muted></video>
  <div class="ls-top">
    <span id="lhBadge" class="live-badge d-none"><span class="live-dot"></span> LIVE <span id="lhTime">0:00</span></span>
    <span id="lhViewers" class="ls-pill d-none">👁 0</span>
    <button type="button" id="lhClose" class="ls-x" aria-label="Cancel">✕</button>
  </div>
  <div id="lhMsg" class="ls-msg"></div>
  <div id="lhScore" class="sb sb-host d-none" aria-live="polite"></div>
  <div id="lhSave" class="ls-save d-none">
    <div class="progress mb-2" style="height:6px"><div id="lhSaveBar" class="progress-bar bg-danger" style="width:0%"></div></div>
    <div id="lhSaveBtns" class="d-flex justify-content-center gap-2 flex-wrap d-none">
      <button type="button" id="lhRetry" class="btn btn-light btn-sm rounded-pill fw-semibold">↻ Try again</button>
      <a id="lhDownload" class="btn btn-outline-light btn-sm rounded-pill fw-semibold" download="live-recording">⬇ Download</a>
      <button type="button" id="lhSkip" class="btn btn-outline-light btn-sm rounded-pill fw-semibold">Skip</button>
    </div>
  </div>
  <div id="lhSetup" class="ls-setup">
    <input type="text" id="lhCaption" class="form-control mb-2" maxlength="300" placeholder="Say something about your live (optional)" autocomplete="off">
    <button type="button" id="lhGo" class="btn btn-danger w-100 rounded-pill fw-bold py-2" disabled>🔴 Go live</button>
    <div class="ls-note">Your camera and microphone go live on a new post. Keep this page open while you are live. The video is saved to your post when you end the live.</div>
  </div>
  <div id="lhBar" class="ls-bar d-none">
    <button type="button" id="lhMute" class="ls-btn" title="Mute microphone" aria-label="Mute microphone">🎤</button>
    <button type="button" id="lhCam" class="ls-btn" title="Turn camera off" aria-label="Turn camera off">📷</button>
    <button type="button" id="lhFlip" class="ls-btn" title="Switch camera" aria-label="Switch camera" style="display:none">🔄</button>
    <button type="button" id="lhEnd" class="ls-btn red" title="End live" aria-label="End live">⏹</button>
  </div>
</div>

<%# ---------- VIEWER screen ---------- %>
<div id="liveView" class="live-screen d-none" role="dialog" aria-label="Live video">
  <video id="lvVideo" autoplay playsinline></video>
  <div class="ls-top">
    <span class="live-badge"><span class="live-dot"></span> LIVE</span>
    <span id="lvHost" class="ls-pill"></span>
    <span id="lvViewers" class="ls-pill">👁 0</span>
    <button type="button" id="lvFs" class="ls-x ls-fs" aria-label="Full screen" title="Full screen">⛶</button>
    <button type="button" id="lvClose" class="ls-x" aria-label="Close">✕</button>
  </div>
  <div id="lvMsg" class="ls-msg">Connecting…</div>
  <div id="lvScore" class="sb d-none" aria-live="polite"></div>
  <button type="button" id="lvPlay" class="btn btn-light rounded-pill fw-semibold d-none">▶ Tap to play</button>
</div>

<script>
(function () {
  var csrf = '<%= csrfToken %>';
  var $ = function (id) { return document.getElementById(id); };
  var noop = function () {};
  var host = null;   // chalta hua live (mera)
  var view = null;   // jo live main dekh raha hoon
  var saving = false; // the recording is uploading after the live ended
  // Tell the page what is happening (the cricket pages listen to this: panel open / closed, live started / ended)
  function emit(detail) { try { document.dispatchEvent(new CustomEvent('kzlive', { detail: detail })); } catch (e) { /* ignore */ } }

  // LiveKit (media server) ki library: sirf tab load hoti hai jab live "sfu" mode mein ho
  var lkP = null;
  function loadLk() {
    if (window.LivekitClient) return Promise.resolve();
    if (lkP) return lkP;
    lkP = new Promise(function (res, rej) {
      var sc = document.createElement('script');
      sc.src = 'https://cdn.jsdelivr.net/npm/livekit-client@2/dist/livekit-client.umd.min.js';
      sc.onload = function () { window.LivekitClient ? res() : (lkP = null, rej(new Error('Could not load the live video library.'))); };
      sc.onerror = function () { lkP = null; rej(new Error('Could not load the live video library.')); };
      document.head.appendChild(sc);
    });
    return lkP;
  }

  function api(method, path, body) {
    var opts = { method: method, credentials: 'same-origin', headers: { 'x-csrf-token': csrf } };
    if (method !== 'GET') { opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body || {}); }
    return fetch(path, opts).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) { j._ok = r.ok; j._status = r.status; return j; });
    });
  }
  function fmt(s) { return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); }

  /* ---------- Cricket score bar (broadcast style with player photos) ---------- */
  var bars = {}; // mountId -> { dead, timer, last, sig, tick }
  function barStop(mountId) {
    var b = bars[mountId]; if (b) { b.dead = true; clearTimeout(b.timer); delete bars[mountId]; }
    var m = $(mountId); if (m) { m.classList.add('d-none'); m.replaceChildren(); }
  }
  function barStart(streamId, mountId) {
    barStop(mountId);
    var b = bars[mountId] = { dead: false, timer: null, last: null, sig: '', tick: null };
    function mk(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function ballCls(l) { return 'sb-b' + (l === '4' ? ' r4' : l === '6' ? ' r6' : l.charAt(0) === 'W' ? ' w' : (/wd|nb|b$|lb$/.test(l) ? ' x' : '')); }
    function hue(str) { var h = 7; str = String(str || ''); for (var i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) % 360; return h; }
    // Photos are always same-site /img/ID urls; anything else is ignored
    function face(p, cls) {
      var f = mk('span', 'sb-ph' + (cls ? ' ' + cls : '')), u = /^\/img\/\d+$/.test(p.photo || '') ? p.photo : '';
      if (u) { var im = mk('img'); im.src = u; im.alt = ''; im.decoding = 'async'; f.appendChild(im); }
      else f.textContent = String(p.name || '?').trim().charAt(0).toUpperCase();
      return f;
    }
    function card(p, kind) { // kind: 'strike' | 'bat' | 'bowl'
      var c = mk('div', 'sb-pl' + (kind === 'strike' ? ' on' : kind === 'bowl' ? ' bowl' : ''));
      c.appendChild(face(p, kind === 'strike' ? 'on' : ''));
      var t = mk('div', 'sb-pt'), st = mk('div', 'sb-ps');
      t.appendChild(mk('div', 'sb-pn', p.name || ''));
      if (kind === 'bowl') { st.appendChild(mk('b', '', p.wkts + '-' + p.runs)); st.appendChild(mk('span', '', ' (' + p.overs + ')')); }
      else {
        st.appendChild(mk('b', '', String(p.runs))); st.appendChild(mk('span', '', ' (' + p.balls + ')'));
        var x = (p.fours ? p.fours + '\u00d74' : '') + (p.fours && p.sixes ? ' ' : '') + (p.sixes ? p.sixes + '\u00d76' : '');
        if (x) st.appendChild(mk('em', '', x));
      }
      t.appendChild(st); c.appendChild(t); return c;
    }
    function paint(d) {
      var m = $(mountId); if (!m) return;
      if (!d || !d.show) { m.classList.add('d-none'); m.replaceChildren(); b.last = null; b.sig = ''; return; }
      var sig = JSON.stringify(d), wasHidden = m.classList.contains('d-none');
      if (sig === b.sig && !wasHidden) return; // nothing changed: do not rebuild (keeps photos from flickering)
      b.sig = sig;
      var key = d.runs + '/' + d.wkts + '/' + d.overs + '/' + d.innings, changed = !!(b.last && b.last.key !== key && b.last.inn === d.innings);
      var inn = mk('div', 'sb-in' + (wasHidden ? ' sb-enter' : '')), head = mk('div', 'sb-head');
      var tag = mk('div', 'sb-tag'); tag.appendChild(mk('i')); tag.appendChild(document.createTextNode(d.status === 'finished' ? 'FINAL' : 'LIVE')); head.appendChild(tag);
      var team = mk('div', 'sb-team'); team.style.setProperty('--h', hue(d.bat.name));
      team.appendChild(mk('span', 'sb-ts', d.bat.short)); team.appendChild(mk('span', 'sb-tn', d.bat.name)); head.appendChild(team);
      var sc = mk('div', 'sb-score'), runs = mk('b', 'sb-runs', d.runs + '/' + d.wkts);
      if (changed) runs.classList.add(d.wkts > b.last.wkts ? 'wkt' : 'flash');
      sc.appendChild(runs); sc.appendChild(mk('span', 'sb-ov', '(' + d.overs + ' / ' + d.maxOvers + ' ov)')); sc.appendChild(mk('span', 'sb-crr', 'CRR ' + d.crr.toFixed(2))); head.appendChild(sc);
      var vs = mk('div', 'sb-vs'); vs.appendChild(mk('span', '', 'vs')); vs.appendChild(mk('b', '', d.bowl.short)); head.appendChild(vs);
      if (changed && d.status !== 'finished') { // quick TV-style takeover for a boundary or a wicket
        var gain = d.runs - b.last.runs, evt = d.wkts > b.last.wkts ? ['wkt', 'WICKET!'] : gain === 6 ? ['six', 'SIX!'] : gain === 4 ? ['four', 'FOUR!'] : null;
        if (evt) head.appendChild(mk('div', 'sb-evt ' + evt[0], evt[1]));
      }
      inn.appendChild(head);
      if (d.striker || d.nonStriker || d.bowler) {
        var pls = mk('div', 'sb-pls');
        if (d.striker) pls.appendChild(card(d.striker, 'strike'));
        if (d.nonStriker) pls.appendChild(card(d.nonStriker, 'bat'));
        if (d.bowler) pls.appendChild(card(d.bowler, 'bowl'));
        inn.appendChild(pls);
      }
      var foot = mk('div', 'sb-foot');
      if (d.thisOver && d.thisOver.length && !d.result) {
        var bl = mk('div', 'sb-balls'); bl.appendChild(mk('em', '', 'This over'));
        d.thisOver.forEach(function (l) { bl.appendChild(mk('span', ballCls(l), l)); });
        foot.appendChild(bl);
      }
      if (d.result) foot.appendChild(mk('div', 'sb-chase res', '\ud83c\udfc6 ' + d.result));
      else if (d.innings === 2 && d.target && d.need != null) {
        var txt = d.bat.short + ' need ' + d.need + ' from ' + d.ballsLeft + ' balls' + (d.rrr != null ? ' | RRR ' + d.rrr.toFixed(2) : '') + ' | Target ' + d.target;
        foot.appendChild(mk('div', 'sb-chase', txt));
      } else if (d.first) foot.appendChild(mk('div', 'sb-chase', d.first.short + ' ' + d.first.runs + '/' + d.first.wkts + ' (' + d.first.overs + ')'));
      if (foot.childNodes.length) inn.appendChild(foot);
      m.replaceChildren(inn); m.classList.remove('d-none');
      b.last = { key: key, runs: d.runs, wkts: d.wkts, inn: d.innings };
    }
    function tick() {
      if (b.dead) return;
      clearTimeout(b.timer);
      var next = function () { if (!b.dead) b.timer = setTimeout(tick, 4000); };
      if (document.hidden) return next();
      fetch('/cricket/bar/' + streamId, { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : { show: false }; })
        .then(function (d) { if (!b.dead) paint(d); }).catch(noop).then(next);
    }
    b.tick = tick; tick();
  }

  function beacon(path, data) {
    if (!navigator.sendBeacon) return;
    data._csrf = csrf;
    navigator.sendBeacon(path, new Blob([JSON.stringify(data)], { type: 'application/json' }));
  }
  function supported(needCamera) {
    if (!window.RTCPeerConnection || (needCamera && (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia))) {
      alert('Live is not supported in this browser. Please use an up-to-date Chrome, Edge, Firefox or Safari.'); return false;
    }
    if (needCamera && !window.isSecureContext) { alert('Live needs a secure (HTTPS) connection.'); return false; }
    return true;
  }
  function camError(e) {
    if (!e) return 'Could not start the camera.';
    if (e.name === 'NotAllowedError' || e.name === 'SecurityError') return 'Please allow camera and microphone access in your browser to go live.';
    if (e.name === 'NotFoundError' || e.name === 'OverconstrainedError') return 'No camera or microphone found on this device.';
    if (e.name === 'NotReadableError') return 'Your camera or microphone is being used by another app.';
    return e.message || 'Could not start the camera.';
  }
  function flush(p) {
    var list = p.pending; p.pending = [];
    return list.reduce(function (q, c) { return q.then(function () { return p.pc.addIceCandidate(c).catch(noop); }); }, Promise.resolve());
  }
  function parse(s) { try { return JSON.parse(s.payload); } catch (e) { return null; } }

  /* =================== HOST =================== */
  function hostMsg(t, err) { var m = $('lhMsg'); m.textContent = t || ''; m.className = 'ls-msg' + (err ? ' err' : ''); }

  function openHost(opts) {
    if (host || view) return;
    if (!supported(true)) return;
    var h = host = { id: 0, postId: 0, stream: null, peers: {}, dead: {}, ice: [], lastSig: 0, ended: false, live: false,
      fails: 0, pollT: null, tick: null, t0: 0, facing: opts.facing === 'environment' ? 'environment' : 'user', matchId: opts.matchId || 0, returnUrl: opts.returnUrl || '', wl: null, bitrate: 600000, groupId: opts.groupId || '',
      mode: 'p2p', room: null, rec: null };
    $('lhCaption').value = String(opts.body || '').slice(0, 300);
    $('lhSetup').classList.remove('d-none'); $('lhBar').classList.add('d-none');
    $('lhBadge').classList.add('d-none'); $('lhViewers').classList.add('d-none');
    $('lhClose').style.display = '';
    $('lhGo').disabled = true; $('lhGo').textContent = '🔴 Go live';
    $('lhMute').className = 'ls-btn'; $('lhMute').textContent = '🎤';
    $('lhCam').className = 'ls-btn'; $('lhCam').textContent = '📷';
    $('lhFlip').style.display = 'none';
    $('lhVideo').classList.toggle('mirror', h.facing === 'user'); $('lhSave').classList.add('d-none'); $('lhSaveBtns').classList.add('d-none');
    hostMsg('Starting camera…');
    $('liveHost').classList.remove('d-none');

    navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
      video: { facingMode: h.facing === 'environment' ? { ideal: 'environment' } : 'user', width: { ideal: 854 }, height: { ideal: 480 }, frameRate: { ideal: 24 } }
    }).then(function (stream) {
      if (h.ended) { stream.getTracks().forEach(function (t) { t.stop(); }); return; }
      h.stream = stream;
      $('lhVideo').srcObject = stream;
      hostMsg('');
      $('lhGo').disabled = false;
      if (navigator.mediaDevices.enumerateDevices) {
        navigator.mediaDevices.enumerateDevices().then(function (d) {
          var cams = d.filter(function (x) { return x.kind === 'videoinput'; });
          $('lhFlip').style.display = cams.length > 1 ? '' : 'none';
        }).catch(noop);
      }
    }).catch(function (e) { hostMsg(camError(e), true); });
  }

  function goLive() {
    var h = host;
    if (!h || h.live || !h.stream) return;
    $('lhGo').disabled = true; $('lhGo').textContent = 'Starting…'; hostMsg('');
    api('POST', '/live/start', { body: $('lhCaption').value, group_id: h.groupId || undefined }).then(function (j) {
      if (h.ended) { if (j._ok) api('POST', '/live/' + j.id + '/end').catch(noop); return; }
      if (!j._ok) { hostMsg(j.error || 'Could not start the live.', true); $('lhGo').disabled = false; $('lhGo').textContent = '🔴 Go live'; return; }
      h.id = j.id; h.postId = j.post_id; h.ice = j.ice || []; h.mode = j.mode || 'p2p';
      h.bitrate = Math.max(350000, Math.min(900000, Math.round(3500000 / (j.max || 6))));
      var begin = function () {
        if (h.ended) return;
        h.live = true; h.t0 = Date.now();
        barStart(h.id, 'lhScore');
      emit({ role: 'host', live: true, streamId: h.id, matchId: h.matchId });
        $('lhSetup').classList.add('d-none'); $('lhBar').classList.remove('d-none');
        $('lhClose').style.display = 'none';
        $('lhBadge').classList.remove('d-none'); $('lhViewers').classList.remove('d-none'); $('lhViewers').textContent = '👁 0';
        function paint() { $('lhTime').textContent = fmt(Math.floor((Date.now() - h.t0) / 1000)); }
        paint(); h.tick = setInterval(paint, 1000);
        if (navigator.wakeLock && navigator.wakeLock.request) navigator.wakeLock.request('screen').then(function (l) { h.wl = l; }).catch(noop);
        startRec(h, j.rec_max_mb || 0);
        hostPoll(h);
      };
      if (h.mode === 'sfu' && j.lk) {
        hostMsg('Connecting to the live server…');
        connectHostSfu(h, j.lk).then(function () { hostMsg(''); begin(); }).catch(function (e) {
          console.error('[live] sfu', e);
          // Shuru hi na ho saka: live aur khali post dono hata do
          api('POST', '/live/' + h.id + '/end').catch(noop);
          fetch('/feed/' + h.postId + '/delete', { method: 'POST', credentials: 'same-origin', headers: { 'x-csrf-token': csrf, 'Content-Type': 'application/x-www-form-urlencoded' }, body: '' }).catch(noop);
          if (h.room) { try { h.room.disconnect(); } catch (x) { /* ignore */ } h.room = null; }
          hostMsg((e && e.message) || 'Could not connect to the live server.', true);
          $('lhGo').disabled = false; $('lhGo').textContent = '🔴 Go live';
        });
      } else begin();
    }).catch(function () { hostMsg('Network problem. Please try again.', true); $('lhGo').disabled = false; $('lhGo').textContent = '🔴 Go live'; });
  }

  function stopMedia(h) {
    try { if (h.stream) h.stream.getTracks().forEach(function (t) { t.stop(); }); } catch (e) { /* ignore */ }
    Object.keys(h.peers).forEach(function (k) { closePeer(h, k); });
    try { if (h.room) h.room.disconnect(); } catch (e) { /* ignore */ }
    try { if (h.wl) h.wl.release(); } catch (e) { /* ignore */ }
    $('lhVideo').srcObject = null;
  }

  // ----- Recording (host ke browser mein; live khatam hone par server par save) -----
  function startRec(h, maxMb) {
    if (!maxMb || !window.MediaRecorder || !h.stream) return;
    var mime = '';
    ['video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'].some(function (t) {
      try { if (MediaRecorder.isTypeSupported(t)) { mime = t; return true; } } catch (e) { /* ignore */ }
      return false;
    });
    if (!mime) return;
    var mr;
    try { mr = new MediaRecorder(h.stream, { mimeType: mime, videoBitsPerSecond: 700000, audioBitsPerSecond: 64000 }); }
    catch (e) { return; }
    var r = h.rec = { mr: mr, chunks: [], bytes: 0, type: mime.indexOf('mp4') > -1 ? 'video/mp4' : 'video/webm', capped: false };
    r.done = new Promise(function (res) { mr.onstop = res; });
    mr.ondataavailable = function (e) {
      if (!e.data || !e.data.size) return;
      r.chunks.push(e.data); r.bytes += e.data.size;
      if (r.bytes > maxMb * 1048576 * 0.9 && mr.state === 'recording') {
        r.capped = true;
        try { mr.stop(); } catch (x) { /* ignore */ }
        hostMsg('Recording limit reached. The live continues, but only the first part is saved.');
        setTimeout(function () { if (host === h && !h.ended) hostMsg(''); }, 5000);
      }
    };
    mr.onerror = function () { try { if (mr.state !== 'inactive') mr.stop(); } catch (x) { /* ignore */ } };
    try { mr.start(4000); } catch (e) { h.rec = null; }
  }

  // Recorder band karo aur ab tak ki video ka Blob do (ya null)
  function finalizeRec(h) {
    var r = h.rec;
    if (!r) return Promise.resolve(null);
    try { if (r.mr.state !== 'inactive') r.mr.stop(); } catch (e) { /* ignore */ }
    return Promise.race([r.done, new Promise(function (res) { setTimeout(res, 3000); })]).then(function () {
      var b = new Blob(r.chunks, { type: r.type });
      return b.size > 20000 ? b : null;
    });
  }

  function uploadRec(h, blob, onProgress) {
    return new Promise(function (res) {
      var x = new XMLHttpRequest();
      x.open('POST', '/live/' + h.id + '/recording');
      x.withCredentials = true;
      x.setRequestHeader('x-csrf-token', csrf);
      x.setRequestHeader('Content-Type', blob.type);
      x.upload.onprogress = function (e) { if (e.lengthComputable) onProgress(Math.round(e.loaded * 100 / e.total)); };
      x.onload = function () {
        var j = {}; try { j = JSON.parse(x.responseText); } catch (e) { /* ignore */ }
        res({ ok: x.status >= 200 && x.status < 300, j: j });
      };
      x.onerror = function () { res({ ok: false, j: { error: 'Network problem.' } }); };
      x.send(blob);
    });
  }

  function gotoPost(h) { saving = false; $('liveHost').classList.add('d-none'); location.href = h.returnUrl || ('/feed/' + h.postId); }

  function saveFlow(h, blob) {
    saving = true;
    $('lhSave').classList.remove('d-none'); $('lhSaveBtns').classList.add('d-none');
    $('lhSaveBar').style.width = '0%';
    hostMsg('Saving your recording… 0%');
    uploadRec(h, blob, function (p) { $('lhSaveBar').style.width = p + '%'; hostMsg('Saving your recording… ' + p + '%'); }).then(function (x) {
      if (x.ok) { $('lhSaveBar').style.width = '100%'; hostMsg('Recording saved ✓'); return setTimeout(function () { gotoPost(h); }, 900); }
      hostMsg((x.j && x.j.error) || 'Could not save the recording.', true);
      $('lhSaveBtns').classList.remove('d-none');
      var dl = $('lhDownload');
      if (dl._u) URL.revokeObjectURL(dl._u);
      dl._u = URL.createObjectURL(blob);
      dl.href = dl._u; dl.setAttribute('download', 'live-recording.' + (blob.type === 'video/mp4' ? 'mp4' : 'webm'));
      $('lhRetry').onclick = function () { saveFlow(h, blob); };
      $('lhSkip').onclick = function () { gotoPost(h); };
    });
  }

  // Sab band. live thi to recording save karke post par le jao
  function finishHost(h, text, tellServer) {
    if (h.ended) return;
    h.ended = true;
    clearTimeout(h.pollT); clearInterval(h.tick);
    barStop('lhScore');
    if (h.live) emit({ role: 'host', live: false, streamId: h.id, matchId: h.matchId });
    if (tellServer && h.id) api('POST', '/live/' + h.id + '/end').catch(noop);
    var recP = h.live ? finalizeRec(h) : Promise.resolve(null);   // stopMedia se PEHLE (tracks band hone se pehle recorder ko roko)
    stopMedia(h);
    if (host === h) host = null;
    if (!h.live) { $('liveHost').classList.add('d-none'); return; }
    $('lhBar').classList.add('d-none');
    $('lhBadge').classList.add('d-none'); $('lhViewers').classList.add('d-none');
    hostMsg(text || 'Live ended');
    recP.then(function (blob) {
      if (blob && h.id) return saveFlow(h, blob);
      setTimeout(function () { gotoPost(h); }, 1600);
    });
  }

  // Media server mode: host apni video LiveKit par bhejta hai, viewers wahin se dekhte hain (host ka upload ek hi rehta hai)
  function connectHostSfu(h, lk) {
    return loadLk().then(function () {
      var L = window.LivekitClient;
      var room = new L.Room({ dynacast: true });
      h.room = room;
      return room.connect(lk.url, lk.token).then(function () {
        var v = h.stream.getVideoTracks()[0], a = h.stream.getAudioTracks()[0], jobs = [];
        if (v) jobs.push(room.localParticipant.publishTrack(v, { source: L.Track.Source.Camera, name: 'camera', simulcast: true, videoEncoding: { maxBitrate: 1200000, maxFramerate: 24 } }));
        if (a) jobs.push(room.localParticipant.publishTrack(a, { source: L.Track.Source.Microphone, name: 'mic' }));
        return Promise.all(jobs);
      });
    });
  }

  function closePeer(h, sess) {
    var p = h.peers[sess];
    if (!p) return;
    try { p.pc.onicecandidate = p.pc.onconnectionstatechange = null; p.pc.close(); } catch (e) { /* ignore */ }
    delete h.peers[sess];
  }

  function sendSig(h, sess, type, obj) {
    return api('POST', '/live/' + h.id + '/signal', { sess: sess, type: type, payload: JSON.stringify(obj) }).catch(noop);
  }

  function limitBitrate(h, pc) {
    pc.getSenders().forEach(function (s) {
      if (!s.track || s.track.kind !== 'video' || !s.getParameters) return;
      var p = s.getParameters();
      if (!p.encodings || !p.encodings.length) p.encodings = [{}];
      p.encodings[0].maxBitrate = h.bitrate;
      s.setParameters(p).catch(noop);
    });
  }

  // Har naye dekhne wale ke liye alag connection
  function addPeer(h, sess) {
    var pc = new RTCPeerConnection({ iceServers: h.ice });
    var p = { pc: pc, pending: [], remoteSet: false, chain: Promise.resolve() };
    h.peers[sess] = p;
    h.stream.getTracks().forEach(function (t) { pc.addTrack(t, h.stream); });
    pc.onicecandidate = function (e) { if (e.candidate) sendSig(h, sess, 'ice', e.candidate); };
    pc.onconnectionstatechange = function () {
      if (pc.connectionState === 'failed') { h.dead[sess] = true; closePeer(h, sess); }
    };
    pc.createOffer()
      .then(function (o) { return pc.setLocalDescription(o); })
      .then(function () { limitBitrate(h, pc); return sendSig(h, sess, 'offer', pc.localDescription); })
      .catch(function (e) { console.error('[live] offer', e); h.dead[sess] = true; closePeer(h, sess); });
  }

  function hostSignal(h, p, s) {
    var data = parse(s);
    if (!data || h.ended) return Promise.resolve();
    if (s.type === 'answer') return p.pc.setRemoteDescription(data).then(function () { p.remoteSet = true; return flush(p); });
    if (s.type === 'ice') {
      if (p.remoteSet) return p.pc.addIceCandidate(data).catch(noop);
      p.pending.push(data);
    }
    return Promise.resolve();
  }

  // Har ~1 second: naye viewers + unke signals. Ye "main zinda hoon" ka ishara bhi hai.
  function hostPoll(h) {
    if (h.ended) return;
    api('GET', '/live/' + h.id + '/host?after=' + h.lastSig).then(function (j) {
      if (h.ended) return;
      if (!j._ok) {
        if (j._status === 404 || j._status === 401) return finishHost(h, 'Live ended', false);
        if (++h.fails > 15) return finishHost(h, 'Connection lost. Live ended.', true);
      } else {
        h.fails = 0;
        if (j.status !== 'live') return finishHost(h, 'Live ended', false);
        var set = {};
        (j.sessions || []).forEach(function (sess) {
          set[sess] = 1;
          if (!h.peers[sess] && !h.dead[sess]) addPeer(h, sess);
        });
        Object.keys(h.peers).forEach(function (k) { if (!set[k]) closePeer(h, k); });
        $('lhViewers').textContent = '👁 ' + (j.viewers != null ? j.viewers : (j.sessions || []).length);
        (j.signals || []).forEach(function (s) {
          if (s.id > h.lastSig) h.lastSig = s.id;
          var p = h.peers[s.sess];
          if (!p) return;
          p.chain = p.chain.then(function () { return hostSignal(h, p, s); }).catch(function (e) { console.error('[live] signal', e); });
        });
      }
      h.pollT = setTimeout(function () { hostPoll(h); }, 1000);
    }).catch(function () {
      if (h.ended) return;
      if (++h.fails > 15) return finishHost(h, 'Connection lost. Live ended.', true);
      h.pollT = setTimeout(function () { hostPoll(h); }, 1500);
    });
  }

  $('lhGo').addEventListener('click', goLive);
  $('lhClose').addEventListener('click', function () { if (host && !host.live) finishHost(host, '', false); });
  $('lhEnd').addEventListener('click', function () {
    if (host && host.live && confirm('End your live video?')) finishHost(host, 'Live ended', true);
  });
  $('lhMute').addEventListener('click', function () {
    if (!host || !host.stream) return;
    var off = false;
    host.stream.getAudioTracks().forEach(function (t) { t.enabled = !t.enabled; off = !t.enabled; });
    this.classList.toggle('off', off); this.textContent = off ? '🔇' : '🎤';
    this.title = off ? 'Unmute microphone' : 'Mute microphone';
  });
  $('lhCam').addEventListener('click', function () {
    if (!host || !host.stream) return;
    var off = false;
    host.stream.getVideoTracks().forEach(function (t) { t.enabled = !t.enabled; off = !t.enabled; });
    this.classList.toggle('off', off); this.textContent = off ? '🚫' : '📷';
    this.title = off ? 'Turn camera on' : 'Turn camera off';
  });
  $('lhFlip').addEventListener('click', function () {
    var h = host;
    if (!h || !h.stream) return;
    var rec = h.rec && h.rec.mr.state === 'recording';
    // Browser stream ka track badalte hi recorder rok deta hai, isliye pehle poochte hain
    if (rec && !confirm('Switching the camera stops the recording at this point (the live continues, and what was recorded so far is saved). Switch anyway?')) return;
    var next = h.facing === 'user' ? 'environment' : 'user';
    navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: next }, width: { ideal: 854 }, height: { ideal: 480 } }, audio: false }).then(function (s) {
      var nt = s.getVideoTracks()[0], old = h.stream.getVideoTracks()[0];
      if (rec) { try { h.rec.mr.stop(); } catch (e) { /* ignore */ } }
      if (h.mode === 'sfu' && h.room) {
        try {
          var pub = h.room.localParticipant.getTrackPublication(window.LivekitClient.Track.Source.Camera);
          if (pub && pub.track) pub.track.replaceTrack(nt);
        } catch (e) { console.error('[live] flip', e); }
      }
      Object.keys(h.peers).forEach(function (k) {
        var sender = h.peers[k].pc.getSenders().filter(function (x) { return x.track && x.track.kind === 'video'; })[0];
        if (sender) sender.replaceTrack(nt).catch(noop);
      });
      if (old) { h.stream.removeTrack(old); old.stop(); }
      h.stream.addTrack(nt);
      h.facing = next;
      $('lhVideo').srcObject = new MediaStream([nt]);
      $('lhVideo').classList.toggle('mirror', next === 'user');
    }).catch(noop);
  });
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && host && host.live && navigator.wakeLock && navigator.wakeLock.request) {
      navigator.wakeLock.request('screen').then(function (l) { host.wl = l; }).catch(noop);
    }
  });

  /* =================== VIEWER =================== */
  function viewMsg(t, err) { var m = $('lvMsg'); m.textContent = t || ''; m.className = 'ls-msg' + (err ? ' err' : ''); }

  function openView(id, hostName) {
    if (host || view) return;
    if (!supported(false)) return;
    var v = view = { id: id, sess: 0, pc: null, lastSig: 0, pending: [], remoteSet: false, chain: Promise.resolve(),
      ended: false, fails: 0, pollT: null, playing: false, slowT: null, room: null, pollMs: 1500 };
    $('lvHost').textContent = hostName || '';
    $('lvViewers').textContent = '👁 …';
    $('lvVideo').srcObject = null;
    $('lvPlay').classList.add('d-none');
    viewMsg('Connecting…');
    $('liveView').classList.remove('d-none');
    barStart(id, 'lvScore');

    api('POST', '/live/' + id + '/join').then(function (j) {
      if (v.ended) { if (j._ok) api('POST', '/live/' + id + '/leave', { sess: j.sess }).catch(noop); return; }
      if (!j._ok) {
        viewMsg(j.error || 'Could not join this live.', true);
        if (j._status === 410) markCardEnded(id);
        setTimeout(function () { closeView(v, null, false); }, 2600);
        return;
      }
      v.sess = j.sess;
      v.slowT = setTimeout(function () { if (!v.playing && !v.ended) viewMsg('Still connecting… the host may have a weak connection.'); }, 15000);
      if (j.mode === 'sfu' && j.lk) {
        v.pollMs = 5000;
        connectViewerSfu(v, j.lk).then(function () { if (!v.ended) viewPoll(v); }).catch(function (e) {
          console.error('[live] sfu', e);
          viewMsg((e && e.message) || 'Could not connect to the live.', true);
          setTimeout(function () { closeView(v, null, true); }, 2600);
        });
        return;
      }
      makeViewerPc(v, j.ice || []);
      viewPoll(v);
    }).catch(function () { viewMsg('Network problem. Please try again.', true); setTimeout(function () { closeView(v, null, false); }, 2600); });
  }

  function markCardEnded(id) {
    var el = document.querySelector('[data-live-card="' + id + '"]');
    if (!el) return;
    el.className = 'live-panel ended mx-3 mb-2 small text-body-secondary';
    el.removeAttribute('data-live-card');
    el.textContent = '⚫ Live ended';
  }

  // Media server mode: video LiveKit se aati hai
  function connectViewerSfu(v, lk) {
    return loadLk().then(function () {
      var L = window.LivekitClient;
      var room = new L.Room({ adaptiveStream: true });
      v.room = room;
      var vid = $('lvVideo');
      room.on(L.RoomEvent.TrackSubscribed, function (track) {
        track.attach(vid);   // video aur awaaz dono isi element par
        var pr = vid.play && vid.play();
        if (pr && pr.catch) pr.catch(function () { $('lvPlay').classList.remove('d-none'); });
      });
      room.on(L.RoomEvent.Disconnected, function () { if (!v.ended) viewMsg('Connection lost…', true); });
      return room.connect(lk.url, lk.token);
    });
  }

  function closeView(v, text, tellServer) {
    if (v.ended) return;
    v.ended = true;
    clearTimeout(v.pollT); clearTimeout(v.slowT);
    barStop('lvScore');
    if (tellServer && v.sess) api('POST', '/live/' + v.id + '/leave', { sess: v.sess }).catch(noop);
    try { if (v.room) v.room.disconnect(); } catch (e) { /* ignore */ }
    try { if (v.pc) { v.pc.ontrack = v.pc.onicecandidate = v.pc.onconnectionstatechange = null; v.pc.close(); } } catch (e) { /* ignore */ }
    $('lvVideo').srcObject = null;
    if (view === v) view = null;
    if (text) {
      viewMsg(text);
      setTimeout(function () { if (!view) $('liveView').classList.add('d-none'); }, 2200);
    } else {
      $('liveView').classList.add('d-none');
    }
  }

  function makeViewerPc(v, ice) {
    var pc = new RTCPeerConnection({ iceServers: ice });
    v.pc = pc;
    pc.onicecandidate = function (e) {
      if (e.candidate) api('POST', '/live/' + v.id + '/signal', { sess: v.sess, type: 'ice', payload: JSON.stringify(e.candidate) }).catch(noop);
    };
    pc.ontrack = function (e) {
      var vid = $('lvVideo');
      if (e.streams && e.streams[0] && vid.srcObject !== e.streams[0]) vid.srcObject = e.streams[0];
      var pr = vid.play && vid.play();
      if (pr && pr.catch) pr.catch(function () { $('lvPlay').classList.remove('d-none'); });
    };
    pc.onconnectionstatechange = function () {
      if (v.ended) return;
      var s = pc.connectionState;
      if (s === 'disconnected' && v.playing) viewMsg('Reconnecting…');
      else if (s === 'connected' && v.playing) viewMsg('');
      else if (s === 'failed') viewMsg('Could not connect. A TURN server may be needed on this network.', true);
    };
  }

  function viewSignal(v, s) {
    var data = parse(s);
    if (!data || v.ended || !v.pc) return Promise.resolve();
    if (s.type === 'offer') {
      return v.pc.setRemoteDescription(data)
        .then(function () { v.remoteSet = true; return flush(v); })
        .then(function () { return v.pc.createAnswer(); })
        .then(function (a) { return v.pc.setLocalDescription(a); })
        .then(function () { return api('POST', '/live/' + v.id + '/signal', { sess: v.sess, type: 'answer', payload: JSON.stringify(v.pc.localDescription) }); });
    }
    if (s.type === 'ice') {
      if (v.remoteSet) return v.pc.addIceCandidate(data).catch(noop);
      v.pending.push(data);
    }
    return Promise.resolve();
  }

  function viewPoll(v) {
    if (v.ended) return;
    api('GET', '/live/' + v.id + '/watch?sess=' + v.sess + '&after=' + v.lastSig).then(function (j) {
      if (v.ended) return;
      if (!j._ok) {
        if (j._status === 404 || j._status === 401) { markCardEnded(v.id); return closeView(v, 'This live has ended', false); }
        if (++v.fails > 12) return closeView(v, 'Connection lost', true);
      } else {
        v.fails = 0;
        if (j.status !== 'live') { markCardEnded(v.id); return closeView(v, 'This live has ended', false); }
        $('lvViewers').textContent = '👁 ' + (j.viewers || 1);
        (j.signals || []).forEach(function (s) {
          if (s.id > v.lastSig) v.lastSig = s.id;
          v.chain = v.chain.then(function () { return viewSignal(v, s); }).catch(function (e) { console.error('[live] signal', e); });
        });
      }
      if (j.poll_ms) v.pollMs = j.poll_ms;
      v.pollT = setTimeout(function () { viewPoll(v); }, v.pollMs);
    }).catch(function () {
      if (v.ended) return;
      if (++v.fails > 12) return closeView(v, 'Connection lost', true);
      v.pollT = setTimeout(function () { viewPoll(v); }, 2000);
    });
  }

  $('lvVideo').addEventListener('playing', function () {
    if (!view) return;
    view.playing = true; viewMsg(''); $('lvPlay').classList.add('d-none');
  });
  $('lvPlay').addEventListener('click', function () {
    if (view && view.room && view.room.startAudio) view.room.startAudio().catch(noop);
    var pr = $('lvVideo').play();
    if (pr && pr.catch) pr.catch(noop);
    this.classList.add('d-none');
  });
  $('lvClose').addEventListener('click', function () { if (view) closeView(view, null, true); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && view && !$('liveView').classList.contains('live-inline')) closeView(view, null, true); });

  /* =================== buttons + page leave =================== */
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;
    var w = t.closest('[data-live-watch]');
    if (w) { e.preventDefault(); openView(w.getAttribute('data-live-watch'), w.getAttribute('data-live-host')); return; }
    var s = t.closest('[data-live-start]');
    if (s) {
      e.preventDefault();
      var ta = document.querySelector('#composer textarea');
      openHost({ body: ta ? ta.value : '', groupId: s.getAttribute('data-live-group') || '' });
    }
  });

    /* =================== docking for the cricket pages =================== */
  ['liveHost', 'liveView'].forEach(function (id) {
    var el = $(id), was = !el.classList.contains('d-none');
    new MutationObserver(function () {
      var now = !el.classList.contains('d-none');
      if (now !== was) { was = now; emit({ role: id === 'liveHost' ? 'host' : 'view', open: now }); }
    }).observe(el, { attributes: true, attributeFilter: ['class'] });
  });
  $('lvFs').addEventListener('click', function () {
    var el = $('liveView');
    if (document.fullscreenElement) { document.exitFullscreen().catch(noop); } else if (el.requestFullscreen) { el.requestFullscreen().catch(noop); }
  });
  window.KZLive = {
    // Move the host / viewer screen into a page slot (it then behaves like an inline video panel)
    dock: function (role, slot) { var el = $(role === 'host' ? 'liveHost' : 'liveView'); if (el && slot) { slot.appendChild(el); el.classList.add('live-inline'); } },
    start: function (opts) { openHost(opts || {}); },
    watch: function (id, name) { openView(String(id), name || ''); },
    refreshBar: function () { Object.keys(bars).forEach(function (k) { if (bars[k].tick) bars[k].tick(); }); },
    status: function () { return { hosting: !!(host && host.live && !host.ended), watching: !!view }; }
  };

  window.addEventListener('beforeunload', function (e) {
    if ((host && host.live && !host.ended) || saving) { e.preventDefault(); e.returnValue = ''; }
  });
  window.addEventListener('pagehide', function () {
    if (host && host.live && !host.ended && host.id) beacon('/live/' + host.id + '/end', {});
    if (view && !view.ended && view.sess) beacon('/live/' + view.id + '/leave', { sess: view.sess });
  });
})();
</script>
