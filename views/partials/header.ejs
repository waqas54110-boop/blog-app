<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title || 'My Blog' %></title>
  <meta name="description" content="<%= locals.metaDescription || 'Notes and tutorials on cricket, video editing, AI, freelancing and web development.' %>">
  <link rel="canonical" href="<%= locals.ogUrl || '' %>">
  <meta property="og:site_name" content="<%= locals.siteName || 'My Blog' %>">
  <meta property="og:title" content="<%= locals.title || 'My Blog' %>">
  <meta property="og:description" content="<%= locals.metaDescription || 'Notes and tutorials on cricket, video editing, AI, freelancing and web development.' %>">
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:url" content="<%= locals.ogUrl || '' %>">
  <% if (locals.ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <% } %>
  <meta name="twitter:card" content="<%= locals.ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= locals.title || 'My Blog' %>">
  <meta name="twitter:description" content="<%= locals.metaDescription || '' %>">
  <% if (locals.ogImage && locals.ogImageCard) { %>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% } %>
  <meta name="theme-color" content="#4f46e5">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/rss+xml" title="My Blog RSS Feed" href="/rss.xml">
  <% (locals.jsonLd || []).forEach(function (block) { %>
  <script type="application/ld+json"><%- safeJson(block) %></script>
  <% }) %>
  <%- include('theme-init') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <style>
    body { background: var(--bs-tertiary-bg); }
    .hero {
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      color: #fff;
      border-radius: 1rem;
    }
    .post-card { transition: transform .15s ease, box-shadow .15s ease; }
    .post-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15) !important; }
    .post-card a.stretched-link { text-decoration: none; }
    .cover-img { height: 180px; object-fit: cover; }
    .avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: #4f46e5; color: #fff; font-weight: 600;
      display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .post-body { line-height: 1.85; font-size: 1.08rem; }
    .post-body img { max-width: 100%; height: auto; border-radius: .5rem; }
    .post-body video.post-video { display: block; width: 100%; max-height: 80vh; background: #000; border-radius: .5rem; margin: 1rem 0; }
    .post-body iframe.post-embed { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: .5rem; margin: 1rem 0; }
    .post-body pre { background: var(--bs-secondary-bg); padding: 1rem; border-radius: .5rem; overflow-x: auto; }
    .post-body code { background: var(--bs-secondary-bg); padding: .1rem .35rem; border-radius: .25rem; }
    .post-body pre code { background: none; padding: 0; }
    .post-body blockquote { border-left: 4px solid #4f46e5; padding-left: 1rem; color: var(--bs-secondary-color); }
    .post-body h1, .post-body h2, .post-body h3 { scroll-margin-top: 80px; }
    #readProgress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: #7c3aed; z-index: 2000; transition: width .1s linear; }
    .toc a { text-decoration: none; }
    .toc a:hover { text-decoration: underline; }
    .comment-body { white-space: pre-wrap; }
    .reply-box { margin-left: 3rem; }
    .notif-unread { border-left: 4px solid #4f46e5; background: var(--bs-primary-bg-subtle); }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg bg-body shadow-sm sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold text-primary" href="/">My Blog</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Categories
          </a>
          <ul class="dropdown-menu">
            <% if (navCategories.length === 0) { %>
              <li><span class="dropdown-item-text text-muted">No categories yet</span></li>
            <% } %>
            <% navCategories.forEach(c => { %>
              <li><a class="dropdown-item" href="/?category=<%= encodeURIComponent(c) %>"><%= c %></a></li>
            <% }) %>
          </ul>
        </li>

        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/community">👥 Community</a></li>
        <li class="nav-item"><a class="nav-link" href="/leaderboard">🏆 Leaderboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/votes">🗳️ Vote</a></li>
        <li class="nav-item"><a class="nav-link" href="/hire">💼 Hire Me</a></li>
      </ul>

      <form class="d-flex me-lg-3 mb-2 mb-lg-0" action="/" method="GET" role="search">
        <input class="form-control form-control-sm me-2" type="search" name="q" placeholder="Search posts..." aria-label="Search">
        <button class="btn btn-sm btn-outline-primary" type="submit">Search</button>
      </form>

      <button id="themeToggle" class="btn btn-sm btn-outline-secondary me-lg-2 mb-2 mb-lg-0" type="button">🌙 Dark</button>

      <% if (user) { %>
        <a href="/notifications" class="btn btn-sm btn-outline-secondary position-relative me-lg-2 mb-2 mb-lg-0" title="Notifications">
          🔔
          <% if (locals.unreadCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= unreadCount > 9 ? '9+' : unreadCount %></span>
          <% } %>
        </a>
        <div class="dropdown">
          <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= user.username %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <% if (isAdmin) { %>
              <li><a class="dropdown-item" href="/posts/new">Write Post</a></li>
              <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
              <li><a class="dropdown-item" href="/analytics">Analytics</a></li>
              <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center" href="/inbox">
                  Inbox
                  <% if (locals.newInquiries > 0) { %><span class="badge rounded-pill bg-danger ms-2"><%= newInquiries %></span><% } %>
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
            <% } %>
            <li><a class="dropdown-item" href="/bookmarks">My Bookmarks</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST" class="mb-0">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item text-danger">Logout</button>
              </form>
            </li>
          </ul>
        </div>
      <% } else { %>
        <div class="d-flex gap-2">
          <a href="/login" class="btn btn-sm btn-outline-primary">Login</a>
          <a href="/signup" class="btn btn-sm btn-primary">Sign Up</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<main class="container py-4">