<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title || 'Khabzo' %></title>
  <meta name="description" content="<%= locals.metaDescription || 'Notes and tutorials on cricket, video editing, AI, freelancing and web development.' %>">
  <% if (locals.googleVerification) { %>
  <meta name="google-site-verification" content="<%= googleVerification %>">
  <% } %>
  <% if (locals.bingVerification) { %>
  <meta name="msvalidate.01" content="<%= bingVerification %>">
  <% } %>
  <% if (locals.yandexVerification) { %>
  <meta name="yandex-verification" content="<%= yandexVerification %>">
  <% } %>
  <meta name="author" content="<%= locals.siteName || 'Khabzo' %>">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <meta name="robots" content="<%= locals.robots || 'index,follow,max-image-preview:large,max-snippet:-1' %>">
  <link rel="canonical" href="<%= locals.ogUrl || '' %>">
  <meta property="og:site_name" content="<%= locals.siteName || 'Khabzo' %>">
  <meta property="og:title" content="<%= locals.title || 'Khabzo' %>">
  <meta property="og:description" content="<%= locals.metaDescription || 'Notes and tutorials on cricket, video editing, AI, freelancing and web development.' %>">
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:url" content="<%= locals.ogUrl || '' %>">
  <meta property="og:locale" content="en_US">
  <% if (locals.publishedTime) { %>
  <meta property="article:published_time" content="<%= publishedTime %>">
  <% } %>
  <% if (locals.modifiedTime) { %>
  <meta property="article:modified_time" content="<%= modifiedTime %>">
  <% } %>
  <% if (locals.articleSection) { %>
  <meta property="article:section" content="<%= articleSection %>">
  <% } %>
  <% (locals.articleTags || []).forEach(function (t) { %>
  <meta property="article:tag" content="<%= t %>">
  <% }) %>
  <% if (locals.ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <meta property="og:image:alt" content="<%= locals.ogImageAlt || locals.title || 'Khabzo' %>">
  <meta name="twitter:image:alt" content="<%= locals.ogImageAlt || locals.title || 'Khabzo' %>">
  <% } %>
  <% if (locals.twitterHandle) { %>
  <meta name="twitter:site" content="@<%= twitterHandle %>">
  <% } %>
  <meta name="twitter:card" content="<%= locals.ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= locals.title || 'Khabzo' %>">
  <meta name="twitter:description" content="<%= locals.metaDescription || '' %>">
  <% if (locals.ogImage && locals.ogImageCard) { %>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% } %>
  <meta name="theme-color" content="#4f46e5">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/icons/180.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="<%= locals.siteName || 'Khabzo' %>">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <script>
    // "Install app" ka event page load ke baad kabhi bhi aa sakta hai: pehle hi pakad kar rakh lo
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      window.__installEvt = e;
      document.dispatchEvent(new Event('install-ready'));
    });
  </script>
  <link rel="alternate" type="application/rss+xml" title="Khabzo RSS Feed" href="/rss.xml">
  <link rel="search" type="application/opensearchdescription+xml" title="Khabzo" href="/opensearch.xml">
  <% (locals.jsonLd || []).forEach(function (block) { %>
  <script type="application/ld+json"><%- safeJson(block) %></script>
  <% }) %>
  <%- include('theme-init') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,800&family=Archivo:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <style>
    body { background: var(--bs-tertiary-bg); }
    .hero {
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      color: #fff;
      border-radius: 1rem;
    }
    .post-card { transition: transform .15s ease, box-shadow .15s ease; }
    .post-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15) !important; }
    .post-card a.stretched-link { text-decoration: none; }
    .cover-img { height: 180px; object-fit: cover; }
    .avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: #4f46e5; color: #fff; font-weight: 600;
      display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
      position: relative; overflow: hidden;
    }
    .avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    /* ===== Khabzo: akhbar jaisa masthead + category nav ===== */
    :root {
      --kz-serif: "Newsreader", Georgia, "Times New Roman", serif;
      --kz-sans: "Archivo", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --kz-paper: var(--bs-body-bg); --kz-muted: var(--bs-secondary-color); --kz-line: var(--bs-border-color);
      --kz-accent: #0a6b4d;
    }
    [data-bs-theme="dark"] { --kz-accent: #3cc99a; }
    .kz-mast { background: radial-gradient(900px 220px at 0% 0%, color-mix(in srgb, var(--kz-accent) 14%, transparent), transparent 70%), var(--kz-paper); border-top: 4px solid var(--kz-accent); border-bottom: 1px solid var(--kz-line); }
    .kz-mast-in { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px; padding-top: 18px; padding-bottom: 12px; }
    .kz-logo { font: 800 clamp(38px, 8vw, 60px)/.95 var(--kz-serif); letter-spacing: -.03em; color: var(--bs-body-color); text-decoration: none; }
    .kz-logo .nm { background: linear-gradient(100deg, var(--bs-body-color) 35%, var(--kz-accent) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .kz-logo:hover { color: var(--bs-body-color); }
    .kz-logo small { display: block; font: 400 13px/1.3 var(--kz-sans); letter-spacing: 0; color: var(--kz-muted); margin-top: 6px; }
    .kz-search { display: flex; gap: 6px; flex: 0 1 340px; min-width: 200px; }
    .kz-search input { flex: 1; min-width: 0; font: 400 14px var(--kz-sans); }
    .kz-search button { font: 600 13px var(--kz-sans); white-space: nowrap; }
    .kz-install { font: 600 13px var(--kz-sans); white-space: nowrap; }
    .kz-nav { position: sticky; top: 0; z-index: 1030; background: var(--kz-paper); border-bottom: 1px solid var(--kz-line); box-shadow: 0 6px 24px rgba(0,0,0,.06); }
    @supports (backdrop-filter: blur(1px)) { .kz-nav { background: color-mix(in srgb, var(--kz-paper) 82%, transparent); backdrop-filter: blur(14px) saturate(1.5); -webkit-backdrop-filter: blur(14px) saturate(1.5); } }
    .kz-nav-in { display: flex; align-items: stretch; gap: 6px; }
    .kz-links { flex: 1 1 auto; min-width: 0; display: flex; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .kz-links::-webkit-scrollbar { display: none; }
    .kz-links a { font: 600 15px var(--kz-sans); padding: 12px 13px; white-space: nowrap; color: var(--bs-body-color); text-decoration: none; border-bottom: 3px solid transparent; margin-bottom: -2px; }
    .kz-links a:hover, .kz-links a.on { color: var(--kz-accent); border-bottom-color: var(--kz-accent); }
    .kz-links a.on { font-weight: 700; }
    .kz-tools { flex: 0 0 auto; display: flex; align-items: center; gap: 6px; padding-left: 8px; border-left: 1px solid var(--kz-line); }
    .kz-icon { position: relative; min-width: 38px; height: 38px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--kz-line); background: transparent; color: var(--bs-body-color); border-radius: 8px; font: 600 13px var(--kz-sans); line-height: 1; text-decoration: none; white-space: nowrap; cursor: pointer; }
    .kz-icon:hover { background: var(--bs-secondary-bg); color: var(--bs-body-color); }
    .kz-icon.solid { background: var(--bs-body-color); color: var(--bs-body-bg); border-color: var(--bs-body-color); }
    .kz-icon.solid:hover { opacity: .88; background: var(--bs-body-color); color: var(--bs-body-bg); }
    .kz-icon.p0 { padding: 0; border-radius: 50%; border: 0; }
    .kz-nav .dropdown-toggle::after { display: none; }
    @media (max-width: 575.98px) {
      .kz-search { flex: 1 1 100%; }
      .kz-links a { padding: 12px 11px; font-size: 14px; }
      .kz-icon { min-width: 36px; height: 36px; padding: 0 8px; }
    }
    @media print { .kz-mast, .kz-nav { display: none !important; } }

    .post-body { line-height: 1.85; font-size: 1.08rem; }
    .post-body img { max-width: 100%; height: auto; border-radius: .5rem; }
    .post-body video.post-video { display: block; width: 100%; max-height: 80vh; background: #000; border-radius: .5rem; margin: 1rem 0; }
    .post-body iframe.post-embed { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: .5rem; margin: 1rem 0; }
    .post-body pre { background: var(--bs-secondary-bg); padding: 1rem; border-radius: .5rem; overflow-x: auto; }
    .post-body code { background: var(--bs-secondary-bg); padding: .1rem .35rem; border-radius: .25rem; }
    .post-body pre code { background: none; padding: 0; }
    .post-body blockquote { border-left: 4px solid #4f46e5; padding-left: 1rem; color: var(--bs-secondary-color); }
    .post-body h1, .post-body h2, .post-body h3 { scroll-margin-top: 80px; }
    #readProgress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: #7c3aed; z-index: 2000; transition: width .1s linear; }
    .toc a { text-decoration: none; }
    .toc a:hover { text-decoration: underline; }
    .comment-body { white-space: pre-wrap; }
    .reply-box { margin-left: 3rem; }
    .notif-unread { border-left: 4px solid #4f46e5; background: var(--bs-primary-bg-subtle); }
  </style>
</head>
<body>

<header class="kz-mast">
  <div class="container kz-mast-in">
    <a class="kz-logo" href="/" aria-label="<%= locals.siteName || 'Khabzo' %> home"><span class="nm"><%= locals.siteName || 'Khabzo' %></span><small><%= locals.todayLabel ? locals.todayLabel + ' | ' : '' %>Cricket, news and community</small></a>
    <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1 flex-sm-grow-0 justify-content-end">
      <button id="installBtn" class="btn btn-sm btn-primary kz-install d-none" type="button">📲 Install</button>
      <form class="kz-search" action="/blog" method="GET" role="search">
        <input class="form-control form-control-sm" type="search" name="q" placeholder="Search posts..." aria-label="Search posts">
        <button class="btn btn-sm btn-outline-secondary" type="submit">Search</button>
      </form>
    </div>
  </div>
</header>

<%
  const _path = locals.currentPath || '';
  const _isHome = _path === '/' && typeof locals.tab === 'undefined';
  const _isFeed = _path === '/' && typeof locals.tab !== 'undefined';
  const _isBlog = _path === '/blog' || _path.indexOf('/posts/') === 0;
  const _cat = _path === '/blog' ? (locals.category || '') : '';
%>
<nav class="kz-nav" aria-label="Main">
  <div class="container kz-nav-in">
    <div class="kz-links">
      <a href="/" class="<%= _isHome ? 'on' : '' %>">Home</a>
      <a href="/?tab=all" class="<%= _isFeed ? 'on' : '' %>">Feed</a>
      <a href="/blog" class="<%= (_isBlog && !_cat && _path === '/blog') ? 'on' : '' %>">Blog</a>
      <% navCategories.forEach(c => { %>
        <a href="/blog?category=<%= encodeURIComponent(c) %>" class="<%= _cat === c ? 'on' : '' %>"><%= c %></a>
      <% }) %>
    </div>

    <div class="kz-tools">
      <button id="themeToggle" class="kz-icon" type="button" data-icon-only title="Dark / light mode">🌙</button>

      <% if (user) { %>
        <a href="/notifications" class="kz-icon" title="Notifications" aria-label="Notifications">
          🔔
          <% if (locals.unreadCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= unreadCount > 9 ? '9+' : unreadCount %></span>
          <% } %>
        </a>
        <a href="/messages" class="kz-icon" title="Messages" aria-label="Messages">
          💬
          <% if (locals.unreadMessages > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"><%= unreadMessages > 9 ? '9+' : unreadMessages %></span>
          <% } %>
        </a>
        <div class="dropdown">
          <button class="kz-icon p0" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                  title="<%= user.username %>" aria-label="Account menu for <%= user.username %>">
            <span class="avatar"><%= user.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(user.username) %>" alt="" onerror="this.remove()"></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text fw-semibold text-break" style="max-width: 240px;"><%= user.username %></span></li>
            <li><hr class="dropdown-divider"></li>
            <% if (isAdmin) { %>
              <li><a class="dropdown-item" href="/posts/new">Write Post</a></li>
              <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
              <li><a class="dropdown-item" href="/analytics">Analytics</a></li>
              <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center" href="/admin/moderation">
                  Moderation
                  <% if (locals.openReports > 0) { %><span class="badge rounded-pill bg-danger ms-2"><%= openReports %></span><% } %>
                </a>
              </li>
              <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center" href="/admin/payouts">
                  Payouts
                  <% if (locals.pendingPayouts > 0) { %><span class="badge rounded-pill bg-danger ms-2"><%= pendingPayouts %></span><% } %>
                </a>
              </li>
              <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center" href="/inbox">
                  Inbox
                  <% if (locals.newInquiries > 0) { %><span class="badge rounded-pill bg-danger ms-2"><%= newInquiries %></span><% } %>
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
            <% } %>
            <li><a class="dropdown-item" href="/u/<%= encodeURIComponent(user.username) %>">My Profile</a></li>
            <li><a class="dropdown-item" href="/settings/profile">✏️ Edit Profile</a></li>
            <li><a class="dropdown-item" href="/?user=<%= encodeURIComponent(user.username) %>">📸 My Posts</a></li>
            <li>
              <a class="dropdown-item d-flex justify-content-between align-items-center" href="/friends<%= locals.pendingFriends > 0 ? '?tab=requests' : '' %>">
                👫 Friends
                <% if (locals.pendingFriends > 0) { %><span class="badge rounded-pill bg-danger ms-2"><%= pendingFriends %></span><% } %>
              </a>
            </li>
            <li><a class="dropdown-item" href="/earnings">💰 Earnings</a></li>
            <li><a class="dropdown-item" href="/invite">🎁 Invite Friends</a></li>
            <li><a class="dropdown-item" href="/bookmarks">My Bookmarks</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST" class="mb-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item text-danger">Logout</button>
              </form>
            </li>
          </ul>
        </div>
      <% } else { %>
        <a href="/login" class="kz-icon">Login</a>
        <a href="/signup" class="kz-icon solid d-none d-sm-inline-flex">Sign Up</a>
      <% } %>

      <div class="dropdown">
        <button class="kz-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More menu" title="More">☰</button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><a class="dropdown-item" href="/community">👥 Community</a></li>
          <li><a class="dropdown-item" href="/groups">🫂 Groups</a></li>
          <li><a class="dropdown-item" href="/leaderboard">🏆 Leaderboard</a></li>
          <li><a class="dropdown-item" href="/votes">🗳️ Vote</a></li>
          <li><a class="dropdown-item" href="/hire">💼 Hire Me</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/about">About</a></li>
          <% if (!user) { %><li><a class="dropdown-item d-sm-none fw-semibold" href="/signup">Sign Up</a></li><% } %>
        </ul>
      </div>
    </div>
  </div>
</nav>

<main class="container py-4">
