<%# Post likhne ka box (photo upload ke saath). Locals: groupId (group ki post ho to), placeholder (optional) %>
  <form id="composer" class="card composer shadow-sm mb-3" action="/feed" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="image_id" value="">
  <% if (locals.groupId) { %><input type="hidden" name="group_id" value="<%= groupId %>"><% } %>
    <div class="card-body">
      <div class="d-flex gap-2 align-items-start">
        <span class="avatar avatar-md mt-1"><%= user.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(user.username) %>" alt="" onerror="this.remove()"></span>
        <textarea name="body" class="form-control" rows="2" maxlength="2000" placeholder="<%= locals.placeholder || ('What\'s on your mind, ' + user.username + '?') %>"></textarea>
      </div>
      <div id="photoPreview" class="composer-preview mt-3 d-none">
        <img src="" alt="Selected photo">
        <button type="button" class="rm" aria-label="Remove photo">✕</button>
      </div>
      <div class="small text-danger mt-2" id="composerMsg"></div>
      <div class="d-flex align-items-center gap-2 mt-3">
        <input type="file" id="photoFile" accept="image/*" class="d-none">
        <button type="button" id="photoBtn" class="btn btn-photo">📷 Photo</button>
        <% if (locals.liveCanStart) { %><button type="button" class="btn btn-photo btn-live" data-live-start<% if (locals.groupId) { %> data-live-group="<%= groupId %>"<% } %>><span class="live-dot"></span> Live</button><% } %>
        <span class="small text-body-secondary ms-auto" id="charCount"></span>
        <button type="submit" id="postBtn" class="btn btn-primary btn-post">Post</button>
      </div>
    </div>
  </form>

<script>
(function () {
  var csrf = <%- JSON.stringify(csrfToken || '') %>;

  // ----- Composer -----
  var form = document.getElementById('composer');
  if (!form) return;
  var ta = form.querySelector('textarea'), file = document.getElementById('photoFile'), pick = document.getElementById('photoBtn');
  var prev = document.getElementById('photoPreview'), prevImg = prev.querySelector('img'), rm = prev.querySelector('.rm');
  var idInput = form.querySelector('[name=image_id]'), postBtn = document.getElementById('postBtn');
  var msg = document.getElementById('composerMsg'), count = document.getElementById('charCount');
  var busy = false, blobUrl = null;

  function grow() {
    ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 260) + 'px';
    var n = ta.value.length; count.textContent = n > 1500 ? (2000 - n) + ' left' : '';
  }
  ta.addEventListener('input', grow);

  function clearPhoto() {
    if (blobUrl) { URL.revokeObjectURL(blobUrl); blobUrl = null; }
    prev.classList.add('d-none'); prev.classList.remove('busy'); prevImg.removeAttribute('src');
    idInput.value = ''; file.value = ''; busy = false; postBtn.disabled = false;
  }

  pick.addEventListener('click', function () { file.click(); });
  rm.addEventListener('click', function () {
    var id = idInput.value;
    clearPhoto();
    if (id) fetch('/feed/image/discard', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf, 'X-Requested-With': 'fetch' },
      body: 'id=' + encodeURIComponent(id)
    });
  });

  function upload(blob) {
    busy = true; postBtn.disabled = true; msg.textContent = '';
    if (blobUrl) URL.revokeObjectURL(blobUrl);
    blobUrl = URL.createObjectURL(blob);
    prevImg.src = blobUrl; prev.classList.remove('d-none'); prev.classList.add('busy');
    fetch('/upload-feed-image', { method: 'POST', headers: { 'Content-Type': 'image/jpeg', 'x-csrf-token': csrf }, body: blob, credentials: 'same-origin' })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (x.ok && x.j.id) { idInput.value = x.j.id; prev.classList.remove('busy'); busy = false; postBtn.disabled = false; }
        else { clearPhoto(); msg.textContent = (x.j && x.j.error) || 'Photo upload failed. Please try again.'; }
      })
      .catch(function () { clearPhoto(); msg.textContent = 'Photo upload failed. Please try again.'; });
  }

  file.addEventListener('change', function () {
    var f = file.files[0]; if (!f) return;
    msg.textContent = '';
    if (!/^image\//.test(f.type)) { msg.textContent = 'Please choose an image.'; file.value = ''; return; }
    // Pehle purani upload ki hui (post na hui) photo saaf
    var old = idInput.value;
    if (old) fetch('/feed/image/discard', { method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf, 'X-Requested-With': 'fetch' }, body: 'id=' + encodeURIComponent(old) });
    idInput.value = '';

    var img = new Image(), url = URL.createObjectURL(f);
    img.onload = function () {
      // Bari photo ko 1600px tak chhota karo (JPEG): tez upload, kam bandwidth
      function encode(max, q, cb) {
        var s = Math.min(1, max / Math.max(img.width, img.height));
        var c = document.createElement('canvas'); c.width = Math.round(img.width * s); c.height = Math.round(img.height * s);
        var ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        c.toBlob(cb, 'image/jpeg', q);
      }
      encode(1600, 0.85, function (blob) {
        if (blob && blob.size > 1900000) return encode(1280, 0.65, function (b2) { URL.revokeObjectURL(url); b2 ? upload(b2) : (msg.textContent = 'Could not read this image.'); });
        URL.revokeObjectURL(url);
        blob ? upload(blob) : (msg.textContent = 'Could not read this image.');
      });
    };
    img.onerror = function () { URL.revokeObjectURL(url); msg.textContent = 'Could not read this image. Please try a JPG or PNG photo.'; file.value = ''; };
    img.src = url;
  });

  form.addEventListener('submit', function (e) {
    if (busy) { e.preventDefault(); msg.textContent = 'Photo is still uploading...'; return; }
    if (!ta.value.trim() && !idInput.value) { e.preventDefault(); msg.textContent = 'Write something or add a photo first.'; return; }
    postBtn.disabled = true; postBtn.textContent = 'Posting...';
  });
  window.addEventListener('pageshow', function (ev) { if (ev.persisted) { postBtn.disabled = false; postBtn.textContent = 'Post'; } });
})();
</script>
