<style>
  .pt { --pt-green: var(--kz-accent, #0a6b4d); --pt-gold: #c58a00; }
  [data-bs-theme="dark"] .pt { --pt-gold: #f2c14e; }
  .pt-hero { border-radius: 18px; padding: clamp(22px, 4vw, 40px); color: #fff; position: relative; overflow: hidden;
    background: radial-gradient(600px 240px at 90% 0%, rgba(242,193,78,.28), transparent 70%), linear-gradient(120deg, #0a6b4d, #0b4f3a); }
  .pt-hero h1 { font: 800 clamp(34px, 6vw, 58px)/1 var(--kz-serif); letter-spacing: -.02em; margin: 0 0 10px; }
  .pt-hero p { font: 400 17px/1.5 var(--kz-sans); max-width: 600px; margin: 0 0 18px; opacity: .92; }
  .pt-stats { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 20px; font: 500 14px var(--kz-sans); opacity: .95; }
  .pt-stats b { font: 800 26px var(--kz-serif); display: block; line-height: 1.1; }
  .pt-btn { display: inline-block; background: #f2c14e; color: #2b2100; font: 800 16px var(--kz-sans); padding: 12px 22px; border-radius: 12px; text-decoration: none; border: 0; }
  .pt-btn:hover { background: #ffd36b; color: #2b2100; }
  .pt-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 20px 0 8px; }
  .pt-chip { font: 600 13px var(--kz-sans); padding: 6px 12px; border-radius: 99px; border: 1px solid var(--kz-line); text-decoration: none; color: var(--bs-body-color); white-space: nowrap; }
  .pt-chip.on, .pt-chip:hover { background: var(--pt-green); color: #fff; border-color: var(--pt-green); }
  .pt-chip small { opacity: .75; font-weight: 500; }
  .pt-scroll { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
  .pt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-top: 12px; }
  .pc-card { display: flex; flex-direction: column; border: 1px solid var(--kz-line); border-radius: 14px; overflow: hidden; text-decoration: none; color: inherit; background: var(--bs-body-bg); transition: border-color .15s, transform .15s; }
  .pc-card:hover { border-color: var(--pt-green); transform: translateY(-2px); color: inherit; }
  .pc-media { position: relative; aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center; background: var(--bs-secondary-bg); overflow: hidden; }
  .pc-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pc-city-big { font: 800 28px var(--kz-serif); color: #fff; text-align: center; padding: 0 12px; overflow-wrap: anywhere; }
  .pc-cat { position: absolute; left: 10px; top: 10px; background: rgba(0,0,0,.62); color: #fff; font: 700 11px var(--kz-sans); padding: 3px 9px; border-radius: 99px; }
  .pc-hot, .pc-won { position: absolute; right: 10px; top: 10px; font: 800 11px var(--kz-sans); padding: 3px 9px; border-radius: 99px; background: #f2c14e; color: #2b2100; }
  .pc-won { background: #1f9d6b; color: #fff; }
  .pc-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .pc-title { font: 700 18px/1.25 var(--kz-serif); margin: 0; }
  .pc-where { font: 500 13px var(--kz-sans); color: var(--kz-muted); }
  .pc-meter { height: 8px; border-radius: 99px; background: var(--bs-secondary-bg); overflow: hidden; margin-top: auto; }
  .pc-meter span { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--pt-green), #1fbf8a); }
  .pc-nums { font: 500 13px var(--kz-sans); color: var(--kz-muted); }
  .pc-nums b { font: 800 16px var(--kz-sans); color: var(--bs-body-color); }
  .pc-nums span { float: right; }
</style>
