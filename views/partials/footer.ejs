</main>

<div class="text-center py-3 bg-body-tertiary border-top">
  <a href="/community" class="text-decoration-none fw-semibold">
    👥 Join our WhatsApp &amp; Facebook community &rarr;
  </a>
</div>

<section class="bg-primary bg-gradient text-white py-5">
  <div class="container text-center">
    <h4 class="fw-bold mb-2">📬 Get new posts in your inbox</h4>
    <p class="mb-4 opacity-75">No spam, just an email whenever a new post goes up.</p>

    <% if (locals.subscribed) { %>
      <div class="alert alert-success d-inline-block py-2 px-3 mb-3">Thanks for subscribing! 🎉</div>
      <br>
    <% } else if (locals.subscribeError) { %>
      <div class="alert alert-danger d-inline-block py-2 px-3 mb-3"><%= subscribeError %></div>
      <br>
    <% } %>

    <form action="/subscribe" method="POST" class="d-flex flex-wrap justify-content-center gap-2">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="email" name="email" required placeholder="you@example.com"
             class="form-control" style="max-width:320px;">
      <button type="submit" class="btn btn-light fw-semibold">Subscribe</button>
    </form>

    <div class="mt-3">
      <button id="pushBtn" type="button" class="btn btn-outline-light btn-sm d-none">🔔 Notify me on this device</button>
    </div>
  </div>
</section>

<footer class="text-center text-body-secondary small py-4 border-top bg-body">
  &copy; <%= new Date().getFullYear() %> Khabzo. Built with Node.js, Express, EJS and PostgreSQL.
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<%- include('theme-toggle') %>

<div id="netBanner" class="position-fixed bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 rounded-pill shadow small fw-semibold text-bg-dark d-none" style="z-index:3000;" role="status">📡 You're offline. Some things may not work.</div>

<script>
  // App ki tarah install (Android/Chrome: asli prompt, iPhone: Add to Home Screen ki hidayat) + offline ka chhota message
  (function () {
    var btn = document.getElementById('installBtn');
    var banner = document.getElementById('netBanner');
    var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

    if (btn && !standalone) {
      var ios = /iphone|ipad|ipod/i.test(navigator.userAgent) && !window.MSStream;
      function show() { btn.classList.remove('d-none'); }
      if (window.__installEvt) show();
      document.addEventListener('install-ready', show);
      if (ios) show(); // iOS mein prompt nahi hota, sirf hidayat dikha sakte hain

      btn.addEventListener('click', function () {
        var ev = window.__installEvt;
        if (ev) {
          ev.prompt();
          ev.userChoice.then(function () { window.__installEvt = null; btn.classList.add('d-none'); });
        } else if (ios) {
          alert('To install: tap the Share button in Safari, then choose "Add to Home Screen".');
        }
      });
      window.addEventListener('appinstalled', function () { btn.classList.add('d-none'); });
    }

    if (banner) {
      function net() { banner.classList.toggle('d-none', navigator.onLine); }
      window.addEventListener('online', net);
      window.addEventListener('offline', net);
      net();
    }
  })();
</script>

<script>
  // Service worker (push + install) aur "Notify me" button
  (function () {
    if (!('serviceWorker' in navigator)) return;
    var btn = document.getElementById('pushBtn');
    var csrf = <%- JSON.stringify(csrfToken || '') %>;

    function keyToBytes(b64) {
      var pad = '='.repeat((4 - (b64.length % 4)) % 4);
      var raw = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/'));
      var out = new Uint8Array(raw.length);
      for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
      return out;
    }
    function post(url, data) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
        body: JSON.stringify(data)
      });
    }

    navigator.serviceWorker.register('/sw.js').catch(function () {});
    if (!btn || !('PushManager' in window) || !('Notification' in window)) return;

    Promise.all([
      navigator.serviceWorker.ready,
      fetch('/push/key').then(function (r) { return r.ok ? r.json() : null; })
    ]).then(function (res) {
      var reg = res[0], k = res[1];
      if (!k || !k.key) return; // server par push tayyar nahi
      btn.classList.remove('d-none');

      function paint() {
        reg.pushManager.getSubscription().then(function (sub) {
          btn.dataset.on = sub ? '1' : '';
          btn.textContent = sub ? '🔕 Turn off notifications' : '🔔 Notify me on this device';
        });
      }
      paint();

      btn.addEventListener('click', function () {
        btn.disabled = true;
        reg.pushManager.getSubscription().then(function (sub) {
          if (sub) {
            var endpoint = sub.endpoint;
            return sub.unsubscribe().then(function () { return post('/push/unsubscribe', { endpoint: endpoint }); });
          }
          return Notification.requestPermission().then(function (perm) {
            if (perm !== 'granted') { alert('Notifications are blocked. Allow them in your browser settings to turn this on.'); return; }
            return reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: keyToBytes(k.key) })
              .then(function (s) { return post('/push/subscribe', s.toJSON()); });
          });
        }).catch(function () { alert('Could not change notification setting. Please try again.'); })
          .then(function () { btn.disabled = false; paint(); });
      });
    }).catch(function () {});
  })();
</script>

<% if (locals.user) { %><%- include('call-ui') %><%- include('live-ui') %><% } %>

</body>
</html>