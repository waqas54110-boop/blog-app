<%# People tab / suggestions ki ek card. Locals: p, act, here, qs, i %>
<%
  const _sub = p.mutual > 0
    ? `<span class="fr-chip">👥 ${p.mutual} mutual friend${p.mutual === 1 ? '' : 's'}</span>`
    : '<span class="fr-chip ghost">New to you</span>';
  let _actions = '';
  let _badge = '';
  if (p.state === 'sent') {
    _badge = '<span class="fr-state">⏳ Request sent</span>';
    _actions = act('decline', p.username, 'Cancel', 'fr-b fr-soft', here + qs);
  } else if (p.state === 'received') {
    _actions = act('accept', p.username, '✓ Accept', 'fr-b fr-go', here + qs) + act('decline', p.username, 'Decline', 'fr-b fr-soft', here + qs);
  } else if (p.state === 'friends') {
    _badge = '<span class="fr-state ok">✓ Friends</span>';
  } else {
    _actions = act('request', p.username, '＋ Add friend', 'fr-b fr-go', here + qs);
  }
%>
<%- include('fr-card', { p, sub: _sub, actions: _actions, badge: _badge, i: locals.i || 0 }) %>
