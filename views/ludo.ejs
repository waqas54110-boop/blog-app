<style>
  :root {
    --ld-red: #ff2d55;
    --ld-red-2: #e11d48;
    --ld-red-dark: #7f1d1d;
    --ld-gold: #ffd60a;
    --ld-amber: #f59e0b;
    --ld-green: #34d399;
    --ld-blue: #38bdf8;
    --ld-purple: #a855f7;
    --ld-pink: #ec4899;
    --ld-cyan: #06b6d4;
  }

  /* ================= BASE ================= */
  .ld {
    font-family: var(--kz-sans);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 100vh;
  }

  /* Aurora background */
  .ld-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    overflow: hidden;
  }
  .ld-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: .42;
    will-change: transform;
  }
  .ld-blob.b1 {
    width: 560px; height: 560px;
    background: radial-gradient(circle, #ff2d55, transparent 70%);
    top: -180px; left: -180px;
    animation: ldFloat 16s ease-in-out infinite;
  }
  .ld-blob.b2 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, #38bdf8, transparent 70%);
    top: 22%; right: -220px;
    animation: ldFloat 20s ease-in-out infinite reverse;
  }
  .ld-blob.b3 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, #ffd60a, transparent 70%);
    bottom: -200px; left: 32%;
    animation: ldFloat 24s ease-in-out infinite;
    opacity: .28;
  }
  .ld-blob.b4 {
    width: 420px; height: 420px;
    background: radial-gradient(circle, #a855f7, transparent 70%);
    top: 55%; left: 8%;
    opacity: .3;
    animation: ldFloat 22s ease-in-out infinite reverse;
  }

  @keyframes ldFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(60px, 50px) scale(1.14); }
    66%      { transform: translate(-50px, 40px) scale(.92); }
  }

  .ld-grain {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .05;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .ld h1, .ld h2, .ld h3 { font-family: var(--kz-serif); letter-spacing: -.025em; }

  /* ================= HERO ================= */
  .ld-hero {
    position: relative;
    border-radius: 32px;
    padding: clamp(32px, 5.5vw, 72px);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(120deg, #1a0a1a 0%, #7f1d1d 18%, #e11d48 38%, #ffd60a 58%, #34d399 76%, #38bdf8 100%);
    background-size: 400% 400%;
    animation: ldGradient 18s ease infinite;
    box-shadow:
      0 50px 100px -40px rgba(255,45,85,.7),
      0 0 0 1px rgba(255,255,255,.1) inset,
      0 0 150px -40px rgba(255,45,85,.7);
  }
  @keyframes ldGradient {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  .ld-hero::before {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 85% 15%, rgba(255,255,255,.35), transparent 42%),
      radial-gradient(circle at 15% 85%, rgba(255,255,255,.18), transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(255,255,255,.05), transparent 60%);
    z-index: -1;
  }

  /* Rotating conic border glow */
  .ld-hero::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(from 0deg,
      rgba(255,255,255,0) 0deg,
      rgba(255,214,10,.9) 60deg,
      rgba(255,255,255,0) 150deg,
      rgba(56,189,248,.9) 240deg,
      rgba(255,255,255,0) 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: ldRotate 10s linear infinite;
    pointer-events: none;
    z-index: 1;
    filter: blur(.4px);
  }
  @keyframes ldRotate { to { transform: rotate(360deg); } }

  /* 3D floating dice */
  .ld-dice {
    position: absolute;
    pointer-events: none;
    filter: drop-shadow(0 14px 40px rgba(0,0,0,.55));
    will-change: transform;
    z-index: 1;
  }
  .ld-dice svg { width: 100%; height: 100%; display: block; }
  .ld-dice.d1 { width: clamp(80px, 13vw, 148px); top: -6px; right: 26px; animation: ldSpin1 16s linear infinite; }
  .ld-dice.d2 { width: clamp(52px, 9vw, 92px); bottom: -20px; right: 44%; opacity: .6; animation: ldSpin2 22s linear infinite reverse; }
  .ld-dice.d3 { width: clamp(38px, 6.5vw, 66px); top: 34%; right: 6%; opacity: .5; animation: ldSpin1 26s linear infinite; }
  .ld-dice.d4 { width: clamp(42px, 7.5vw, 74px); bottom: 14%; right: 22%; opacity: .42; animation: ldSpin2 20s linear infinite; }

  @keyframes ldSpin1 {
    0%   { transform: rotate(0deg) translateY(0) scale(1); }
    50%  { transform: rotate(180deg) translateY(-16px) scale(1.06); }
    100% { transform: rotate(360deg) translateY(0) scale(1); }
  }
  @keyframes ldSpin2 {
    0%   { transform: rotate(0deg) translateX(0); }
    50%  { transform: rotate(-180deg) translateX(-18px); }
    100% { transform: rotate(-360deg) translateX(0); }
  }

  /* Particles */
  .ld-particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .ld-particles span {
    position: absolute;
    bottom: -10px;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,1), rgba(255,255,255,.4));
    box-shadow: 0 0 12px rgba(255,255,255,.95);
    animation: ldRise linear infinite;
  }
  @keyframes ldRise {
    from { transform: translateY(0) scale(0); opacity: 0; }
    15%  { opacity: 1; }
    to   { transform: translateY(-120vh) scale(1.1); opacity: 0; }
  }

  /* Badge */
  .ld-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 22px;
    box-shadow: 0 6px 28px -8px rgba(0,0,0,.5);
    position: relative;
    z-index: 2;
  }
  .ld-badge .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 12px #34d399, 0 0 24px #34d399;
    animation: ldPulse 1.6s ease-in-out infinite;
  }
  @keyframes ldPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.55); opacity: .6; }
  }

  /* Headline */
  .ld-hero h1 {
    font-weight: 900;
    font-size: clamp(42px, 7.5vw, 88px);
    margin: 0 0 14px;
    line-height: .94;
    letter-spacing: -.045em;
    text-shadow: 0 10px 40px rgba(0,0,0,.5);
    position: relative;
    z-index: 2;
  }
  .ld-hero h1 .ld-line {
    display: block;
    overflow: hidden;
  }
  .ld-hero h1 .ld-line > span {
    display: inline-block;
    background: linear-gradient(120deg, #fff 20%, #ffd60a 50%, #fff 80%);
    background-size: 220% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: ldShimmer 5s ease-in-out infinite, ldSlideUp .9s cubic-bezier(.2,.9,.3,1.2) backwards;
  }
  .ld-hero h1 .ld-line:nth-child(2) > span { animation-delay: 0s, .15s; }
  @keyframes ldShimmer {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }
  @keyframes ldSlideUp {
    from { transform: translateY(110%); }
    to   { transform: translateY(0); }
  }

  .ld-hero p {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(15px, 1.85vw, 19px);
    line-height: 1.6;
    text-shadow: 0 2px 10px rgba(0,0,0,.45);
    opacity: .97;
    position: relative;
    z-index: 2;
  }

  /* Meta stats row */
  .ld-stats {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 22px;
    position: relative;
    z-index: 2;
  }
  .ld-stat {
    display: flex;
    flex-direction: column;
  }
  .ld-stat b {
    font: 900 22px var(--kz-sans);
    letter-spacing: -.02em;
    line-height: 1;
    text-shadow: 0 2px 10px rgba(0,0,0,.4);
  }
  .ld-stat small {
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .8;
    margin-top: 4px;
    font-weight: 700;
  }

  .ld-hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
    position: relative;
    z-index: 2;
  }

  /* ================= CARDS ================= */
  .ld-card {
    position: relative;
    background: color-mix(in srgb, var(--kz-paper) 82%, transparent);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid var(--kz-line);
    border-radius: 26px;
    padding: 26px;
    height: 100%;
    overflow: hidden;
    box-shadow:
      0 20px 56px -30px rgba(0,0,0,.6),
      0 1px 0 rgba(255,255,255,.65) inset;
    transition: transform .4s cubic-bezier(.2,.9,.3,1.4),
                box-shadow .4s ease,
                border-color .4s ease;
    animation: ldFadeUp .7s cubic-bezier(.2,.9,.3,1.2) backwards;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Gradient border glow */
  .ld-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: linear-gradient(135deg,
      rgba(255,45,85,.55),
      rgba(255,214,10,.4),
      rgba(56,189,248,.5),
      rgba(168,85,247,.5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    z-index: 2;
  }

  /* Mouse spotlight */
  .ld-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255,45,85,.14), transparent 62%);
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }
  .ld-card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 44px 90px -38px rgba(255,45,85,.55),
      0 1px 0 rgba(255,255,255,.65) inset;
  }
  .ld-card:hover::before,
  .ld-card:hover::after { opacity: 1; }

  .ld-card h2 {
    font: 800 21px var(--kz-serif);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: -.02em;
    position: relative;
    z-index: 3;
  }
  .ld-ico {
    display: inline-grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 13px;
    font-size: 18px;
    background: linear-gradient(135deg, rgba(255,45,85,.22), rgba(255,214,10,.28));
    box-shadow:
      0 8px 20px -8px rgba(255,45,85,.7),
      0 0 0 1px rgba(255,45,85,.18) inset;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }
  .ld-ico::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.5) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: ldIconShine 4s ease-in-out infinite;
  }
  @keyframes ldIconShine {
    0%, 70%, 100% { transform: translateX(-120%); }
    85%           { transform: translateX(120%); }
  }

  /* ================= BUTTONS ================= */
  .ld-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 0;
    border-radius: 15px;
    padding: 13px 24px;
    font: 800 14px var(--kz-sans);
    letter-spacing: .02em;
    background: linear-gradient(135deg, #ff2d55 0%, #e11d48 50%, #7f1d1d 100%);
    color: #fff !important;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    box-shadow:
      0 14px 32px -12px rgba(255,45,85,1),
      0 0 0 1px rgba(255,255,255,.12) inset;
    transition: transform .25s cubic-bezier(.2,.9,.3,1.5),
                box-shadow .25s ease,
                filter .25s ease;
    white-space: nowrap;
  }
  .ld-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.5) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform .85s ease;
  }
  .ld-btn:hover {
    transform: translateY(-3px) scale(1.03);
    color: #fff !important;
    filter: brightness(1.1);
    box-shadow:
      0 24px 52px -16px rgba(255,45,85,1),
      0 0 0 1px rgba(255,255,255,.2) inset,
      0 0 60px -10px rgba(255,45,85,.75);
  }
  .ld-btn:hover::before { transform: translateX(120%); }
  .ld-btn:active { transform: translateY(0) scale(.98); }
  .ld-btn:focus-visible {
    outline: 3px solid rgba(255,45,85,.6);
    outline-offset: 3px;
  }

  .ld-btn.alt {
    background: var(--bs-secondary-bg);
    color: var(--bs-body-color) !important;
    box-shadow: 0 0 0 1px var(--kz-line) inset;
  }
  .ld-btn.alt:hover {
    color: var(--bs-body-color) !important;
    box-shadow: 0 0 0 1px rgba(255,45,85,.5) inset, 0 12px 28px -16px rgba(0,0,0,.5);
  }
  .ld-btn.alt::before { display: none; }

  .ld-btn.ghost {
    background: rgba(255,255,255,.14);
    color: #fff !important;
    box-shadow: 0 0 0 1px rgba(255,255,255,.4) inset;
    backdrop-filter: blur(12px);
  }
  .ld-btn.ghost:hover {
    background: rgba(255,255,255,.24);
    box-shadow: 0 0 0 1px rgba(255,255,255,.6) inset, 0 14px 34px -16px rgba(0,0,0,.55);
  }
  .ld-btn.ghost::before { display: none; }

  /* ================= PLAYER PICKER ================= */
  .ld-opts {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
  }
  .ld-opts label { cursor: pointer; flex: 1; position: relative; }
  .ld-opts input { position: absolute; opacity: 0; pointer-events: none; }
  .ld-opts span {
    display: block;
    text-align: center;
    padding: 16px 0;
    border-radius: 16px;
    border: 2px solid var(--kz-line);
    font-weight: 900;
    font-size: 21px;
    background: var(--kz-paper);
    transition: all .28s cubic-bezier(.2,.9,.3,1.5);
    position: relative;
    overflow: hidden;
  }
  .ld-opts span::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,45,85,.2), rgba(255,214,10,.22));
    opacity: 0;
    transition: opacity .28s ease;
  }
  .ld-opts span::after {
    content: "👥";
    position: absolute;
    top: 4px; right: 8px;
    font-size: 12px;
    opacity: 0;
    transition: opacity .28s ease;
  }
  .ld-opts label:hover span {
    border-color: rgba(255,45,85,.65);
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -16px rgba(255,45,85,.7);
  }
  .ld-opts input:checked + span {
    border-color: #ff2d55;
    color: #7f1d1d;
    transform: translateY(-3px) scale(1.04);
    box-shadow:
      0 18px 38px -14px rgba(255,45,85,.9),
      0 0 0 5px rgba(255,45,85,.15);
  }
  .ld-opts input:checked + span::before { opacity: 1; }
  .ld-opts input:checked + span::after { opacity: 1; }
  .ld-opts input:focus-visible + span {
    outline: 3px solid rgba(255,45,85,.5);
    outline-offset: 3px;
  }

  /* ================= ROWS ================= */
  .ld-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px dashed var(--kz-line);
    transition: background .2s ease, padding .2s ease, transform .2s ease;
    border-radius: 12px;
    position: relative;
    z-index: 3;
  }
  .ld-row:last-child { border-bottom: 0; }
  .ld-row:hover {
    background: rgba(255,45,85,.06);
    padding-left: 12px;
    padding-right: 12px;
    transform: translateX(2px);
  }
  .ld-row small { color: var(--kz-muted); }

  .ld-code {
    display: inline-block;
    font: 900 15px/1 ui-monospace, "SF Mono", monospace;
    letter-spacing: .18em;
    background: linear-gradient(135deg, rgba(255,45,85,.18), rgba(255,214,10,.22));
    color: #7f1d1d;
    padding: 8px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255,45,85,.35);
    box-shadow: 0 8px 20px -10px rgba(255,45,85,.6);
    position: relative;
    overflow: hidden;
  }
  .ld-code::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.5) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: ldIconShine 3.5s ease-in-out infinite;
  }

  /* ================= ALERTS ================= */
  .ld-msg {
    border-radius: 18px;
    padding: 16px 22px;
    margin-top: 20px;
    background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    color: #14532d;
    font-weight: 700;
    border: 1px solid #86efac;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 14px 36px -16px rgba(52,211,153,.8);
    animation: ldSlideIn .45s cubic-bezier(.2,.9,.3,1.4);
  }
  .ld-msg.err {
    background: linear-gradient(135deg, #fee2e2, #fecaca);
    color: #7f1d1d;
    border-color: #fca5a5;
    box-shadow: 0 14px 36px -16px rgba(255,45,85,.8);
  }
  @keyframes ldSlideIn {
    from { opacity: 0; transform: translateY(-12px) scale(.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ================= INPUT ================= */
  .ld input[type=text] {
    text-transform: uppercase;
    letter-spacing: .22em;
    font-weight: 900;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 16px;
    border-radius: 15px;
    border: 2px solid var(--kz-line);
    padding: 13px 18px;
    background: var(--kz-paper);
    transition: all .28s ease;
  }
  .ld input[type=text]::placeholder {
    color: var(--kz-muted);
    letter-spacing: .32em;
    font-weight: 700;
    opacity: .5;
  }
  .ld input[type=text]:focus {
    border-color: #ff2d55;
    box-shadow:
      0 0 0 5px rgba(255,45,85,.18),
      0 16px 40px -18px rgba(255,45,85,.7);
    outline: none;
    transform: translateY(-2px);
  }

  /* ================= STEPS ================= */
  .ld-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    gap: 18px;
  }
  .ld-step {
    position: relative;
    display: flex;
    gap: 15px;
    padding: 20px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--bs-secondary-bg), transparent);
    border: 1px solid var(--kz-line);
    overflow: hidden;
    transition: transform .32s cubic-bezier(.2,.9,.3,1.4),
                border-color .32s ease,
                box-shadow .32s ease;
    z-index: 3;
  }
  .ld-step::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 3px;
    background: linear-gradient(90deg, #ff2d55, #ffd60a, #34d399, #38bdf8);
    background-size: 300% 100%;
    animation: ldGradient 6s ease infinite;
    opacity: 0;
    transition: opacity .35s ease;
  }
  .ld-step:hover {
    transform: translateY(-6px);
    border-color: rgba(255,45,85,.45);
    box-shadow: 0 24px 50px -26px rgba(255,45,85,.65);
  }
  .ld-step:hover::before { opacity: 1; }
  .ld-step-num {
    flex: 0 0 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg, #ff2d55, #7f1d1d);
    color: #fff;
    font-weight: 900;
    font-size: 18px;
    box-shadow: 0 12px 28px -12px rgba(255,45,85,1);
    transition: transform .32s cubic-bezier(.2,.9,.3,1.5);
  }
  .ld-step:hover .ld-step-num { transform: rotate(-8deg) scale(1.08); }
  .ld-step p { margin: 0; font-size: 14px; line-height: 1.55; }

  /* ================= LEADERBOARD ================= */
  .ld-rank {
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: 14px;
    font-weight: 900;
    font-size: 16px;
    background: var(--bs-secondary-bg);
    border: 1px solid var(--kz-line);
    flex-shrink: 0;
    transition: transform .3s cubic-bezier(.2,.9,.3,1.5);
    position: relative;
  }
  .ld-row:hover .ld-rank { transform: scale(1.12) rotate(-6deg); }
  .ld-rank.gold {
    background: linear-gradient(135deg, #fde68a, #f59e0b);
    color: #7c2d12;
    border-color: transparent;
    box-shadow: 0 12px 30px -12px rgba(245,158,11,1), 0 0 40px -8px rgba(245,158,11,.8);
  }
  .ld-rank.gold::after {
    content: "👑";
    position: absolute;
    top: -10px; right: -8px;
    font-size: 16px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,.3));
  }
  .ld-rank.silver {
    background: linear-gradient(135deg, #e2e8f0, #94a3b8);
    color: #1e293b;
    border-color: transparent;
    box-shadow: 0 12px 30px -12px rgba(148,163,184,1);
  }
  .ld-rank.bronze {
    background: linear-gradient(135deg, #fdba74, #c2410c);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 12px 30px -12px rgba(194,65,12,1);
  }
  .ld-wins {
    font: 900 20px var(--kz-sans);
    background: linear-gradient(135deg, #ff2d55, #f59e0b);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ================= EMPTY ================= */
  .ld-empty { text-align: center; padding: 40px 16px; }
  .ld-empty .emoji {
    font-size: 60px;
    display: block;
    margin-bottom: 12px;
    filter: grayscale(.15) drop-shadow(0 8px 20px rgba(0,0,0,.15));
    animation: ldBob 3.2s ease-in-out infinite;
  }
  @keyframes ldBob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(4deg); }
  }

  .ld-label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--kz-muted);
    margin-bottom: 10px;
  }

  /* Entrance stagger */
  .row > div:nth-child(1) .ld-card { animation-delay: .05s; }
  .row > div:nth-child(2) .ld-card { animation-delay: .12s; }
  .row > div:nth-child(3) .ld-card { animation-delay: .19s; }
  .row > div:nth-child(4) .ld-card { animation-delay: .26s; }
  .row > div:nth-child(5) .ld-card { animation-delay: .33s; }

  @keyframes ldFadeUp {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .ld-hero, .ld-hero::after, .ld-dice, .ld-blob, .ld-badge .dot,
    .ld-card, .ld-btn, .ld-opts span, .ld-step::before, .ld-empty .emoji,
    .ld-hero h1 .ld-line > span, .ld-ico::after, .ld-code::after,
    .ld-particles span { animation: none !important; transition: none !important; }
    .ld-btn::before { display: none; }
  }
</style>

<!-- ================= BACKGROUND ================= -->
<div class="ld-bg" aria-hidden="true">
  <div class="ld-blob b1"></div>
  <div class="ld-blob b2"></div>
  <div class="ld-blob b3"></div>
  <div class="ld-blob b4"></div>
</div>
<div class="ld-grain" aria-hidden="true"></div>

<main class="ld container py-4 py-lg-5" itemscope itemtype="https://schema.org/WebPage">

  <!-- ================= HERO ================= -->
  <section class="ld-hero mb-4 mb-lg-5" aria-labelledby="ld-title">
    <div class="ld-particles" aria-hidden="true">
      <span style="left:6%;  animation-duration:10s; animation-delay:0s;"></span>
      <span style="left:18%; animation-duration:13s; animation-delay:2s;"></span>
      <span style="left:32%; animation-duration:11s; animation-delay:4s;"></span>
      <span style="left:48%; animation-duration:14s; animation-delay:1s;"></span>
      <span style="left:62%; animation-duration:12s; animation-delay:3s;"></span>
      <span style="left:76%; animation-duration:15s; animation-delay:5s;"></span>
      <span style="left:88%; animation-duration:10s; animation-delay:6s;"></span>
      <span style="left:94%; animation-duration:13s; animation-delay:7s;"></span>
    </div>

    <span class="ld-dice d1" aria-hidden="true">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="d1g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#ffd60a"/>
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="56" height="56" rx="13" fill="url(#d1g)" stroke="#0f0f1a" stroke-width="3"/>
        <circle cx="20" cy="20" r="5" fill="#0f0f1a"/>
        <circle cx="44" cy="20" r="5" fill="#0f0f1a"/>
        <circle cx="20" cy="44" r="5" fill="#0f0f1a"/>
        <circle cx="44" cy="44" r="5" fill="#0f0f1a"/>
      </svg>
    </span>
    <span class="ld-dice d2" aria-hidden="true">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="d2g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffd60a"/><stop offset="1" stop-color="#f59e0b"/>
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="56" height="56" rx="13" fill="url(#d2g)" stroke="#0f0f1a" stroke-width="3"/>
        <circle cx="20" cy="20" r="5" fill="#0f0f1a"/>
        <circle cx="32" cy="32" r="5" fill="#0f0f1a"/>
        <circle cx="44" cy="44" r="5" fill="#0f0f1a"/>
      </svg>
    </span>
    <span class="ld-dice d3" aria-hidden="true">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="4" width="56" height="56" rx="13" fill="#34d399" stroke="#0f0f1a" stroke-width="3"/>
        <circle cx="32" cy="32" r="5" fill="#0f0f1a"/>
      </svg>
    </span>
    <span class="ld-dice d4" aria-hidden="true">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="4" width="56" height="56" rx="13" fill="#38bdf8" stroke="#0f0f1a" stroke-width="3"/>
        <circle cx="20" cy="20" r="5" fill="#fff"/>
        <circle cx="32" cy="32" r="5" fill="#fff"/>
        <circle cx="44" cy="44" r="5" fill="#fff"/>
      </svg>
    </span>

    <span class="ld-badge"><span class="dot" aria-hidden="true"></span> Live • Multiplayer</span>

    <h1 id="ld-title">
      <span class="ld-line"><span>Play Ludo</span></span>
      <span class="ld-line"><span>with Friends</span></span>
    </h1>

    <p itemprop="description">Roll the dice, capture tokens, and race home. Ludo Royale brings classic board-game magic to your phone — create a room, share the code, and play in real time. Empty seats fill with bots instantly.</p>

    <div class="ld-stats">
      <div class="ld-stat"><b data-count="4">0</b><small>Players max</small></div>
      <div class="ld-stat"><b data-count="2">0</b><small>Min to start</small></div>
      <div class="ld-stat"><b data-count="30">0</b><small>Sec per move</small></div>
      <div class="ld-stat"><b data-count="100">0</b><small>% Free</small></div>
    </div>

    <div class="ld-hero-cta">
      <% if (user) { %>
        <a href="#create" class="ld-btn">🎲 Create a room</a>
        <a href="#join" class="ld-btn ghost">🔑 Join with code</a>
      <% } else { %>
        <a href="/login" class="ld-btn">🚀 Log in to play</a>
      <% } %>
    </div>
  </section>

  <!-- ================= ALERTS ================= -->
  <% if (locals.err) { %>
    <div class="ld-msg err" role="alert" aria-live="assertive">⚠️ <span><%= err %></span></div>
  <% } %>
  <% if (locals.ok) { %>
    <div class="ld-msg" role="status" aria-live="polite">✅ <span><%= ok %></span></div>
  <% } %>

  <div class="row g-4 mt-2">

    <!-- ================= CREATE ================= -->
    <div class="col-lg-6" id="create">
      <article class="ld-card">
        <h2><span class="ld-ico" aria-hidden="true">➕</span> Create a room</h2>
        <% if (user) { %>
          <form method="post" action="/ludo/new" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ld-label" id="ldPlayersLabel">Players</div>
            <div class="ld-opts" role="radiogroup" aria-labelledby="ldPlayersLabel">
              <label><input type="radio" name="max" value="2" aria-label="2 players"><span>2</span></label>
              <label><input type="radio" name="max" value="3" aria-label="3 players"><span>3</span></label>
              <label><input type="radio" name="max" value="4" checked aria-label="4 players"><span>4</span></label>
            </div>
            <div class="form-check form-switch mb-4">
              <input class="form-check-input" type="checkbox" name="visibility" value="public" id="ldPub" role="switch">
              <label class="form-check-label ms-2 small fw-semibold" for="ldPub">
                Show in open rooms list <span class="text-secondary">(anyone can join)</span>
              </label>
            </div>
            <button class="ld-btn w-100" type="submit">🎲 Create room</button>
          </form>
        <% } else { %>
          <p class="text-secondary mb-3">Log in to create a room and invite your friends.</p>
          <a class="ld-btn" href="/login">Log in</a>
        <% } %>
      </article>
    </div>

    <!-- ================= JOIN ================= -->
    <div class="col-lg-6" id="join">
      <article class="ld-card">
        <h2><span class="ld-ico" aria-hidden="true">🔑</span> Join with a code</h2>
        <% if (user) { %>
          <form method="post" action="/ludo/join" class="d-flex gap-2" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="visually-hidden" for="ldCode">Room code</label>
            <input class="form-control" type="text" id="ldCode" name="code" maxlength="8" placeholder="K7M2P" autocomplete="off" required aria-required="true">
            <button class="ld-btn" type="submit">Join</button>
          </form>
        <% } else { %>
          <p class="text-secondary mb-0 small">Log in, then enter the 5-letter room code your friend sent you.</p>
        <% } %>

        <% if (mine.length) { %>
          <h2 class="mt-4"><span class="ld-ico" aria-hidden="true">🎮</span> Your games</h2>
          <ul class="list-unstyled mb-0">
            <% mine.forEach(g => { %>
              <li class="ld-row">
                <div>
                  <span class="ld-code"><%= g.code %></span>
                  <small class="ms-2">
                    <%= g.status === 'playing' ? 'In progress' : 'Waiting (' + g.n + '/' + g.max_players + ')' %>
                  </small>
                </div>
                <a class="ld-btn" href="/ludo/<%= g.code %>" aria-label="Open room <%= g.code %>">
                  <%= g.status === 'playing' ? '▶ Continue' : 'Open' %>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </article>
    </div>

    <!-- ================= OPEN ================= -->
    <div class="col-lg-6">
      <article class="ld-card">
        <h2><span class="ld-ico" aria-hidden="true">🌐</span> Open rooms</h2>
        <% if (!open.length) { %>
          <div class="ld-empty">
            <span class="emoji" aria-hidden="true">📭</span>
            <p class="mb-0 text-secondary small">No open rooms right now.<br>Create one and tick <b>"open rooms list"</b>.</p>
          </div>
        <% } %>
        <ul class="list-unstyled mb-0">
          <% open.forEach(g => { %>
            <li class="ld-row">
              <div>
                <b><%= g.host %></b>'s room
                <small class="ms-1"><%= g.n %>/<%= g.max_players %> players</small>
              </div>
              <% if (user) { %>
                <a class="ld-btn" href="/ludo/<%= g.code %>?join=1">Join →</a>
              <% } else { %>
                <a class="ld-btn alt" href="/login">Log in</a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </article>
    </div>

    <!-- ================= TOP ================= -->
    <div class="col-lg-6">
      <article class="ld-card">
        <h2><span class="ld-ico" aria-hidden="true">🏆</span> Top players</h2>
        <% if (!top.length) { %>
          <div class="ld-empty">
            <span class="emoji" aria-hidden="true">🎖️</span>
            <p class="mb-0 text-secondary small">No finished games yet.<br>Wins are counted in games with at least 2 real players.</p>
          </div>
        <% } %>
        <ol class="list-unstyled mb-0">
          <% top.forEach((t, i) => { %>
            <li class="ld-row">
              <div class="d-flex align-items-center gap-3">
                <span class="ld-rank <%= i === 0 ? 'gold' : i === 1 ? 'silver' : i === 2 ? 'bronze' : '' %>" aria-hidden="true">
                  <%= i + 1 %>
                </span>
                <b><%= t.username %></b>
              </div>
              <div class="text-end">
                <span class="ld-wins"><%= t.won %></span>
                <small class="d-block">wins / <%= t.played %> games</small>
              </div>
            </li>
          <% }) %>
        </ol>
      </article>
    </div>

    <!-- ================= HOW TO PLAY ================= -->
    <div class="col-12">
      <article class="ld-card">
        <h2><span class="ld-ico" aria-hidden="true">📖</span> How to play Ludo</h2>
        <div class="ld-steps">
          <div class="ld-step">
            <div class="ld-step-num" aria-hidden="true">1</div>
            <p>Roll a <b>6</b> to bring a token out. A 6 (or a capture, or reaching home) gives you another roll. Three 6s in a row cancel your turn.</p>
          </div>
          <div class="ld-step">
            <div class="ld-step-num" aria-hidden="true">2</div>
            <p>Move clockwise. Land on an opponent's token to send it home — unless it's on a <b>safe cell</b> (coloured starts and ★ cells).</p>
          </div>
          <div class="ld-step">
            <div class="ld-step-num" aria-hidden="true">3</div>
            <p>You need the <b>exact number</b> to reach the centre. First to bring all 4 tokens home wins.</p>
          </div>
          <div class="ld-step">
            <div class="ld-step-num" aria-hidden="true">4</div>
            <p><b>30 seconds</b> per move. Skip 3 turns and a bot takes over your seat automatically.</p>
          </div>
        </div>
      </article>
    </div>

  </div>

  <!-- ================= SEO CONTENT ================= -->
  <section class="visually-hidden" aria-hidden="false">
    <h2>Play Ludo Online with Friends — Free Multiplayer Board Game</h2>
    <p>Ludo Royale is a free online Ludo game that lets you play with friends on different phones. Create a private room, share the 5-letter code over WhatsApp, and start playing instantly. You can also join an open room or let bots fill empty seats. Supports 2, 3, or 4 players with a real-time multiplayer engine, safe cells, capture rules, and a live leaderboard.</p>
    <p>Our Ludo board game follows classic rules: roll a 6 to bring a token out, move clockwise, capture opponents on unsafe cells, and reach the centre with the exact number. Skip three turns and a bot takes over your seat so the game never stalls.</p>
    <h3>Frequently asked questions</h3>
    <dl>
      <dt>How do I play Ludo online with friends?</dt>
      <dd>Create a room, share the 5-letter code on WhatsApp, and start playing. Empty seats fill with bots automatically.</dd>
      <dt>How many players can play Ludo together?</dt>
      <dd>2, 3, or 4 players. Bots can fill empty seats so you can start right away.</dd>
      <dt>Is Ludo Royale free?</dt>
      <dd>Yes, Ludo Royale is completely free to play online with friends.</dd>
      <dt>What happens if a player leaves?</dt>
      <dd>After 3 missed turns, a bot automatically takes over their seat.</dd>
    </dl>
  </section>

</main>

<!-- ================= INTERACTIONS ================= -->
<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    /* --- 1. Card 3D tilt + spotlight --- */
    document.querySelectorAll('.ld-card').forEach(function (card) {
      card.addEventListener('mousemove', function (e) {
        var r = card.getBoundingClientRect();
        var x = (e.clientX - r.left) / r.width;
        var y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', (x * 100) + '%');
        card.style.setProperty('--my', (y * 100) + '%');
        var rx = (y - .5) * 6;
        var ry = (x - .5) * -6;
        card.style.transform = 'translateY(-8px) perspective(900px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
      });
      card.addEventListener('mouseleave', function () {
        card.style.transform = '';
      });
    });

    /* --- 2. Animated counters in hero stats --- */
    var counters = document.querySelectorAll('.ld-stat b[data-count]');
    var seen = new WeakSet();
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !seen.has(entry.target)) {
          seen.add(entry.target);
          var el = entry.target;
          var target = parseInt(el.getAttribute('data-count'), 10) || 0;
          var start = performance.now();
          var dur = 1400;
          function tick(now) {
            var p = Math.min((now - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(eased * target);
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }
      });
    }, { threshold: .4 });
    counters.forEach(function (c) { io.observe(c); });

    /* --- 3. Auto-uppercase + strip room code input --- */
    var codeInput = document.getElementById('ldCode');
    if (codeInput) {
      codeInput.addEventListener('input', function () {
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8);
      });
    }
  })();
</script>

