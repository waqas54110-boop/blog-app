<%- include('partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <h2 class="mb-0">📊 Analytics</h2>
  <div class="btn-group">
    <% [7, 30, 90].forEach(d => { %>
      <a href="/analytics?days=<%= d %>" class="btn btn-sm <%= d === days ? 'btn-primary' : 'btn-outline-primary' %>">Last <%= d %> days</a>
    <% }) %>
  </div>
</div>

<div class="row g-3 mb-4">
  <% [
    ['Total visits', totals.visits, 'text-primary'],
    ['From WhatsApp', totals.whatsapp, 'text-success'],
    ['From Facebook', totals.facebook, 'text-primary'],
    ['From Google/Bing', totals.search, 'text-warning'],
    ['From newsletter', totals.newsletter, 'text-info']
  ].forEach(s => { %>
    <div class="col-6 col-lg">
      <div class="card border-0 shadow-sm text-center"><div class="card-body">
        <div class="display-6 fw-bold <%= s[2] %>"><%= s[1] %></div>
        <div class="text-body-secondary small"><%= s[0] %></div>
      </div></div>
    </div>
  <% }) %>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <h5 class="mb-3">Daily visits</h5>
    <div style="height:280px;"><canvas id="dailyChart"></canvas></div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <h5 class="mb-3">Traffic sources</h5>
      <% if (sources.length === 0) { %>
        <p class="text-body-secondary mb-0">Abhi data nahi hai. Post share karein aur visits aane do.</p>
      <% } else { %>
        <table class="table table-sm align-middle mb-0">
          <tbody>
            <% const max = Math.max(...sources.map(s => s.visits)); %>
            <% sources.forEach(s => { %>
              <tr>
                <td style="width:30%"><%= s.source %></td>
                <td>
                  <div class="progress" style="height:10px;"><div class="progress-bar" style="width:<%= Math.round(s.visits / max * 100) %>%"></div></div>
                </td>
                <td class="text-end fw-semibold"><%= s.visits %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div></div>
  </div>

  <div class="col-lg-6">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <h5 class="mb-3">Group / share / newsletter</h5>
      <% if (mediums.length === 0) { %>
        <p class="text-body-secondary mb-0">
          Jab aap dashboard se "Copy WhatsApp msg" ya share buttons use karenge to yahan
          <code>group</code> aur <code>share</code> ke visits alag alag dikhenge.
        </p>
      <% } else { %>
        <table class="table table-sm mb-0">
          <thead><tr><th>Source</th><th>Medium</th><th class="text-end">Visits</th></tr></thead>
          <tbody>
            <% mediums.forEach(m => { %>
              <tr><td><%= m.source %></td><td><%= m.medium %></td><td class="text-end"><%= m.visits %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div></div>
  </div>

  <div class="col-lg-8">
    <div class="card border-0 shadow-sm"><div class="card-body">
      <h5 class="mb-3">Top posts</h5>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>Post</th><th class="text-end">Visits</th><th class="text-end">WhatsApp</th><th class="text-end">Facebook</th></tr></thead>
          <tbody>
            <% if (topPosts.length === 0) { %><tr><td colspan="4" class="text-body-secondary">No data yet.</td></tr><% } %>
            <% topPosts.forEach(p => { %>
              <tr>
                <td><a href="/posts/<%= p.slug %>" class="text-decoration-none"><%= p.title %></a></td>
                <td class="text-end fw-semibold"><%= p.visits %></td>
                <td class="text-end"><%= p.whatsapp %></td>
                <td class="text-end"><%= p.facebook %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div></div>
  </div>

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <h5 class="mb-3">Top referrers</h5>
      <% if (referrers.length === 0) { %>
        <p class="text-body-secondary mb-0">No external referrers yet.</p>
      <% } %>
      <ul class="list-unstyled mb-0">
        <% referrers.forEach(r => { %>
          <li class="d-flex justify-content-between border-bottom py-1"><span class="text-truncate me-2"><%= r.referrer %></span><strong><%= r.visits %></strong></li>
        <% }) %>
      </ul>
    </div></div>
  </div>
</div>

<p class="text-body-secondary small mt-4">
  Note: WhatsApp aur Facebook ki in-app browser aksar referrer chhupa deti hain, is liye group ke traffic ki
  sahi pehchan <code>?utm_source=</code> wale links se hoti hai (share buttons aur "Copy msg" buttons yehi lagate hain).
  Bots aur aap (admin) ke visits count nahi hote.
</p>

<% if (locals.audience) { const au = audience, at = au.totals; %>
<style>
  .aud-card { border: 0; border-radius: 1rem; box-shadow: 0 2px 14px rgba(79,70,229,.08); }
  .aud-stat { border-radius: 1rem; color: #fff; padding: 1.1rem 1.2rem; height: 100%; position: relative; overflow: hidden; }
  .aud-stat::after { content: ''; position: absolute; right: -22px; top: -22px; width: 90px; height: 90px; border-radius: 50%; background: rgba(255,255,255,.14); }
  .aud-stat .num { font-size: 2rem; font-weight: 800; line-height: 1.1; }
  .aud-stat .lbl { font-size: .82rem; opacity: .9; }
  .g1 { background: linear-gradient(135deg,#4f46e5,#7c3aed); } .g2 { background: linear-gradient(135deg,#ec4899,#f43f5e); }
  .g3 { background: linear-gradient(135deg,#0ea5e9,#14b8a6); } .g4 { background: linear-gradient(135deg,#f59e0b,#f97316); }
  .aud-title { font-weight: 700; display: flex; align-items: center; gap: .5rem; }
  .aud-sub { font-size: .8rem; color: var(--bs-secondary-color); font-weight: 400; }
  .country-row { display: flex; align-items: center; gap: .6rem; padding: .35rem 0; }
  .country-row .flag { font-size: 1.4rem; width: 2rem; text-align: center; }
  .country-row .bar { flex: 1; height: 10px; border-radius: 99px; background: var(--bs-tertiary-bg); overflow: hidden; }
  .country-row .bar > span { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg,#4f46e5,#ec4899); }
  .pill { display: inline-block; padding: .1rem .55rem; border-radius: 99px; font-size: .75rem; font-weight: 600; }
  .pill.male { background: rgba(79,70,229,.14); color: #4f46e5; } .pill.female { background: rgba(236,72,153,.14); color: #db2777; }
  .pill.other { background: rgba(20,184,166,.16); color: #0f766e; } .pill.unknown { background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); }
  .click-badge { background: linear-gradient(135deg,#4f46e5,#ec4899); color: #fff; border-radius: 99px; padding: .15rem .7rem; font-weight: 700; }
</style>

<h4 class="mt-5 mb-3">👥 Audience <small class="text-body-secondary fs-6">(last <%= days %> days)</small></h4>

<div class="row g-3 mb-3">
  <% [
    ['Total clicks', at.clicks, 'g1', '🖱️'],
    ['Unique people', at.people, 'g2', '🧑'],
    ['Avg clicks / person', at.avg, 'g3', '🔁'],
    ['Came back (2+ clicks)', at.returning, 'g4', '⭐']
  ].forEach(c => { %>
    <div class="col-6 col-lg-3">
      <div class="aud-stat <%= c[2] %>">
        <div class="lbl"><%= c[3] %> <%= c[0] %></div>
        <div class="num"><%= c[1] %></div>
      </div>
    </div>
  <% }) %>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-7">
    <div class="card aud-card h-100"><div class="card-body">
      <div class="aud-title mb-1">🎂 Clicks by age group <span class="aud-sub">only members who added their birth year</span></div>
      <div style="height:260px;"><canvas id="ageChart"></canvas></div>
    </div></div>
  </div>
  <div class="col-lg-5">
    <div class="card aud-card h-100"><div class="card-body">
      <div class="aud-title mb-1">⚧ Gender <span class="aud-sub">clicks</span></div>
      <div style="height:260px;"><canvas id="genderChart"></canvas></div>
    </div></div>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-6">
    <div class="card aud-card h-100"><div class="card-body">
      <div class="aud-title mb-2">🌍 Clicks by country</div>
      <% if (au.countries.length === 0) { %>
        <p class="text-body-secondary mb-0">Abhi country ka data nahi. Members apni country profile mein daalen, ya hosting (Cloudflare etc.) se country header aaye.</p>
      <% } else { const cmax = Math.max(...au.countries.map(c => c.clicks)); %>
        <% au.countries.forEach(c => { %>
          <div class="country-row">
            <span class="flag"><%= c.flag %></span>
            <span style="width:8.5rem" class="text-truncate"><%= c.name %></span>
            <span class="bar"><span style="width:<%= Math.max(4, Math.round(c.clicks / cmax * 100)) %>%"></span></span>
            <span class="fw-bold text-end" style="width:3rem"><%= c.clicks %></span>
          </div>
        <% }) %>
        <div class="aud-sub mt-2">Country mili: <%= at.countryPct %>% clicks mein.</div>
      <% } %>
    </div></div>
  </div>
  <div class="col-lg-6">
    <div class="card aud-card h-100"><div class="card-body">
      <div class="aud-title mb-1">🔁 Ek banda kitni bar click karta hai? <span class="aud-sub">people</span></div>
      <div style="height:260px;"><canvas id="repeatChart"></canvas></div>
    </div></div>
  </div>
</div>

<div class="card aud-card mb-4"><div class="card-body">
  <div class="aud-title mb-3">🏆 Most active visitors <span class="aud-sub">who clicked the most</span></div>
  <% if (au.top.length === 0) { %>
    <p class="text-body-secondary mb-0">No data yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th>#</th><th>Visitor</th><th>Country</th><th>Gender</th><th>Age</th><th class="text-end">Posts</th><th class="text-end">Clicks</th><th class="text-end">Last seen</th></tr></thead>
        <tbody>
          <% au.top.forEach((v, i) => { %>
            <tr>
              <td class="text-body-secondary"><%= i + 1 %></td>
              <td>
                <% if (v.member) { %><a class="text-decoration-none fw-semibold" href="/u/<%= encodeURIComponent(v.who) %>"><%= v.who %></a> <span class="pill unknown">member</span>
                <% } else { %><span class="text-body-secondary"><%= v.who %></span><% } %>
              </td>
              <td><%= v.flag %> <%= v.countryName %></td>
              <td><span class="pill <%= v.gender || 'unknown' %>"><%= v.gender || 'unknown' %></span></td>
              <td><%= v.age_group || '-' %></td>
              <td class="text-end"><%= v.posts %></td>
              <td class="text-end"><span class="click-badge"><%= v.clicks %></span></td>
              <td class="text-end text-body-secondary small"><%= new Date(v.last_seen).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <p class="text-body-secondary small mt-3 mb-0">
    Login wale banda ek hi count hota hai (kisi bhi device se); guest browser cookie se pehchana jata hai. Age / gender sirf un members ki dikhti hai jinhon ne profile mein bhari hai, baaqi "Unknown".
  </p>
</div></div>
<% } %>

<% if (locals.pollStats) { const ps = pollStats, pt = ps.totals; %>
  <h4 class="mt-5 mb-3">🗳️ Vote contests <small class="text-body-secondary fs-6">(last <%= days %> days)</small></h4>

  <div class="row g-3 mb-3">
    <% [
      ['Contest opens', pt.opens, 'text-primary'],
      ['People (unique)', pt.people, 'text-info'],
      ['Votes cast', pt.votes, 'text-success'],
      ['Opened from WhatsApp', pt.wa_opens, 'text-success'],
      ['Voted from WhatsApp', pt.wa_votes, 'text-success'],
      ['Share clicks', pt.shares, 'text-warning']
    ].forEach(s => { %>
      <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
          <div class="h2 fw-bold mb-0 <%= s[2] %>"><%= s[1] %></div>
          <div class="text-body-secondary small"><%= s[0] %></div>
        </div></div>
      </div>
    <% }) %>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <h6 class="fw-bold mb-3">Per contest</h6>
      <% if (ps.polls.length === 0) { %>
        <p class="text-body-secondary mb-0">No contest activity in this period yet.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>Contest</th><th class="text-end">Opened</th><th class="text-end">People</th><th class="text-end">Voted</th>
                <th class="text-end">Vote rate</th><th class="text-end">From WhatsApp (open / vote)</th><th class="text-end">Shares</th>
              </tr>
            </thead>
            <tbody>
              <% ps.polls.forEach(r => { %>
                <tr>
                  <td>
                    <a href="/votes/<%= r.id %>" class="text-decoration-none"><%= r.title %></a>
                    <% if (r.kind === 'knockout') { %><span class="badge text-bg-warning ms-1">Knockout</span><% } %>
                    <% if (r.in_post > 0) { %><span class="badge text-bg-light border ms-1" title="Widget views inside blog posts"><%= r.in_post %> in posts</span><% } %>
                  </td>
                  <td class="text-end"><%= r.opens %></td>
                  <td class="text-end"><%= r.people %></td>
                  <td class="text-end fw-semibold"><%= r.votes %></td>
                  <td class="text-end"><%= r.people ? Math.min(100, Math.round(r.votes * 100 / r.people)) + '%' : '-' %></td>
                  <td class="text-end"><span class="text-success fw-semibold"><%= r.wa_opens %></span> / <span class="text-success fw-semibold"><%= r.wa_votes %></span></td>
                  <td class="text-end"><%= r.shares %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <% if (ps.sources.length) { %>
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body">
        <h6 class="fw-bold mb-3">Where contest traffic and votes come from</h6>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead><tr><th>Source</th><th class="text-end">Opened</th><th class="text-end">Voted</th></tr></thead>
            <tbody>
              <% ps.sources.forEach(s => { %>
                <tr><td><%= s.source %></td><td class="text-end"><%= s.opens %></td><td class="text-end"><%= s.votes %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
  <p class="text-body-secondary small">
    "Opened" = contest page or post widget loaded. "People" = unique browsers (cookie). "Voted from WhatsApp" = voters whose contest link came from a WhatsApp share
    (share buttons add <code>?utm_source=whatsapp</code>). Bots and admin visits are not counted.
  </p>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
  const daily = <%- JSON.stringify(daily).replace(/</g, '\\u003c') %>;
  const themeColors = () => {
    const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
    return { text: dark ? '#adb5bd' : '#6c757d', grid: dark ? 'rgba(255,255,255,.1)' : 'rgba(0,0,0,.08)' };
  };
  const dailyChart = new Chart(document.getElementById('dailyChart'), {
    type: 'line',
    data: {
      labels: daily.map(d => d.label),
      datasets: [{
        label: 'Visits',
        data: daily.map(d => d.visits),
        borderColor: '#4f46e5',
        backgroundColor: 'rgba(79,70,229,.15)',
        fill: true,
        tension: .3,
        pointRadius: daily.length > 40 ? 0 : 3,
      }],
    },
    options: {
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { ticks: { maxTicksLimit: 10 } } },
    },
  });
  // Dark/light badalne par chart ke rang bhi badlein
  const paintChart = () => {
    const c = themeColors();
    dailyChart.options.scales.x.ticks.color = c.text;
    dailyChart.options.scales.y.ticks.color = c.text;
    dailyChart.options.scales.x.grid = { color: c.grid };
    dailyChart.options.scales.y.grid = { color: c.grid };
    dailyChart.update();
  };
  document.addEventListener('themechange', paintChart);
  paintChart();
</script>

<% if (locals.audience) { %>
<script>
  (function () {
    const au = <%- JSON.stringify(audience).replace(/</g, '\\u003c') %>;
    const dark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark';
    const txt = () => (dark() ? '#adb5bd' : '#6c757d');
    const grid = () => (dark() ? 'rgba(255,255,255,.1)' : 'rgba(0,0,0,.06)');
    const charts = [];
    const axes = () => ({
      y: { beginAtZero: true, ticks: { precision: 0, color: txt() }, grid: { color: grid() } },
      x: { ticks: { color: txt() }, grid: { display: false } },
    });

    charts.push(new Chart(document.getElementById('ageChart'), {
      type: 'bar',
      data: {
        labels: au.ages.map(a => a.label),
        datasets: [{
          label: 'Clicks',
          data: au.ages.map(a => a.clicks),
          backgroundColor: ['#4f46e5', '#7c3aed', '#ec4899', '#f59e0b', '#14b8a6', '#0ea5e9', '#94a3b8'],
          borderRadius: 10, maxBarThickness: 46,
        }],
      },
      options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: axes() },
    }));

    const gcol = { male: '#4f46e5', female: '#ec4899', other: '#14b8a6', unknown: '#94a3b8' };
    charts.push(new Chart(document.getElementById('genderChart'), {
      type: 'doughnut',
      data: {
        labels: au.genders.map(g => g.label.charAt(0).toUpperCase() + g.label.slice(1)),
        datasets: [{ data: au.genders.map(g => g.clicks), backgroundColor: au.genders.map(g => gcol[g.label] || '#94a3b8'), borderWidth: 0 }],
      },
      options: { maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'bottom', labels: { color: txt(), usePointStyle: true } } } },
    }));

    charts.push(new Chart(document.getElementById('repeatChart'), {
      type: 'bar',
      data: {
        labels: au.buckets.map(b => b.label),
        datasets: [{ label: 'People', data: au.buckets.map(b => b.people), backgroundColor: '#ec4899', borderRadius: 10, maxBarThickness: 46 }],
      },
      options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: axes() },
    }));

    document.addEventListener('themechange', () => {
      charts.forEach(c => {
        if (c.options.scales && c.options.scales.x) {
          c.options.scales.x.ticks.color = txt(); c.options.scales.y.ticks.color = txt(); c.options.scales.y.grid.color = grid();
        }
        if (c.options.plugins.legend.labels) c.options.plugins.legend.labels.color = txt();
        c.update();
      });
    });
  })();
</script>
<% } %>

<%- include('partials/footer') %>
