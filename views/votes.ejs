<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h1 class="fw-bold mb-1">🗳️ Vote Contests</h1>
    <p class="text-body-secondary mb-0">Pick your side, follow the live results, then share your vote on WhatsApp &amp; Facebook.</p>
  </div>
  <% if (isAdmin) { %><a href="/votes/new" class="btn btn-primary">➕ New contest</a><% } %>
</div>

<% if (polls.length === 0) { %>
  <div class="card border-0 shadow-sm"><div class="card-body text-center text-body-secondary py-5">No contests yet. Check back soon!</div></div>
<% } %>

<div class="row g-3">
  <% polls.forEach(p => { const shown = p.opts.slice(0, 4); const more = p.opts.length - shown.length; %>
    <div class="col-12 col-md-6">
      <div class="card border-0 shadow-sm h-100 post-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h5 class="fw-bold mb-0"><a class="stretched-link text-body" href="/votes/<%= p.id %>"><%= p.title %></a></h5>
            <div class="d-flex gap-1 flex-shrink-0">
              <% if (p.kind === 'knockout') { %><span class="badge text-bg-warning">Knockout</span><% } %>
              <span class="badge <%= p.open ? 'text-bg-success' : 'text-bg-secondary' %>"><%= p.open ? 'Live' : 'Ended' %></span>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <% shown.forEach((o, i) => { %>
              <% if (i > 0 && shown.length === 2) { %><span class="badge rounded-pill text-bg-danger">VS</span><% } %>
              <div class="flex-fill text-center" style="min-width:0;">
                <img src="<%= o.image %>" alt="<%= o.name %>" class="rounded w-100" style="aspect-ratio:<%= shown.length === 2 ? '4/3' : '1/1' %>;object-fit:cover;">
                <div class="small fw-semibold mt-1 text-truncate"><%= o.name %></div>
              </div>
            <% }) %>
            <% if (more > 0) { %><span class="small text-body-secondary">+<%= more %></span><% } %>
          </div>
          <div class="small text-body-secondary mt-2">
            <%= p.total %> vote<%= p.total === 1 ? '' : 's' %> · <%= p.comment_count %> comment<%= p.comment_count === 1 ? '' : 's' %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
