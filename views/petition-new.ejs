<%- include('partials/header') %>
<%- include('partials/petition-assets') %>
<div class="pt">
<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm"><div class="card-body p-3 p-md-4">
      <h1 class="h3 fw-bold mb-1" style="font-family:var(--kz-serif);">Start a petition</h1>
      <p class="text-body-secondary">Describe one clear problem and what you want done. Petitions that name a place, include a photo and ask for one specific action are the ones people sign and share.</p>
      <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>
      <form action="/petitions" method="POST" id="petForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="image_id" id="imageId" value="<%= f.image_id || '' %>">
        <div class="mb-3">
          <label class="form-label fw-semibold" for="title">Title</label>
          <input class="form-control" id="title" name="title" maxlength="120" minlength="10" required value="<%= f.title || '' %>" placeholder="Repair the broken road on Canal Road before the rains">
          <div class="form-text">Say what you want done, not just what is wrong.</div>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold" for="city">City</label>
            <input class="form-control" id="city" name="city" maxlength="60" required list="cityList" value="<%= f.city || '' %>" placeholder="Lahore" autocomplete="off">
            <datalist id="cityList"><% cities.forEach(c => { %><option value="<%= c %>"><% }) %></datalist>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold" for="area">Area or street <span class="text-body-secondary fw-normal">(optional)</span></label>
            <input class="form-control" id="area" name="area" maxlength="80" value="<%= f.area || '' %>" placeholder="Johar Town, Block C">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold" for="category">Topic</label>
          <select class="form-select" id="category" name="category" required>
            <option value="">Choose a topic</option>
            <% categories.forEach(c => { %><option value="<%= c %>" <%= f.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold" for="body">The problem</label>
          <textarea class="form-control" id="body" name="body" rows="9" maxlength="1500" minlength="60" required placeholder="What is wrong, where exactly, since when, and who is affected? What should the authorities do?"><%= f.body || '' %></textarea>
          <div class="form-text"><span id="bodyCount">0</span> / 1500. Stick to facts. Do not accuse named people of crimes and do not share phone numbers or addresses of private people.</div>
        </div>
        <div class="mb-4">
          <div class="fw-semibold mb-1">Photo <span class="text-body-secondary fw-normal">(optional, but it helps a lot)</span></div>
          <input type="file" id="photoFile" accept="image/*" class="d-none">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="photoBtn">Add a photo</button>
          <div id="photoPrev" class="mt-2 <%= f.image_id ? '' : 'd-none' %>">
            <img id="photoImg" src="<%= f.image_id ? '/img/' + f.image_id : '' %>" alt="Selected photo" style="max-width: 280px; max-height: 200px; border-radius: 12px;">
            <button type="button" class="btn btn-link btn-sm text-danger" id="photoRm">Remove</button>
          </div>
          <div class="text-danger small mt-1" id="photoMsg" role="alert"></div>
        </div>
        <button class="btn btn-success btn-lg" id="petBtn">Publish petition</button>
        <a href="/petitions" class="btn btn-outline-secondary ms-1">Cancel</a>
      </form>
    </div></div>
  </div>
</div>
</div>

<script>
(function () {
  var csrf = <%- JSON.stringify(csrfToken) %>;
  var body = document.getElementById('body'), cnt = document.getElementById('bodyCount');
  var upd = function () { cnt.textContent = body.value.length; }; body.addEventListener('input', upd); upd();
  var file = document.getElementById('photoFile'), pick = document.getElementById('photoBtn'), prev = document.getElementById('photoPrev');
  var img = document.getElementById('photoImg'), rm = document.getElementById('photoRm'), idIn = document.getElementById('imageId');
  var msg = document.getElementById('photoMsg'), btn = document.getElementById('petBtn'), form = document.getElementById('petForm');
  var busy = false, blobUrl = null;
  function discard(id) { if (!id) return;
    fetch('/feed/image/discard', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf, 'X-Requested-With': 'fetch' }, body: 'id=' + encodeURIComponent(id) }); }
  function clearPhoto() { if (blobUrl) { URL.revokeObjectURL(blobUrl); blobUrl = null; } prev.classList.add('d-none'); img.removeAttribute('src'); idIn.value = ''; file.value = ''; busy = false; btn.disabled = false; }
  pick.addEventListener('click', function () { file.click(); });
  rm.addEventListener('click', function () { var id = idIn.value; clearPhoto(); discard(id); });
  function upload(blob) {
    busy = true; btn.disabled = true; msg.textContent = '';
    if (blobUrl) URL.revokeObjectURL(blobUrl);
    blobUrl = URL.createObjectURL(blob); img.src = blobUrl; prev.classList.remove('d-none'); img.style.opacity = '.5';
    fetch('/upload-feed-image', { method: 'POST', headers: { 'Content-Type': 'image/jpeg', 'x-csrf-token': csrf }, body: blob, credentials: 'same-origin' })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        img.style.opacity = '1';
        if (x.ok && x.j.id) { idIn.value = x.j.id; busy = false; btn.disabled = false; }
        else { clearPhoto(); msg.textContent = (x.j && x.j.error) || 'Photo upload failed. Please try again.'; }
      })
      .catch(function () { img.style.opacity = '1'; clearPhoto(); msg.textContent = 'Photo upload failed. Please try again.'; });
  }
  file.addEventListener('change', function () {
    var f = file.files[0]; if (!f) return; msg.textContent = '';
    if (!/^image\//.test(f.type)) { msg.textContent = 'Please choose an image.'; file.value = ''; return; }
    discard(idIn.value); idIn.value = '';
    var im = new Image(), url = URL.createObjectURL(f);
    im.onload = function () {
      function encode(max, q, cb) { var s = Math.min(1, max / Math.max(im.width, im.height)); var c = document.createElement('canvas');
        c.width = Math.round(im.width * s); c.height = Math.round(im.height * s); var ctx = c.getContext('2d');
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height); ctx.drawImage(im, 0, 0, c.width, c.height); c.toBlob(cb, 'image/jpeg', q); }
      encode(1600, 0.85, function (blob) {
        if (blob && blob.size > 1900000) return encode(1280, 0.65, function (b2) { URL.revokeObjectURL(url); b2 ? upload(b2) : (msg.textContent = 'Could not read this image.'); });
        URL.revokeObjectURL(url); blob ? upload(blob) : (msg.textContent = 'Could not read this image.');
      });
    };
    im.onerror = function () { URL.revokeObjectURL(url); msg.textContent = 'Could not read this image. Please try a JPG or PNG photo.'; file.value = ''; };
    im.src = url;
  });
  form.addEventListener('submit', function (e) {
    if (busy) { e.preventDefault(); msg.textContent = 'Photo is still uploading...'; return; }
    btn.disabled = true; btn.textContent = 'Publishing...';
  });
  window.addEventListener('pageshow', function (ev) { if (ev.persisted) { btn.disabled = false; btn.textContent = 'Publish petition'; } });
})();
</script>
<%- include('partials/footer') %>
