<%- include('partials/header') %>
<%- include('partials/feed-assets') %>

<div class="feed-hero p-4 p-md-5 mb-4 shadow-sm">
  <div class="d-flex align-items-center gap-3 flex-wrap">
    <span class="group-hero-emoji"><%= group.emoji %></span>
    <div class="flex-grow-1" style="min-width: 200px;">
      <h1 class="fw-bold mb-1 fs-2 text-break"><%= group.name %></h1>
      <div class="opacity-75 small"><%= group.members %> member<%= group.members === 1 ? '' : 's' %> · <%= group.posts %> post<%= group.posts === 1 ? '' : 's' %> · created by <%= group.owner_name %></div>
    </div>
    <% if (user) { %>
      <% if (role) { %>
        <% if (group.owner_id !== user.id) { %>
          <form action="/groups/<%= group.slug %>/leave" method="POST" class="mb-0" onsubmit="return confirm('Leave this group?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-light rounded-pill fw-semibold px-4">✓ Joined</button>
          </form>
        <% } else { %><span class="badge text-bg-light rounded-pill px-3 py-2">👑 You own this group</span><% } %>
      <% } else { %>
        <form action="/groups/<%= group.slug %>/join" method="POST" class="mb-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-light rounded-pill fw-bold px-4">Join group</button>
        </form>
      <% } %>
    <% } else { %>
      <a href="/login" class="btn btn-light rounded-pill fw-bold px-4">Log in to join</a>
    <% } %>
  </div>
</div>

<% if (flash.created) { %><div class="alert alert-success">Group created! 🎉 Write the first post below.</div><% } %>
<% if (flash.posted) { %><div class="alert alert-success">Posted! 🎉</div><% } %>
<% if (flash.deleted) { %><div class="alert alert-success">Post deleted.</div><% } %>
<% if (flash.reported) { %><div class="alert alert-success">Thanks, your report was sent to the site owner.</div><% } %>
<% if (flash.notice) { %><div class="alert alert-warning"><%= flash.notice %></div><% } %>
<% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

<div class="row g-4">
  <section class="col-12 col-lg-8">
    <a href="/groups" class="btn btn-sm btn-outline-secondary rounded-pill mb-3">← All groups</a>

    <% if (user && role) { %>
      <%- include('partials/composer', { groupId: group.id, placeholder: 'Share something with ' + group.name + '...' }) %>
    <% } else if (user) { %>
      <div class="card border-0 shadow-sm mb-3"><div class="card-body d-flex align-items-center gap-3">
        <div class="fs-2"><%= group.emoji %></div>
        <div class="flex-grow-1"><div class="fw-semibold">Join to post in this group</div><div class="small text-body-secondary">You can read everything. Join to post, like and comment.</div></div>
        <form action="/groups/<%= group.slug %>/join" method="POST" class="mb-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary btn-sm rounded-pill px-3">Join</button>
        </form>
      </div></div>
    <% } else { %>
      <div class="card border-0 shadow-sm mb-3"><div class="card-body d-flex align-items-center gap-3">
        <div class="fs-2"><%= group.emoji %></div>
        <div class="flex-grow-1"><div class="fw-semibold">Want to post here?</div><div class="small text-body-secondary">Log in and join the group.</div></div>
        <a href="/login" class="btn btn-primary btn-sm">Login</a>
      </div></div>
    <% } %>

    <div id="feedList"><%- include('partials/feed-cards') %></div>

    <% if (posts.length === 0) { %>
      <div class="card border-0 shadow-sm"><div class="card-body text-center text-body-secondary py-5">
        <div class="fs-1 mb-2">🌱</div>No posts in this group yet.<% if (role) { %> Be the first to post!<% } %>
      </div></div>
    <% } %>

    <% if (nextBefore) { %>
      <div class="text-center my-3">
        <button type="button" id="moreBtn" class="btn btn-outline-primary rounded-pill px-4"
                data-next="<%= nextBefore %>" data-tab="" data-user="">Load more</button>
      </div>
    <% } %>
  </section>

  <aside class="col-12 col-lg-4">
    <div class="feed-side">
      <div class="card border-0 shadow-sm mb-3"><div class="card-body">
        <div class="fw-bold mb-2">About</div>
        <p class="small mb-0 text-break <%= group.description ? '' : 'text-body-secondary' %>"><%= group.description || 'No description yet.' %></p>
      </div></div>

      <div class="card border-0 shadow-sm mb-3"><div class="card-body">
        <div class="fw-bold mb-2">👥 Members (<%= group.members %>)</div>
        <% members.forEach(function (m) { %>
          <a class="side-link d-flex align-items-center gap-2" href="/u/<%= encodeURIComponent(m.username) %>">
            <span class="avatar avatar-sm"><%= m.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(m.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
            <span class="text-truncate"><%= m.username %></span>
            <% if (m.role === 'admin') { %><span class="badge text-bg-primary ms-auto">Admin</span><% } %>
          </a>
        <% }) %>
        <% if (group.members > members.length) { %><div class="small text-body-secondary px-2 pt-1">and <%= group.members - members.length %> more</div><% } %>
      </div></div>

      <%- include('partials/group-share', { group, shareBase }) %>

      <% if (canDeleteGroup) { %>
        <form action="/groups/<%= group.slug %>/delete" method="POST" class="mb-3" onsubmit="return confirm('Delete this group with all its posts and comments? This cannot be undone.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-outline-danger rounded-pill w-100">🗑️ Delete group</button>
        </form>
      <% } %>
    </div>
  </aside>
</div>

<style>
  .group-hero-emoji { width: 72px; height: 72px; border-radius: 1.25rem; background: rgba(255,255,255,.2); display: inline-flex; align-items: center; justify-content: center; font-size: 2.4rem; flex-shrink: 0; }
</style>

<%- include('partials/report-modal') %>
<%- include('partials/feed-script') %>
<%- include('partials/load-more', { moreBase: '/groups/' + group.slug }) %>

<%- include('partials/footer') %>
