<%- include('partials/header') %>

<div id="readProgress" aria-hidden="true"></div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">

    <a href="/blog" class="text-decoration-none">&larr; Back to all posts</a>

    <% if (!post.is_live) { %>
      <div class="alert alert-warning mt-3 mb-0">
        <% if (post.is_draft) { %>
          <strong>Draft:</strong> yeh post abhi sirf aap ko nazar aa rahi hai. Publish karne ke liye Edit &rarr; "Publish".
        <% } else { %>
          <strong>Scheduled:</strong> yeh post
          <%= new Date(post.publish_at).toLocaleString('en-GB', { timeZone: (locals.tz || 'Asia/Karachi'), dateStyle: 'medium', timeStyle: 'short' }) %>
          par khud publish hogi.
        <% } %>
      </div>
    <% } %>

    <article class="card border-0 shadow-sm mt-3">
      <% if (post.cover_url) { %>
        <img src="<%= post.cover_url %>" class="card-img-top" style="max-height:360px;object-fit:cover;" alt="">
      <% } %>

      <div class="card-body p-4 p-md-5">
        <a href="/blog?category=<%= encodeURIComponent(post.category) %>" class="badge text-bg-primary text-decoration-none mb-3">
          <%= post.category %>
        </a>
        <h1 class="fw-bold mb-3"><%= post.title %></h1>

        <% if (tags && tags.length) { %>
          <div class="mb-3">
            <% tags.forEach(t => { %>
              <a href="/blog?tag=<%= encodeURIComponent(t) %>" class="badge text-bg-secondary text-decoration-none me-1">#<%= t %></a>
            <% }) %>
          </div>
        <% } %>

        <div class="d-flex flex-wrap align-items-center gap-2 text-body-secondary mb-4">
          <span class="avatar"><%= post.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(post.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
          <span class="fw-semibold text-body"><a href="/u/<%= encodeURIComponent(post.username) %>" class="text-reset text-decoration-none"><%= post.username %></a></span>
          <% if (!user || user.id !== post.user_id) { %>
            <% if (user) { %>
              <form action="/u/<%= encodeURIComponent(post.username) %>/<%= post.following ? 'unfollow' : 'follow' %>" method="POST" class="d-inline mb-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="ret" value="/posts/<%= post.slug %>">
                <button type="submit" class="btn btn-sm <%= post.following ? 'btn-outline-secondary' : 'btn-outline-primary' %> py-0"><%= post.following ? '✓ Following' : '➕ Follow' %></button>
              </form>
            <% } else { %>
              <a href="/login" class="btn btn-sm btn-outline-primary py-0">➕ Follow</a>
            <% } %>
          <% } %>
          <span>&middot;</span>
          <span><%= new Date(post.publish_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
          <span>&middot;</span>
          <span><%= readingTime %> min read</span>
          <span>&middot;</span>
          <span><%= post.views %> views</span>
        </div>

        <% if (post.excerpt) { %>
          <p class="lead text-body-secondary"><%= post.excerpt %></p>
          <hr>
        <% } %>

        <% if (locals.toc && toc.length >= 3) { %>
          <details class="toc card card-body bg-body-tertiary border-0 mb-4" open>
            <summary class="fw-semibold" style="cursor:pointer;">📑 In this post</summary>
            <ul class="list-unstyled mb-0 mt-2">
              <% toc.forEach(function (t) { %>
                <li class="py-1" style="<%= t.level === 3 ? 'padding-left:1.25rem;' : '' %>">
                  <a href="#<%= t.id %>"><%- t.text %></a>
                </li>
              <% }) %>
            </ul>
          </details>
        <% } %>

        <div class="post-body"><%- contentHtml %></div>

        <hr class="my-4">

        <!-- Reactions -->
        <div id="reactions" class="d-flex flex-wrap gap-2 mb-3">
          <% reactionEmojis.forEach(e => { %>
            <% if (user) { %>
              <form action="/posts/<%= post.id %>/react" method="POST" class="mb-0">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="emoji" value="<%= e %>">
                <button type="submit" class="btn btn-sm <%= myReaction === e ? 'btn-primary' : 'btn-outline-secondary' %>">
                  <%= e %> <%= reactionCounts[e] || 0 %>
                </button>
              </form>
            <% } else { %>
              <span class="btn btn-sm btn-outline-secondary disabled"><%= e %> <%= reactionCounts[e] || 0 %></span>
            <% } %>
          <% }) %>
          <% if (!user) { %>
            <span class="align-self-center small text-body-secondary"><a href="/login">Log in</a> to react</span>
          <% } %>
        </div>

        <hr class="my-4">

        <!-- Actions -->
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <% if (user) { %>
            <form action="/posts/<%= post.id %>/like" method="POST" class="mb-0">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm <%= post.liked ? 'btn-danger' : 'btn-outline-danger' %>">
                <%= post.liked ? 'Liked' : 'Like' %> (<%= post.like_count %>)
              </button>
            </form>
            <form action="/posts/<%= post.id %>/bookmark" method="POST" class="mb-0">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm <%= post.bookmarked ? 'btn-warning' : 'btn-outline-warning' %>">
                <%= post.bookmarked ? 'Bookmarked' : 'Bookmark' %>
              </button>
            </form>
          <% } else { %>
            <span class="text-body-secondary small">
              <%= post.like_count %> likes &middot; <a href="/login">Log in</a> to like, bookmark or comment
            </span>
          <% } %>

          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
              Share
            </button>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" target="_blank" rel="noopener"
                   href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' - ' + shareLinks.whatsapp) %>">WhatsApp</a>
              </li>
              <li>
                <a class="dropdown-item" target="_blank" rel="noopener"
                   href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareLinks.facebook) %>">Facebook</a>
              </li>
              <li>
                <a class="dropdown-item" target="_blank" rel="noopener"
                   href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(shareLinks.twitter) %>">Twitter / X</a>
              </li>
              <li>
                <button type="button" class="dropdown-item"
                        onclick="navigator.clipboard.writeText('<%= shareLinks.copy %>'); this.textContent='Link copied';">
                  Copy link
                </button>
              </li>
            </ul>
          </div>

          <% if (isAdmin) { %>
            <div class="ms-auto d-flex gap-2">
              <a href="/posts/<%= post.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
              <form action="/posts/<%= post.id %>/delete" method="POST" class="mb-0"
                    onsubmit="return confirm('Delete this post permanently?')">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </article>

    <% if (locals.pollState) { %>
      <section class="card border-0 shadow-sm mt-4" id="poll-widget">
        <div class="card-body p-3 p-md-4">
          <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h5 class="fw-bold mb-0">🗳️ <%= pollState.title %></h5>
            <a href="/votes/<%= pollState.id %>#comments" class="small text-decoration-none flex-shrink-0">Open contest &amp; comments →</a>
          </div>
          <% if (locals.pollNotice) { %><div class="alert alert-info py-2"><%= pollNotice %></div><% } %>
          <%- include('partials/poll-block', { st: pollState, compact: true, ret: '/posts/' + post.slug }) %>
        </div>
      </section>
      <%- include('partials/poll-script') %>
    <% } %>

    <%- include('partials/group-banner') %>

    <!-- Comments -->
    <section id="comments" class="card border-0 shadow-sm mt-4">
      <div class="card-body p-4">
        <h5 class="mb-3">Comments (<%= comments.length %>)</h5>

        <% if (commentError) { %>
          <div class="alert alert-danger"><%= commentError %></div>
        <% } %>
        <% if (locals.commentNotice) { %><div class="alert alert-info"><%= commentNotice %></div><% } %>
        <% if (locals.reportedFlash) { %><div class="alert alert-success">Thanks! Your report was sent to the site owner.</div><% } %>

        <% if (user) { %>
          <form action="/posts/<%= post.id %>/comments" method="POST" class="mb-4">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <textarea class="form-control mb-2" name="body" rows="3" maxlength="1000"
                      placeholder="Write a comment..." required></textarea>
            <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
          </form>
        <% } else { %>
          <p class="text-body-secondary"><a href="/login">Log in</a> or <a href="/signup">sign up</a> to comment.</p>
        <% } %>

        <% if (comments.length === 0) { %>
          <p class="text-body-secondary mb-0">No comments yet.</p>
        <% } %>

        <% const renderComment = (c, isReply) => { %>
          <% const canSee = !c.is_hidden || isAdmin || (user && user.id === c.user_id); %>
          <% if (!canSee) { %>
            <div id="c<%= c.id %>" class="py-3 border-top text-body-secondary fst-italic <%= isReply ? 'reply-box' : '' %>">This comment is hidden while the site owner reviews it.</div>
          <% return; } %>
          <div id="c<%= c.id %>" class="d-flex gap-3 py-3 border-top <%= isReply ? 'reply-box' : '' %>">
            <span class="avatar"><%= c.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(c.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><a href="/u/<%= encodeURIComponent(c.username) %>" class="text-reset text-decoration-none"><%= c.username %></a></strong>
                  <small class="text-body-secondary ms-2">
                    <%= new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </small>
                  <% if (c.is_hidden) { %><span class="badge text-bg-warning ms-1">Under review<%= isAdmin ? '' : ' (only you can see this)' %></span><% } %>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <% if (user && user.id !== c.user_id) { %>
                    <button type="button" class="btn btn-link btn-sm text-body-secondary p-0" data-bs-toggle="modal" data-bs-target="#reportModal"
                            data-report-type="comment" data-report-id="<%= c.id %>">Report</button>
                  <% } %>
                  <% if (user && (isAdmin || user.id === c.user_id)) { %>
                    <form action="/comments/<%= c.id %>/delete" method="POST" class="mb-0"
                          onsubmit="return confirm('Delete this comment?')">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
              <div class="comment-body"><%= c.body %></div>

              <% if (user) { %>
                <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-decoration-none"
                        data-bs-toggle="collapse" data-bs-target="#reply-<%= c.id %>">Reply</button>
                <div class="collapse mt-2" id="reply-<%= c.id %>">
                  <form action="/posts/<%= post.id %>/comments" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="parent_id" value="<%= c.id %>">
                    <textarea class="form-control form-control-sm mb-2" name="body" rows="2" maxlength="1000"
                              placeholder="Reply to <%= c.username %>..." required></textarea>
                    <button type="submit" class="btn btn-primary btn-sm">Post Reply</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% }; %>

        <% threads.forEach(t => { %>
          <% renderComment(t, false); %>
          <% t.replies.forEach(r => { renderComment(r, true); }); %>
        <% }) %>
      </div>
    </section>

    <% if (related.length) { %>
      <h5 class="mt-5 mb-3">Related posts</h5>
      <div class="row g-3">
        <% related.forEach(r => { %>
          <div class="col-12 col-md-6">
            <a href="/posts/<%= r.slug %>" class="card border-0 shadow-sm h-100 text-decoration-none post-card">
              <% if (r.cover_url) { %>
                <img src="<%= r.cover_url %>" class="card-img-top" style="height:110px;object-fit:cover;" alt="">
              <% } %>
              <div class="card-body py-3">
                <span class="badge text-bg-primary mb-2"><%= r.category %></span>
                <div class="fw-semibold text-body"><%= r.title %></div>
                <small class="text-body-secondary"><%= new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>

<script>
  // Reading progress bar: post ke text par kitna scroll hua
  (function () {
    var bar = document.getElementById('readProgress');
    var body = document.querySelector('.post-body');
    if (!bar || !body) return;
    var ticking = false;
    function update() {
      var rect = body.getBoundingClientRect();
      var total = rect.height - window.innerHeight * 0.6;
      var done = -rect.top + window.innerHeight * 0.2;
      var pct = total > 0 ? Math.min(Math.max(done / total, 0), 1) : 0;
      bar.style.width = (pct * 100).toFixed(1) + '%';
      ticking = false;
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>

<%- include('partials/report-modal') %>

<%- include('partials/footer') %>