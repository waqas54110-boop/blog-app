<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">

    <a href="/" class="text-decoration-none">&larr; Back to all posts</a>

    <article class="card border-0 shadow-sm mt-3">
      <% if (post.cover_url) { %>
        <img src="<%= post.cover_url %>" class="card-img-top" style="max-height:360px;object-fit:cover;" alt="">
      <% } %>

      <div class="card-body p-4 p-md-5">
        <a href="/?category=<%= encodeURIComponent(post.category) %>" class="badge text-bg-primary text-decoration-none mb-3">
          <%= post.category %>
        </a>
        <h1 class="fw-bold mb-3"><%= post.title %></h1>

        <% if (tags && tags.length) { %>
          <div class="mb-3">
            <% tags.forEach(t => { %>
              <a href="/?tag=<%= encodeURIComponent(t) %>" class="badge text-bg-secondary text-decoration-none me-1">#<%= t %></a>
            <% }) %>
          </div>
        <% } %>

        <div class="d-flex flex-wrap align-items-center gap-2 text-body-secondary mb-4">
          <span class="avatar"><%= post.username.charAt(0).toUpperCase() %></span>
          <span class="fw-semibold text-body"><%= post.username %></span>
          <span>&middot;</span>
          <span><%= new Date(post.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
          <span>&middot;</span>
          <span><%= readingTime %> min read</span>
          <span>&middot;</span>
          <span><%= post.views %> views</span>
        </div>

        <% if (post.excerpt) { %>
          <p class="lead text-body-secondary"><%= post.excerpt %></p>
          <hr>
        <% } %>

        <div class="post-body"><%- contentHtml %></div>

        <hr class="my-4">

        <!-- Reactions -->
        <div id="reactions" class="d-flex flex-wrap gap-2 mb-3">
          <% reactionEmojis.forEach(e => { %>
            <% if (user) { %>
              <form action="/posts/<%= post.id %>/react" method="POST" class="mb-0">
                <input type="hidden" name="emoji" value="<%= e %>">
                <button type="submit" class="btn btn-sm <%= myReaction === e ? 'btn-primary' : 'btn-outline-secondary' %>">
                  <%= e %> <%= reactionCounts[e] || 0 %>
                </button>
              </form>
            <% } else { %>
              <span class="btn btn-sm btn-outline-secondary disabled"><%= e %> <%= reactionCounts[e] || 0 %></span>
            <% } %>
          <% }) %>
          <% if (!user) { %>
            <span class="align-self-center small text-body-secondary"><a href="/login">Log in</a> to react</span>
          <% } %>
        </div>

        <hr class="my-4">

        <!-- Actions -->
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <% if (user) { %>
            <form action="/posts/<%= post.id %>/like" method="POST" class="mb-0">
              <button type="submit" class="btn btn-sm <%= post.liked ? 'btn-danger' : 'btn-outline-danger' %>">
                <%= post.liked ? 'Liked' : 'Like' %> (<%= post.like_count %>)
              </button>
            </form>
            <form action="/posts/<%= post.id %>/bookmark" method="POST" class="mb-0">
              <button type="submit" class="btn btn-sm <%= post.bookmarked ? 'btn-warning' : 'btn-outline-warning' %>">
                <%= post.bookmarked ? 'Bookmarked' : 'Bookmark' %>
              </button>
            </form>
          <% } else { %>
            <span class="text-body-secondary small">
              <%= post.like_count %> likes &middot; <a href="/login">Log in</a> to like, bookmark or comment
            </span>
          <% } %>

          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
              Share
            </button>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" target="_blank" rel="noopener"
                   href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' - ' + shareUrl) %>">WhatsApp</a>
              </li>
              <li>
                <a class="dropdown-item" target="_blank" rel="noopener"
                   href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>">Facebook</a>
              </li>
              <li>
                <a class="dropdown-item" target="_blank" rel="noopener"
                   href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(shareUrl) %>">Twitter / X</a>
              </li>
              <li>
                <button type="button" class="dropdown-item"
                        onclick="navigator.clipboard.writeText('<%= shareUrl %>'); this.textContent='Link copied';">
                  Copy link
                </button>
              </li>
            </ul>
          </div>

          <% if (isAdmin) { %>
            <div class="ms-auto d-flex gap-2">
              <a href="/posts/<%= post.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
              <form action="/posts/<%= post.id %>/delete" method="POST" class="mb-0"
                    onsubmit="return confirm('Delete this post permanently?')">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </article>

    <!-- Comments -->
    <section id="comments" class="card border-0 shadow-sm mt-4">
      <div class="card-body p-4">
        <h5 class="mb-3">Comments (<%= comments.length %>)</h5>

        <% if (commentError) { %>
          <div class="alert alert-danger"><%= commentError %></div>
        <% } %>

        <% if (user) { %>
          <form action="/posts/<%= post.id %>/comments" method="POST" class="mb-4">
            <textarea class="form-control mb-2" name="body" rows="3" maxlength="1000"
                      placeholder="Write a comment..." required></textarea>
            <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
          </form>
        <% } else { %>
          <p class="text-body-secondary"><a href="/login">Log in</a> or <a href="/signup">sign up</a> to comment.</p>
        <% } %>

        <% if (comments.length === 0) { %>
          <p class="text-body-secondary mb-0">No comments yet.</p>
        <% } %>

        <% comments.forEach(c => { %>
          <div class="d-flex gap-3 py-3 border-top">
            <span class="avatar"><%= c.username.charAt(0).toUpperCase() %></span>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><%= c.username %></strong>
                  <small class="text-body-secondary ms-2">
                    <%= new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </small>
                </div>
                <% if (user && (isAdmin || user.id === c.user_id)) { %>
                  <form action="/comments/<%= c.id %>/delete" method="POST" class="mb-0"
                        onsubmit="return confirm('Delete this comment?')">
                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                  </form>
                <% } %>
              </div>
              <div class="comment-body"><%= c.body %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <% if (related.length) { %>
      <h5 class="mt-5 mb-3">More in <%= post.category %></h5>
      <div class="list-group shadow-sm">
        <% related.forEach(r => { %>
          <a href="/posts/<%= r.id %>" class="list-group-item list-group-item-action d-flex justify-content-between">
            <span><%= r.title %></span>
            <small class="text-body-secondary"><%= new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></small>
          </a>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>

<%- include('partials/footer') %>