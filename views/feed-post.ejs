<%- include('partials/header') %>
<%- include('partials/feed-assets') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-7 col-xl-6">
    <a href="/feed" class="btn btn-sm btn-outline-secondary rounded-pill mb-3">← Back to feed</a>

    <% if (flash.reported) { %><div class="alert alert-success">Thanks, your report was sent to the site owner.</div><% } %>
    <% if (flash.notice) { %><div class="alert alert-warning"><%= flash.notice %></div><% } %>
    <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

    <%- include('partials/feed-card', { f: f }) %>
  </div>
</div>

<%- include('partials/report-modal') %>
<%- include('partials/feed-script') %>

<%- include('partials/footer') %>
