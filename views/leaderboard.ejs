<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 p-md-5">
        <h1 class="fw-bold mb-2">🏆 Top Commenters</h1>
        <p class="text-body-secondary mb-4">The most active readers on this blog.</p>

        <% if (leaders.length === 0) { %>
          <p class="text-body-secondary mb-0">No comments yet. Be the first to comment on a post!</p>
        <% } else { %>
          <div class="list-group">
            <% leaders.forEach((l, i) => { %>
              <div class="list-group-item d-flex align-items-center gap-3">
                <span class="fw-bold text-primary" style="width:2rem;">
                  <%= i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1) + '.' %>
                </span>
                <span class="avatar"><%= l.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(l.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
                <a href="/u/<%= encodeURIComponent(l.username) %>" class="fw-semibold flex-grow-1 text-reset text-decoration-none"><%= l.username %></a>
                <span class="badge text-bg-primary"><%= l.comment_count %> comments</span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
