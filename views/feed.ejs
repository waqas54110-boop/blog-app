<%- include('partials/header') %>
<%- include('partials/feed-assets') %>

<div class="feed-hero p-4 p-md-5 mb-4 shadow-sm">
  <h1 class="fw-bold mb-1 fs-2">📸 Community Feed</h1>
  <p class="mb-0 opacity-75">Share your photos and thoughts. Everyone can see, like and comment.</p>
</div>

<% if (flash.posted) { %><div class="alert alert-success">Posted! 🎉</div><% } %>
<% if (flash.deleted) { %><div class="alert alert-success">Post deleted.</div><% } %>
<% if (flash.reported) { %><div class="alert alert-success">Thanks, your report was sent to the site owner.</div><% } %>
<% if (flash.notice) { %><div class="alert alert-warning"><%= flash.notice %></div><% } %>
<% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

<div class="row g-4">

  <!-- Left: me / join -->
  <aside class="col-lg-3 d-none d-lg-block">
    <div class="feed-side">
      <div class="card border-0 shadow-sm mb-3"><div class="card-body text-center">
        <% if (user) { %>
          <span class="avatar avatar-lg mb-2"><%= user.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(user.username) %>" alt="" onerror="this.remove()"></span>
          <div class="fw-bold text-break"><%= user.username %></div>
          <div class="mt-3 text-start">
            <a class="side-link" href="/u/<%= encodeURIComponent(user.username) %>">👤 My profile</a>
            <a class="side-link" href="/?user=<%= encodeURIComponent(user.username) %>">📸 My posts</a>
            <a class="side-link" href="/friends">👫 Friends</a>
            <a class="side-link" href="/messages">💬 Messages</a>
            <a class="side-link" href="/settings/profile">✏️ Edit profile</a>
          </div>
        <% } else { %>
          <div class="fs-1">👋</div>
          <div class="fw-bold mb-1">Join the community</div>
          <p class="small text-body-secondary">Create a free account to post photos, like and comment.</p>
          <a href="/signup" class="btn btn-primary w-100 mb-2">Sign Up</a>
          <a href="/login" class="btn btn-outline-primary w-100">Login</a>
        <% } %>
      </div></div>
    </div>
  </aside>

  <!-- Center: composer + posts -->
  <section class="col-12 col-lg-6">

    <% if (user) { %>
      <form id="composer" class="card composer shadow-sm mb-3" action="/feed" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="image_id" value="">
        <div class="card-body">
          <div class="d-flex gap-2 align-items-start">
            <span class="avatar avatar-md mt-1"><%= user.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(user.username) %>" alt="" onerror="this.remove()"></span>
            <textarea name="body" class="form-control" rows="2" maxlength="2000" placeholder="What's on your mind, <%= user.username %>?"></textarea>
          </div>
          <div id="photoPreview" class="composer-preview mt-3 d-none">
            <img src="" alt="Selected photo">
            <button type="button" class="rm" aria-label="Remove photo">✕</button>
          </div>
          <div class="small text-danger mt-2" id="composerMsg"></div>
          <div class="d-flex align-items-center gap-2 mt-3">
            <input type="file" id="photoFile" accept="image/*" class="d-none">
            <button type="button" id="photoBtn" class="btn btn-photo">📷 Photo</button>
            <span class="small text-body-secondary ms-auto" id="charCount"></span>
            <button type="submit" id="postBtn" class="btn btn-primary btn-post">Post</button>
          </div>
        </div>
      </form>
    <% } else { %>
      <div class="card border-0 shadow-sm mb-3"><div class="card-body d-flex align-items-center gap-3">
        <div class="fs-2">📷</div>
        <div class="flex-grow-1"><div class="fw-semibold">Want to share a photo?</div><div class="small text-body-secondary">Log in to post, like and comment.</div></div>
        <a href="/login" class="btn btn-primary btn-sm">Login</a>
      </div></div>
    <% } %>

    <% if (author) { %>
      <div class="alert alert-light border d-flex justify-content-between align-items-center">
        <span>Posts by <a href="/u/<%= encodeURIComponent(author.username) %>" class="fw-semibold"><%= author.username %></a></span>
        <a href="/" class="btn btn-sm btn-outline-secondary">✕ Show everyone</a>
      </div>
    <% } else if (user) { %>
      <ul class="nav nav-pills feed-tabs mb-3 gap-1">
        <li class="nav-item"><a class="nav-link <%= tab === 'all' ? 'active' : '' %>" href="/">🌍 Everyone</a></li>
        <li class="nav-item"><a class="nav-link <%= tab === 'following' ? 'active' : '' %>" href="/?tab=following">⭐ Following</a></li>
      </ul>
    <% } %>

    <div id="feedList"><%- include('partials/feed-cards') %></div>

    <% if (posts.length === 0) { %>
      <div class="card border-0 shadow-sm"><div class="card-body text-center text-body-secondary py-5">
        <div class="fs-1 mb-2">🌱</div>
        <% if (tab === 'following') { %>
          Nothing here yet. Follow people (or add friends) to see their posts.
        <% } else { %>
          No posts yet. Be the first to share a photo!
        <% } %>
      </div></div>
    <% } %>

    <% if (nextBefore) { %>
      <div class="text-center my-3">
        <button type="button" id="moreBtn" class="btn btn-outline-primary rounded-pill px-4"
                data-next="<%= nextBefore %>" data-tab="<%= tab %>" data-user="<%= author ? author.username : '' %>">Load more</button>
      </div>
    <% } %>
  </section>

  <!-- Right: blog + people -->
  <aside class="col-lg-3 d-none d-lg-block">
    <div class="feed-side">
      <% if (latestPosts.length) { %>
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
          <div class="fw-bold mb-2">📝 Latest from the blog</div>
          <% latestPosts.forEach(function (p) { %><a class="side-link small" href="/posts/<%= p.slug %>"><%= p.title %></a><% }) %>
          <a class="side-link small fw-semibold" href="/blog">All blog posts →</a>
        </div></div>
      <% } %>
      <% if (people.length) { %>
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
          <div class="fw-bold mb-2">👥 People you may know</div>
          <% people.forEach(function (p) { %>
            <a class="side-link d-flex align-items-center gap-2" href="/u/<%= encodeURIComponent(p.username) %>">
              <span class="avatar avatar-sm"><%= p.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(p.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
              <span class="text-truncate"><%= p.username %><% if (p.mutual > 0) { %><span class="d-block small text-body-secondary"><%= p.mutual %> mutual</span><% } %></span>
            </a>
          <% }) %>
        </div></div>
      <% } %>
    </div>
  </aside>

</div>

<%- include('partials/report-modal') %>
<%- include('partials/feed-script') %>

<script>
(function () {
  var csrf = <%- JSON.stringify(csrfToken || '') %>;

  // ----- Load more -----
  var more = document.getElementById('moreBtn');
  if (more) {
    more.addEventListener('click', function () {
      more.disabled = true; more.textContent = 'Loading...';
      var q = 'partial=1&before=' + encodeURIComponent(more.dataset.next) + '&tab=' + encodeURIComponent(more.dataset.tab) +
        (more.dataset.user ? '&user=' + encodeURIComponent(more.dataset.user) : '');
      fetch('/?' + q, { credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error(); var next = r.headers.get('X-Next-Before'); return r.text().then(function (h) { return { h: h, next: next }; }); })
        .then(function (x) {
          document.getElementById('feedList').insertAdjacentHTML('beforeend', x.h);
          if (x.next) { more.dataset.next = x.next; more.disabled = false; more.textContent = 'Load more'; }
          else { more.parentNode.remove(); }
        })
        .catch(function () { more.disabled = false; more.textContent = 'Load more'; alert('Could not load more posts. Please try again.'); });
    });
  }

  // ----- Composer -----
  var form = document.getElementById('composer');
  if (!form) return;
  var ta = form.querySelector('textarea'), file = document.getElementById('photoFile'), pick = document.getElementById('photoBtn');
  var prev = document.getElementById('photoPreview'), prevImg = prev.querySelector('img'), rm = prev.querySelector('.rm');
  var idInput = form.querySelector('[name=image_id]'), postBtn = document.getElementById('postBtn');
  var msg = document.getElementById('composerMsg'), count = document.getElementById('charCount');
  var busy = false, blobUrl = null;

  function grow() {
    ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 260) + 'px';
    var n = ta.value.length; count.textContent = n > 1500 ? (2000 - n) + ' left' : '';
  }
  ta.addEventListener('input', grow);

  function clearPhoto() {
    if (blobUrl) { URL.revokeObjectURL(blobUrl); blobUrl = null; }
    prev.classList.add('d-none'); prev.classList.remove('busy'); prevImg.removeAttribute('src');
    idInput.value = ''; file.value = ''; busy = false; postBtn.disabled = false;
  }

  pick.addEventListener('click', function () { file.click(); });
  rm.addEventListener('click', function () {
    var id = idInput.value;
    clearPhoto();
    if (id) fetch('/feed/image/discard', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf, 'X-Requested-With': 'fetch' },
      body: 'id=' + encodeURIComponent(id)
    });
  });

  function upload(blob) {
    busy = true; postBtn.disabled = true; msg.textContent = '';
    if (blobUrl) URL.revokeObjectURL(blobUrl);
    blobUrl = URL.createObjectURL(blob);
    prevImg.src = blobUrl; prev.classList.remove('d-none'); prev.classList.add('busy');
    fetch('/upload-feed-image', { method: 'POST', headers: { 'Content-Type': 'image/jpeg', 'x-csrf-token': csrf }, body: blob, credentials: 'same-origin' })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (x.ok && x.j.id) { idInput.value = x.j.id; prev.classList.remove('busy'); busy = false; postBtn.disabled = false; }
        else { clearPhoto(); msg.textContent = (x.j && x.j.error) || 'Photo upload failed. Please try again.'; }
      })
      .catch(function () { clearPhoto(); msg.textContent = 'Photo upload failed. Please try again.'; });
  }

  file.addEventListener('change', function () {
    var f = file.files[0]; if (!f) return;
    msg.textContent = '';
    if (!/^image\//.test(f.type)) { msg.textContent = 'Please choose an image.'; file.value = ''; return; }
    // Pehle purani upload ki hui (post na hui) photo saaf
    var old = idInput.value;
    if (old) fetch('/feed/image/discard', { method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf, 'X-Requested-With': 'fetch' }, body: 'id=' + encodeURIComponent(old) });
    idInput.value = '';

    var img = new Image(), url = URL.createObjectURL(f);
    img.onload = function () {
      // Bari photo ko 1600px tak chhota karo (JPEG): tez upload, kam bandwidth
      function encode(max, q, cb) {
        var s = Math.min(1, max / Math.max(img.width, img.height));
        var c = document.createElement('canvas'); c.width = Math.round(img.width * s); c.height = Math.round(img.height * s);
        var ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        c.toBlob(cb, 'image/jpeg', q);
      }
      encode(1600, 0.85, function (blob) {
        if (blob && blob.size > 1900000) return encode(1280, 0.65, function (b2) { URL.revokeObjectURL(url); b2 ? upload(b2) : (msg.textContent = 'Could not read this image.'); });
        URL.revokeObjectURL(url);
        blob ? upload(blob) : (msg.textContent = 'Could not read this image.');
      });
    };
    img.onerror = function () { URL.revokeObjectURL(url); msg.textContent = 'Could not read this image. Please try a JPG or PNG photo.'; file.value = ''; };
    img.src = url;
  });

  form.addEventListener('submit', function (e) {
    if (busy) { e.preventDefault(); msg.textContent = 'Photo is still uploading...'; return; }
    if (!ta.value.trim() && !idInput.value) { e.preventDefault(); msg.textContent = 'Write something or add a photo first.'; return; }
    postBtn.disabled = true; postBtn.textContent = 'Posting...';
  });
  window.addEventListener('pageshow', function (ev) { if (ev.persisted) { postBtn.disabled = false; postBtn.textContent = 'Post'; } });
})();
</script>

<%- include('partials/footer') %>
