<%- include('partials/header') %>
<%- include('partials/feed-assets') %>

<div class="feed-page">

<section class="feed-hero p-4 p-md-5 mb-4" aria-labelledby="feedTitle">
  <div class="fz-hero-in">
    <% if (user) { %>
      <span class="fz-eyebrow"><span class="live-dot"></span><span id="fzGreet" data-name="<%= user.username %>">Welcome back</span></span>
    <% } else { %>
      <span class="fz-eyebrow"><span class="live-dot"></span>Live community</span>
    <% } %>
    <h1 id="feedTitle">Community <em>Feed</em></h1>
    <p class="fz-lead">Photos, stories and thoughts from real people. Jump in, like, comment and share your day.</p>
    <div class="fz-cta">
      <% if (user) { %>
        <a href="#composer" class="fz-btn light" id="fzWrite">✍️ Share something</a>
        <a href="/groups" class="fz-btn ghost">🫂 Browse groups</a>
      <% } else { %>
        <a href="/signup" class="fz-btn light">Join free →</a>
        <a href="/login" class="fz-btn ghost">Log in</a>
      <% } %>
    </div>
    <div class="fz-pills" aria-hidden="true"><span>📸 Photos</span><span>✨ Stories</span><span>🫂 Groups</span><span>💬 Messages</span></div>
  </div>
  <div class="fz-hero-art" aria-hidden="true">
    <div class="fz-mini m1"><div class="r1"><i class="dot"></i><i class="ln w60" style="flex:1;margin:0"></i></div><i class="ln w85"></i><i class="ln w40"></i><div class="re">❤️ 128 &nbsp; 💬 24</div></div>
    <div class="fz-mini m2"><div class="r1"><i class="dot"></i><i class="ln w40" style="flex:1;margin:0"></i></div><div class="ph"></div><div class="re">❤️ 56 &nbsp; 💬 9</div></div>
  </div>
</section>

<% if (flash.posted) { %><div class="alert alert-success">Posted! 🎉</div><% } %>
<% if (flash.deleted) { %><div class="alert alert-success">Post deleted.</div><% } %>
<% if (flash.reported) { %><div class="alert alert-success">Thanks, your report was sent to the site owner.</div><% } %>
<% if (flash.notice) { %><div class="alert alert-warning"><%= flash.notice %></div><% } %>
<% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

<div class="row g-4">

  <!-- Left: me / join -->
  <aside class="col-lg-3 d-none d-lg-block">
    <div class="feed-side">
      <div class="card border-0 shadow-sm mb-3">
        <% if (user) { %>
          <div class="fz-cover"></div>
          <div class="card-body text-center pt-0">
            <span class="avatar avatar-lg fz-avatar-pull mb-2"><%= user.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(user.username) %>" alt="" onerror="this.remove()"></span>
            <div class="fw-bold text-break fs-5" style="font-family: var(--kz-serif);"><%= user.username %></div>
            <div class="mt-3 text-start">
              <a class="side-link" href="/u/<%= encodeURIComponent(user.username) %>">👤 My profile</a>
              <a class="side-link" href="/?user=<%= encodeURIComponent(user.username) %>">📸 My posts</a>
              <a class="side-link" href="/groups">🫂 Groups</a>
              <a class="side-link" href="/friends">👫 Friends</a>
              <a class="side-link" href="/messages">💬 Messages</a>
              <a class="side-link" href="/settings/profile">✏️ Edit profile</a>
            </div>
          </div>
        <% } else { %>
          <div class="fz-cover"></div>
          <div class="card-body text-center pt-3">
            <div class="fs-1">👋</div>
            <div class="fw-bold mb-1 fs-5" style="font-family: var(--kz-serif);">Join the community</div>
            <p class="small text-body-secondary">Create a free account to post photos, like and comment.</p>
            <a href="/signup" class="btn btn-primary w-100 mb-2 rounded-pill fw-semibold">Sign Up</a>
            <a href="/login" class="btn btn-outline-primary w-100 rounded-pill fw-semibold">Login</a>
          </div>
        <% } %>
      </div>
    </div>
  </aside>

  <!-- Center: composer + posts -->
  <section class="col-12 col-lg-6">

    <% if (user) { %>
      <%- include('partials/stories-tray') %>
      <%- include('partials/composer') %>
    <% } else { %>
      <div class="card border-0 shadow-sm mb-3 fz-teaser"><div class="card-body d-flex align-items-center gap-3">
        <div class="fs-2">📷</div>
        <div class="flex-grow-1"><div class="fw-semibold">Want to share a photo?</div><div class="small text-body-secondary">Log in to post, like and comment.</div></div>
        <a href="/login" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold">Login</a>
      </div></div>
    <% } %>

    <% if (author) { %>
      <div class="alert alert-light border d-flex justify-content-between align-items-center">
        <span>Posts by <a href="/u/<%= encodeURIComponent(author.username) %>" class="fw-semibold"><%= author.username %></a></span>
        <a href="/?tab=all" class="btn btn-sm btn-outline-secondary">✕ Show everyone</a>
      </div>
    <% } else if (user) { %>
      <ul class="nav nav-pills feed-tabs mb-3 gap-1">
        <li class="nav-item"><a class="nav-link <%= tab === 'all' ? 'active' : '' %>" href="/?tab=all">🌍 Everyone</a></li>
        <li class="nav-item"><a class="nav-link <%= tab === 'following' ? 'active' : '' %>" href="/?tab=following">⭐ Following</a></li>
        <li class="nav-item"><a class="nav-link <%= tab === 'groups' ? 'active' : '' %>" href="/?tab=groups">🫂 My Groups</a></li>
      </ul>
    <% } %>

    <div id="feedList"><%- include('partials/feed-cards') %></div>

    <% if (posts.length === 0) { %>
      <div class="card border-0 fz-empty"><div class="card-body text-center text-body-secondary py-5">
        <div class="em mb-2">🌱</div>
        <% if (tab === 'following') { %>
          Nothing here yet. Follow people (or add friends) to see their posts.
        <% } else if (tab === 'groups') { %>
          Nothing here yet. <a href="/groups">Join a group</a> to see its posts here.
        <% } else { %>
          No posts yet. Be the first to share a photo!
        <% } %>
      </div></div>
    <% } %>

    <% if (nextBefore) { %>
      <div class="text-center my-3">
        <button type="button" id="moreBtn" class="btn btn-outline-primary rounded-pill px-5 fz-more"
                data-next="<%= nextBefore %>" data-tab="<%= tab %>" data-user="<%= author ? author.username : '' %>">Load more</button>
      </div>
    <% } %>
  </section>

  <!-- Right: blog + people -->
  <aside class="col-lg-3 d-none d-lg-block">
    <div class="feed-side">
      <% if (latestPosts.length) { %>
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
          <div class="fz-side-title">Latest from the blog</div>
          <% latestPosts.forEach(function (p) { %><a class="side-link small" href="/posts/<%= p.slug %>"><%= p.title %></a><% }) %>
          <a class="side-link small fw-semibold" href="/blog">All blog posts →</a>
        </div></div>
      <% } %>
      <% if (popularGroups && popularGroups.length) { %>
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
          <div class="fz-side-title">Groups</div>
          <% popularGroups.forEach(function (g) { %>
            <a class="side-link d-flex align-items-center gap-2" href="/groups/<%= g.slug %>">
              <span class="fs-5"><%= g.emoji %></span>
              <span class="text-truncate"><%= g.name %><span class="d-block small text-body-secondary"><%= g.members %> member<%= g.members === 1 ? '' : 's' %><%= g.joined ? ' · Joined' : '' %></span></span>
            </a>
          <% }) %>
          <a class="side-link small fw-semibold" href="/groups">All groups →</a>
        </div></div>
      <% } %>
      <% if (people.length) { %>
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
          <div class="fz-side-title">People you may know</div>
          <% people.forEach(function (p) { %>
            <a class="side-link d-flex align-items-center gap-2" href="/u/<%= encodeURIComponent(p.username) %>">
              <span class="avatar avatar-sm"><%= p.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(p.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
              <span class="text-truncate"><%= p.username %><% if (p.mutual > 0) { %><span class="d-block small text-body-secondary"><%= p.mutual %> mutual</span><% } %></span>
            </a>
          <% }) %>
        </div></div>
      <% } %>
    </div>
  </aside>

</div>

<% if (user) { %>
  <a href="#composer" class="fz-fab d-lg-none" id="fzFab" aria-label="Write a post">✍️</a>
<% } %>

</div><%# /.feed-page %>

<%- include('partials/report-modal') %>
<%- include('partials/feed-script') %>
<%- include('partials/load-more', { moreBase: '/' }) %>

<script>
(function () {
  // Time-of-day greeting in the hero
  var g = document.getElementById('fzGreet');
  if (g) {
    var h = new Date().getHours();
    var hi = h < 5 ? 'Still up' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
    g.textContent = hi + ', ' + g.getAttribute('data-name') + ' 👋';
  }
  // "Share something" / floating button: jump to the composer and focus it
  function goWrite(e) {
    var c = document.getElementById('composer'); if (!c) return;
    e.preventDefault();
    c.scrollIntoView({ behavior: 'smooth', block: 'center' });
    var ta = c.querySelector('textarea'); if (ta) setTimeout(function () { ta.focus({ preventScroll: true }); }, 350);
  }
  ['fzWrite', 'fzFab'].forEach(function (id) { var a = document.getElementById(id); if (a) a.addEventListener('click', goWrite); });
  // Hide the floating button while the composer is on screen
  var fab = document.getElementById('fzFab'), comp = document.getElementById('composer');
  if (fab && comp && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (en) { fab.classList.toggle('hide', en[0].isIntersecting); }, { threshold: 0.2 }).observe(comp);
  }
})();
</script>

<%- include('partials/footer') %>
