<%- include('partials/auth-top', { title: 'Sign Up' }) %>

            <h2 class="text-center mb-4">Create Account</h2>

            <% const f = locals.form || {}; %>
            <% if (locals.invitedBy) { %>
              <div class="alert alert-success py-2 text-center">🎉 <strong><%= invitedBy %></strong> invited you to join!</div>
            <% } %>

            <% if (error) { %>
              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>
            <% } %>

            <form action="/signup" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" name="username" placeholder="Username" required>
              </div>

              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
              </div>

              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Kam az kam 8 characters" required minlength="8">
              </div>

              <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Password dobara likhein" required>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-4">
                  <label for="birth_year" class="form-label">Birth year <span class="text-body-secondary small">(optional)</span></label>
                  <input type="number" class="form-control" id="birth_year" name="birth_year" placeholder="2000" min="<%= new Date().getFullYear() - 100 %>" max="<%= new Date().getFullYear() - 13 %>" value="<%= f.birth_year || '' %>">
                </div>
                <div class="col-4">
                  <label for="gender" class="form-label">Gender</label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="">-</option>
                    <% [['male','Male'],['female','Female'],['other','Other']].forEach(g => { %>
                      <option value="<%= g[0] %>" <%= f.gender === g[0] ? 'selected' : '' %>><%= g[1] %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-4">
                  <label for="country" class="form-label">Country</label>
                  <select class="form-select" id="country" name="country">
                    <option value="">-</option>
                    <% (locals.countries || []).forEach(c => { %>
                      <option value="<%= c.code %>" <%= f.country === c.code ? 'selected' : '' %>><%= c.name %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <button type="submit" class="btn btn-primary w-100">Sign Up</button>
            </form>

            <% if (locals.googleEnabled) { %>
            <div class="d-flex align-items-center my-3">
              <hr class="flex-grow-1 m-0"><span class="px-2 text-body-secondary small">ya</span><hr class="flex-grow-1 m-0">
            </div>
            <a href="/auth/google" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
              <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.6 5.9c4.4-4.1 7-10.1 7-17.6z"/><path fill="#FBBC05" d="M10.5 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.9-4.7l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
              Continue with Google
            </a>
            <% } %>

            <p class="text-center text-body-secondary mt-3 mb-0">
              Pehle se account hai? <a href="/login">Login</a>
            </p>

<%- include('partials/auth-bottom') %>
