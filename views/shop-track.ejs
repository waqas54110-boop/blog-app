<%- include('partials/header') %>
<%- include('partials/shop-style') %>

<div style="max-width:460px;margin:0 auto;">
  <h1 class="fs-3 fw-bold mb-1">📦 Find my order</h1>
  <p class="text-body-secondary small">Enter your order number and the phone number you used when ordering. You can find the order number on the order page or in your WhatsApp message (e.g. #123).</p>
  <form action="/track" method="POST" class="sh-card">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
    <label class="form-label small mb-1" for="tId">Order number</label>
    <input class="form-control mb-2" id="tId" name="id" inputmode="numeric" required maxlength="12" value="<%= f.id %>" placeholder="123">
    <label class="form-label small mb-1" for="tPhone">Phone number</label>
    <input class="form-control mb-3" id="tPhone" name="phone" type="tel" inputmode="tel" required maxlength="20" value="<%= f.phone %>" placeholder="0300 1234567">
    <button class="btn btn-success w-100 rounded-pill fw-semibold">Show order</button>
  </form>
</div>

<%- include('partials/footer') %>
