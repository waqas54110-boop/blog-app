<%- include('partials/header') %>

<% const qs = (p) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (category) params.set('category', category);
  if (tag) params.set('tag', tag);
  if (p > 1) params.set('page', p);
  const s = params.toString();
  return '/blog' + (s ? '?' + s : '');
}; %>

<section class="hero p-4 p-md-5 mb-4">
  <h1 class="fw-bold mb-2">Cricket, Code, Creativity &amp; AI</h1>
  <p class="mb-0 opacity-75">Notes and tutorials on cricket, video editing, AI/ML, freelancing and web development.</p>
</section>

<% if (locals.liveContest) { const lc = liveContest; %>
  <section class="card border-0 shadow-sm mb-4" id="live-contest">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h5 class="fw-bold mb-0">🔥 Live now: <%= lc.st.title %></h5>
        <a href="/votes/<%= lc.st.id %>#comments" class="small text-decoration-none">Open contest &amp; comments →</a>
      </div>
      <% if (lc.notice) { %><div class="alert alert-info py-2"><%= lc.notice %></div><% } %>
      <%- include('partials/sponsor-banner', { ex: lc.extras, pollId: lc.st.id }) %>
      <%- include('partials/poll-block', { st: lc.st, compact: true, ret: '/' }) %>
    </div>
  </section>
  <%- include('partials/poll-script') %>
<% } %>

<div class="row g-4">

  <!-- Posts -->
  <div class="col-lg-8">

    <% if (q || category || tag) { %>
      <p class="text-body-secondary">
        <%= totalPosts %> result<%= totalPosts === 1 ? '' : 's' %>
        <% if (q) { %> for "<strong><%= q %></strong>"<% } %>
        <% if (category) { %> in <strong><%= category %></strong><% } %>
        <% if (tag) { %> tagged <strong>#<%= tag %></strong><% } %>
        &middot; <a href="/blog">Clear filters</a>
      </p>
    <% } %>

    <% if (posts.length === 0) { %>
      <div class="text-center py-5">
        <h4 class="text-body-secondary">No posts found</h4>
        <% if (isAdmin) { %>
          <a href="/posts/new" class="btn btn-primary mt-2">Write a post</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% posts.forEach(post => { %>
          <div class="col-12 col-md-6">
            <div class="card post-card h-100 border-0 shadow-sm">
              <% if (post.cover_url) { %>
                <img src="<%= post.cover_url %>" class="card-img-top cover-img" alt="">
              <% } %>
              <div class="card-body d-flex flex-column">
                <span class="badge text-bg-primary align-self-start mb-2"><%= post.category %></span>
                <h5 class="card-title">
                  <a href="/posts/<%= post.slug %>" class="stretched-link text-body"><%= post.title %></a>
                </h5>
                <p class="card-text text-body-secondary flex-grow-1"><%= post.preview %></p>

                <% if (post.tags && post.tags.length) { %>
                  <div class="mb-2">
                    <% post.tags.slice(0, 3).forEach(t => { %>
                      <span class="badge bg-body-secondary text-body-secondary border me-1">#<%= t %></span>
                    <% }) %>
                  </div>
                <% } %>

                <div class="d-flex align-items-center gap-2 mt-2">
                  <span class="avatar"><%= post.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(post.username) %>" alt="" loading="lazy" onerror="this.remove()"></span>
                  <div class="small">
                    <div class="fw-semibold"><%= post.username %></div>
                    <div class="text-body-secondary">
                      <%= new Date(post.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </div>
                  </div>
                </div>

                <div class="small text-body-secondary mt-3 d-flex gap-3">
                  <span><%= post.readingTime %> min read</span>
                  <span><%= post.views %> views</span>
                  <span><%= post.like_count %> likes</span>
                  <span><%= post.comment_count %> comments</span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <% const from = (page - 1) * perPage + 1; const to = Math.min(page * perPage, totalPosts); %>
        <p class="text-center text-body-secondary small mt-5 mb-2">
          Showing <%= from %>&ndash;<%= to %> of <%= totalPosts %> posts
        </p>
        <nav aria-label="Pages">
          <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="<%= qs(page - 1) %>" rel="prev">Previous</a>
            </li>
            <% let last = 0; %>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <% if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) { %>
                <% if (last && i - last > 1) { %>
                  <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                <% } %>
                <li class="page-item <%= i === page ? 'active' : '' %>">
                  <a class="page-link" href="<%= qs(i) %>" <%- i === page ? 'aria-current="page"' : '' %>><%= i %></a>
                </li>
                <% last = i; %>
              <% } %>
            <% } %>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="<%= qs(page + 1) %>" rel="next">Next</a>
            </li>
          </ul>
        </nav>
      <% } %>
    <% } %>
  </div>

  <!-- Sidebar -->
  <aside class="col-lg-4">

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body text-center">
        <span class="avatar mx-auto mb-2" style="width:64px;height:64px;font-size:1.6rem;">W</span>
        <h5 class="mb-1">Waqas</h5>
        <p class="small text-body-secondary mb-3">
          I write about cricket, video editing, AI/ML, freelancing and web development.
        </p>
        <a href="/about" class="btn btn-sm btn-outline-primary">More about me</a>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-transparent fw-semibold">Popular Posts</div>
      <div class="list-group list-group-flush">
        <% if (popular.length === 0) { %>
          <div class="list-group-item text-body-secondary">Nothing yet</div>
        <% } %>
        <% popular.forEach((p, i) => { %>
          <a href="/posts/<%= p.slug %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2">
            <span><strong class="text-primary"><%= i + 1 %>.</strong> <%= p.title %></span>
            <small class="text-body-secondary text-nowrap"><%= p.views %> views</small>
          </a>
        <% }) %>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent fw-semibold">Categories</div>
      <div class="list-group list-group-flush">
        <a href="/blog" class="list-group-item list-group-item-action <%= !category ? 'active' : '' %>">All posts</a>
        <% categories.forEach(c => { %>
          <a href="/blog?category=<%= encodeURIComponent(c.category) %>"
             class="list-group-item list-group-item-action d-flex justify-content-between <%= category === c.category ? 'active' : '' %>">
            <%= c.category %>
            <span class="badge text-bg-secondary"><%= c.total %></span>
          </a>
        <% }) %>
      </div>
    </div>

    <% if (tags && tags.length) { %>
      <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-transparent fw-semibold">Tags</div>
        <div class="card-body d-flex flex-wrap gap-2">
          <% tags.forEach(t => { %>
            <a href="/blog?tag=<%= encodeURIComponent(t.name) %>"
               class="badge <%= tag === t.name ? 'text-bg-primary' : 'text-bg-secondary' %> text-decoration-none">
              #<%= t.name %> <span class="opacity-75">(<%= t.total %>)</span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </aside>
</div>

<%- include('partials/footer') %>