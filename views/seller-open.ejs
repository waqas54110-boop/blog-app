<%- include('partials/header') %>
<%- include('partials/shop-style') %>
<% if (edit) { %><%- include('partials/seller-nav') %><% } %>

<div style="max-width:720px;margin:0 auto;">
  <% if (!edit) { %>
    <div class="text-center py-3">
      <div style="font-size:3rem;">🏪</div>
      <h1 class="fw-bold fs-3">Open shop</h1>
      <p class="text-body-secondary">Create your own online shop, add products, and start selling!</p>
      <% if (approval) { %><div class="alert alert-info py-2 small">Your shop is pending approval.</div><% } %>
    </div>
  <% } %>

  <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>

  <form action="<%= edit ? '/seller/settings' : '/seller/open' %>" method="POST" class="sh-card" id="shopForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-3">
      <label class="form-label" for="sName">Shop Name</label>
      <input class="form-control" id="sName" name="name" required maxlength="80" value="<%= f.name %>" placeholder="Jaise: Ali Fashion Store">
      <% if (edit) { %>
        <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="rename_link" value="1" id="rn"><label class="form-check-label small" for="rn">When renaming, also update the shop link (the old link will stop working)</label></div>
      <% } %>
    </div>
    <div class="mb-3">
      <label class="form-label" for="sTag">Tagline <span class="text-body-secondary">(optional)</span></label>
      <input class="form-control" id="sTag" name="tagline" maxlength="140" value="<%= f.tagline %>" placeholder="Jaise: Asli leather, sasti qeemat">
    </div>
    <div class="mb-3">
      <label class="form-label" for="sDesc">Shop Description <span class="text-body-secondary">(optional)</span></label>
      <textarea class="form-control" id="sDesc" name="description" rows="3" maxlength="1500"><%= f.description %></textarea>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-12 col-sm-4"><label class="form-label" for="sCity">City</label><input class="form-control" id="sCity" name="city" required maxlength="60" value="<%= f.city %>" placeholder="Lahore"></div>
      <div class="col-12 col-sm-4"><label class="form-label" for="sWa">WhatsApp Number</label><input class="form-control" id="sWa" name="whatsapp" type="tel" required maxlength="20" value="<%= f.whatsapp %>" placeholder="0300 1234567"></div>
      <div class="col-12 col-sm-4"><label class="form-label" for="sPh">Phone <span class="text-body-secondary">(optional)</span></label><input class="form-control" id="sPh" name="phone" type="tel" maxlength="20" value="<%= f.phone %>" placeholder="0300 1234567"></div>
    </div>

    <div class="mb-3">
      <div class="form-label">Order Collection Methods</div>
      <div class="form-check"><input class="form-check-input" type="checkbox" name="cod" value="1" id="sCod" <%= f.cod ? 'checked' : '' %>><label class="form-check-label" for="sCod">🚚 Cash on Delivery</label></div>
      <div class="form-check"><input class="form-check-input" type="checkbox" name="wa" value="1" id="sWaOn" <%= f.wa ? 'checked' : '' %>><label class="form-check-label" for="sWaOn">💬 WhatsApp par order bhejna</label></div>
      <div class="form-text">
Online payments (JazzCash, Easypaisa, and cards) will be available later, as they require a separate account and payment gateway integration.</div>
    </div>

    <div class="row g-2 mb-3">
      <div class="col-12 col-sm-6"><label class="form-label" for="sFee">Delivery charges (Rs)</label><input class="form-control" id="sFee" name="delivery_fee" inputmode="numeric" maxlength="8" value="<%= f.delivery_fee %>" placeholder="0 = free"></div>
      <div class="col-12 col-sm-6"><label class="form-label" for="sFree">Items above this amount are free (Rs) <span class="text-body-secondary">(optional)</span></label><input class="form-control" id="sFree" name="free_over" inputmode="numeric" maxlength="8" value="<%= f.free_over %>" placeholder="Jaise 3000"></div>
    </div>

    <div class="mb-3">
      <div class="form-label">Shop ka logo <span class="text-body-secondary">(optional)</span></div>
      <%- include('partials/shop-photos', { pf_name: 'logo_ids', pf_max: 1, pf_ids: f.logo ? [f.logo] : [] }) %>
    </div>

    <button class="btn btn-success btn-lg rounded-pill px-4" type="submit"><%= edit ? 'Save karo' : 'Shop banao' %></button>
    <a href="<%= edit ? '/seller' : '/shop' %>" class="btn btn-outline-secondary rounded-pill ms-1">Cancel</a>
  </form>
</div>

<%- include('partials/footer') %>
