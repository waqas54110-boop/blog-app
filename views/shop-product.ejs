<%- include('partials/header') %>
<%- include('partials/shop-style') %>

<%
  const _off = (product.compare_price_rs && product.compare_price_rs > product.price_rs) ? Math.round((product.compare_price_rs - product.price_rs) * 100 / product.compare_price_rs) : 0;
  const _maxQty = Math.max(1, Math.min(MAX_QTY, product.stock));
  const _publicOk = product.is_active && shop.status === 'active';
%>

<% if (!_publicOk) { %>
  <div class="alert alert-warning py-2">Ye product abhi public nahi (<%= !product.is_active ? 'chhupa hua' : 'shop band / review mein' %>). Sirf aap ko nazar aa raha hai.</div>
<% } %>

<nav class="small mb-2"><a href="/shop" class="text-decoration-none">Shop</a> › <a href="/shop/<%= shop.slug %>" class="text-decoration-none"><%= shop.name %></a></nav>

<div class="row g-4">
  <!-- Photos -->
  <div class="col-12 col-md-6">
    <div class="position-relative" style="border-radius:1rem;overflow:hidden;background:var(--bs-tertiary-bg);aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;font-size:4rem;">
      <% if (images.length) { %><img id="mainImg" src="/img/<%= images[0] %>" alt="<%= product.name %>" style="width:100%;height:100%;object-fit:contain;<%= soldOut ? 'filter:grayscale(1);opacity:.6;' : '' %>"><% } else { %>🛍️<% } %>
      <% if (soldOut) { %><span class="sh-badge" style="font-size:.9rem;">Sold out</span><% } else if (_off > 0) { %><span class="sh-badge off" style="font-size:.9rem;"><%= _off %>% off</span><% } %>
    </div>
    <% if (images.length > 1) { %>
      <div class="d-flex gap-2 mt-2 flex-wrap">
        <% images.forEach((id, i) => { %>
          <img src="/img/<%= id %>" alt="" data-full="/img/<%= id %>" class="thumb" style="width:64px;height:64px;object-fit:cover;border-radius:10px;cursor:pointer;border:2px solid <%= i === 0 ? '#12a37f' : 'transparent' %>;">
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Details -->
  <div class="col-12 col-md-6">
    <h1 class="fs-3 fw-bold mb-1"><%= product.name %></h1>
    <div class="mb-2">
      <span class="fs-3 fw-bold" style="color:#12a37f;">Rs <%= rs(product.price_rs) %></span>
      <% if (_off > 0) { %><span class="text-decoration-line-through text-body-secondary ms-2">Rs <%= rs(product.compare_price_rs) %></span><% } %>
    </div>
    <div class="mb-3">
      <% if (soldOut) { %>
        <span class="badge text-bg-danger fs-6">Sold out</span>
      <% } else if (lastStock) { %>
        <span class="badge text-bg-warning fs-6">Sirf <%= product.stock %> bache hain</span>
      <% } else { %>
        <span class="badge text-bg-success fs-6">Stock mein hai</span>
      <% } %>
      <% if (product.category) { %><span class="badge text-bg-light border ms-1"><%= product.category %></span><% } %>
    </div>

    <% const _wall = locals.shopWall === true; %>
    <% if (product.description) { %>
      <h2 class="fs-6 fw-bold">Tafseel</h2>
      <% if (_wall && locals.wallDesc) { %>
        <p style="white-space:pre-line;<%= wallDesc.cut ? '-webkit-mask-image:linear-gradient(#000 55%,transparent);mask-image:linear-gradient(#000 55%,transparent);' : '' %>" class="mb-1"><%= wallDesc.text %></p>
        <% if (wallDesc.cut) { %><div class="small fw-semibold mb-3" style="color:#12a37f;">🔒 Baqi tafseel dekhne ke liye neeche signup karo</div><% } %>
      <% } else { %>
        <p style="white-space:pre-line;"><%= product.description %></p>
      <% } %>
    <% } %>

    <div class="sh-card">
      <div class="d-flex align-items-center gap-2">
        <% if (shop.logo_image_id) { %><img class="sh-logo" style="width:44px;height:44px;" src="/img/<%= shop.logo_image_id %>" alt=""><% } else { %><span class="sh-logo" style="width:44px;height:44px;font-size:1.2rem;">🏪</span><% } %>
        <div class="flex-grow-1 min-w-0">
          <a href="/shop/<%= shop.slug %>" class="fw-bold text-decoration-none text-body"><%= shop.name %></a>
          <div class="sh-stat"><%= shop.city ? '📍 ' + shop.city + ' · ' : '' %><%= shop.delivery_fee_rs > 0 ? 'Delivery Rs ' + rs(shop.delivery_fee_rs) + (shop.free_over_rs ? ' (Rs ' + rs(shop.free_over_rs) + ' se upar free)' : '') : 'Delivery free' %></div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <a class="btn btn-sm btn-outline-success rounded-pill" target="_blank" rel="noopener noreferrer" href="https://wa.me/?text=<%= encodeURIComponent(product.name + ' - Rs ' + rs(product.price_rs) + '\n' + shareUrl) %>">📤 WhatsApp par share</a>
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" id="copyLink" data-url="<%= shareUrl %>">🔗 Link copy</button>
      <% if (mine) { %><a class="btn btn-sm btn-outline-primary rounded-pill" href="/seller/products/<%= product.id %>/edit">✏️ Edit</a><a class="btn btn-sm rounded-pill fw-semibold" style="background:#fbbf24;color:#111;" href="/shop/<%= shop.slug %>/<%= product.slug %>/tiktok">🎬 TikTok video</a><% } %>
    </div>
  </div>
</div>

<% if (_wall) { %>
<div class="sh-card mt-4 text-center" id="order" style="max-width:720px;border:2px solid #12a37f;padding:1.5rem;">
  <div style="font-size:2.2rem;">🔒</div>
  <h2 class="fs-5 fw-bold mb-1">Poori tafseel aur order ke liye signup kar lo</h2>
  <p class="small text-body-secondary mb-3">Account free hai aur 30 second mein ban jata hai. Signup ke baad aap isi product par wapas aa jayenge, aur order ki tracking, price / stock ki khabar bhi milegi.</p>
  <a href="/signup" class="btn btn-success btn-lg rounded-pill fw-semibold px-4">Signup karo (free)</a>
  <a href="/login" class="btn btn-outline-secondary btn-lg rounded-pill ms-1">Login</a>
</div>
<% } else { %>
<% if (!locals.user && _publicOk && !soldOut) { %>
<div class="sh-card mt-4" style="max-width:720px;border-color:#12a37f;">
  <b>🔔 Account banayein (free, 1 minute)</b>
  <p class="small text-body-secondary mb-2">Order ki tracking, aur is product ki price / stock ki khabar aap ko notification mein mil jayegi. Order ke liye account zaroori nahi.</p>
  <a href="/signup" class="btn btn-sm btn-success">Sign up</a> <a href="/login" class="btn btn-sm btn-outline-secondary">Login</a>
</div>
<% } %>

<!-- Order -->
<div class="sh-card mt-4" id="order" style="max-width:720px;">
  <h2 class="sh-h">🛒 Abhi order karo</h2>

  <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>

  <% if (soldOut) { %>
    <div class="alert alert-secondary mb-0">Ye product abhi <b>Sold out</b> hai. Dobara stock aane par order ho sakega<% if (shop.whatsapp) { %> ya <a target="_blank" rel="noopener noreferrer" href="https://wa.me/<%= shop.whatsapp %>?text=<%= encodeURIComponent(product.name + ' kab dobara available hoga?') %>">shop se WhatsApp par poochein</a><% } %>.</div>
  <% } else if (!_publicOk) { %>
    <div class="alert alert-secondary mb-0">Product public hone par yahan order form chalega.</div>
  <% } else { %>
    <form action="/order" method="POST" id="orderForm" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="product_id" value="<%= product.id %>">
      <div style="position:absolute;left:-9999px;" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>

      <div class="row g-2">
        <div class="col-12 col-sm-8">
          <label class="form-label small mb-1" for="fName">Aap ka naam</label>
          <input class="form-control" id="fName" name="name" required maxlength="80" autocomplete="name" value="<%= f.name %>" placeholder="Poora naam">
        </div>
        <div class="col-12 col-sm-4">
          <label class="form-label small mb-1" for="fQty">Quantity</label>
          <select class="form-select" id="fQty" name="qty">
            <% for (let i = 1; i <= _maxQty; i++) { %><option value="<%= i %>" <%= Number(f.qty) === i ? 'selected' : '' %>><%= i %></option><% } %>
          </select>
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label small mb-1" for="fPhone">Phone (WhatsApp wala behtar)</label>
          <input class="form-control" id="fPhone" name="phone" type="tel" inputmode="tel" required maxlength="20" autocomplete="tel" value="<%= f.phone %>" placeholder="0300 1234567">
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label small mb-1" for="fCity">Shehar</label>
          <input class="form-control" id="fCity" name="city" required maxlength="60" autocomplete="address-level2" value="<%= f.city %>" placeholder="Lahore">
        </div>
        <div class="col-12">
          <label class="form-label small mb-1" for="fAddr">Poora pata</label>
          <textarea class="form-control" id="fAddr" name="address" rows="2" required maxlength="300" autocomplete="street-address" placeholder="Ghar / gali / mohalla / area"><%= f.address %></textarea>
        </div>
        <div class="col-12">
          <label class="form-label small mb-1" for="fNote">Note <span class="text-body-secondary">(optional: rang, size wagaira)</span></label>
          <input class="form-control" id="fNote" name="note" maxlength="300" value="<%= f.note %>">
        </div>
      </div>

      <div class="mt-3">
        <div class="small fw-semibold mb-1">Order kaise karein?</div>
        <% if (shop.cod_enabled) { %>
          <label class="d-flex align-items-start gap-2 p-2 border rounded-3 mb-2" style="cursor:pointer;">
            <input class="form-check-input mt-1" type="radio" name="method" value="cod" <%= f.method === 'cod' || !(shop.wa_enabled && shop.whatsapp) ? 'checked' : '' %>>
            <span><b>🚚 Cash on Delivery</b><br><span class="sh-stat">Saman aap ke ghar pahunche, tab paisay dein.</span></span>
          </label>
        <% } %>
        <% if (shop.wa_enabled && shop.whatsapp) { %>
          <label class="d-flex align-items-start gap-2 p-2 border rounded-3 mb-2" style="cursor:pointer;">
            <input class="form-check-input mt-1" type="radio" name="method" value="whatsapp" <%= f.method === 'whatsapp' || !shop.cod_enabled ? 'checked' : '' %>>
            <span><b>💬 WhatsApp par order bhejo</b><br><span class="sh-stat">Order save hoga aur WhatsApp seller ko tayyar message ke saath khulega. Payment seller se tay karein.</span></span>
          </label>
        <% } %>
      </div>

      <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
        <div class="small">
          Saman: <b id="sumItems">Rs <%= rs(product.price_rs) %></b><br>
          Delivery: <b id="sumDel"><%= delivery > 0 ? 'Rs ' + rs(delivery) : 'Free' %></b>
        </div>
        <div class="text-end"><div class="sh-stat">Kul</div><div class="fs-4 fw-bold" style="color:#12a37f;" id="sumTotal">Rs <%= rs(product.price_rs + delivery) %></div></div>
      </div>
      <button class="btn btn-success btn-lg w-100 rounded-pill mt-2 fw-semibold" id="orderBtn" type="submit">Order confirm karo</button>
      <div class="sh-stat text-center mt-2">Order dene se pehle seller aap ko phone / WhatsApp par confirm kar sakta hai.</div>
    </form>
  <% } %>
</div>

<% } %>

<% if (related.length) { %>
  <h2 class="fs-5 fw-bold mt-4">Is shop ke aur products</h2>
  <div class="sh-grid mb-4">
    <% related.forEach(pr => { %><%- include('partials/shop-item', { pr: pr, hideShop: true }) %><% }) %>
  </div>
<% } %>

<script>
(function () {
  var main = document.getElementById('mainImg');
  document.querySelectorAll('.thumb').forEach(function (t) {
    t.addEventListener('click', function () {
      if (main) main.src = t.getAttribute('data-full');
      document.querySelectorAll('.thumb').forEach(function (x) { x.style.borderColor = 'transparent'; });
      t.style.borderColor = '#12a37f';
    });
  });
  var cp = document.getElementById('copyLink');
  if (cp) cp.addEventListener('click', function () {
    var u = cp.getAttribute('data-url');
    function done() { var o = cp.textContent; cp.textContent = '✓ Copy ho gaya'; setTimeout(function () { cp.textContent = o; }, 1400); }
    if (navigator.clipboard) navigator.clipboard.writeText(u).then(done, function () {}); else { var ta = document.createElement('textarea'); ta.value = u; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } catch (e) {} ta.remove(); }
  });

  var form = document.getElementById('orderForm');
  if (!form) return;
  var price = <%- product.price_rs %>, fee = <%- shop.delivery_fee_rs || 0 %>, freeOver = <%- shop.free_over_rs || 0 %>;
  var qty = document.getElementById('fQty');
  function fmt(n) { return 'Rs ' + n.toLocaleString('en-PK'); }
  function calc() {
    var q = parseInt(qty.value, 10) || 1, sub = price * q, del = (freeOver && sub >= freeOver) ? 0 : fee;
    document.getElementById('sumItems').textContent = fmt(sub) + (q > 1 ? ' (' + q + ' x ' + price.toLocaleString('en-PK') + ')' : '');
    document.getElementById('sumDel').textContent = del ? fmt(del) : 'Free';
    document.getElementById('sumTotal').textContent = fmt(sub + del);
  }
  qty.addEventListener('change', calc); calc();
  var btn = document.getElementById('orderBtn');
  form.addEventListener('submit', function () { btn.disabled = true; btn.textContent = 'Order ja raha hai...'; });
  window.addEventListener('pageshow', function (ev) { if (ev.persisted) { btn.disabled = false; btn.textContent = 'Order confirm karo'; } });
  <% if (error) { %>document.getElementById('order').scrollIntoView();<% } %>
})();
</script>

<% if (!locals.user && _publicOk && !soldOut && !_wall) { %>
<div id="watchSheet" class="d-none" style="position:fixed;left:0;right:0;bottom:0;z-index:1050;padding:.75rem;pointer-events:none;">
  <div class="sh-card mx-auto shadow-lg" style="max-width:520px;pointer-events:auto;border:2px solid #12a37f;background:var(--bs-body-bg);">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <b>🔔 Is product ki khabar chahiye?</b>
      <button type="button" id="watchX" class="btn-close" aria-label="Close"></button>
    </div>
    <p class="small text-body-secondary my-2" id="watchTxt">Price, stock ya offer ki khabar seedha aap ke phone par aa jayegi. Signup ki zaroorat nahi.</p>
    <div class="d-flex gap-2 flex-wrap">
      <button type="button" id="watchYes" class="btn btn-success btn-sm rounded-pill fw-semibold">Haan, khabar do</button>
      <a href="/signup" id="watchSignup" class="btn btn-outline-secondary btn-sm rounded-pill">Account banao</a>
    </div>
  </div>
</div>
<script>
(function () {
  var PID = <%- Number(product.id) %>, NAME = <%- JSON.stringify(String(product.name || '')) %>, csrf = <%- JSON.stringify(csrfToken || '') %>;
  var sheet = document.getElementById('watchSheet'); if (!sheet) return;
  var KEY = 'pw_' + PID, OFF = 'pw_off';
  function ls(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) {} }
  var offUntil = parseInt(ls(OFF) || '0', 10);
  if (ls(KEY) === 'done' || Date.now() < offUntil) return;
  var canPush = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
  function bytes(b64) { var pad = '='.repeat((4 - (b64.length % 4)) % 4), raw = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/')), o = new Uint8Array(raw.length); for (var i = 0; i < raw.length; i++) o[i] = raw.charCodeAt(i); return o; }
  function send(sub) {
    var body = sub.toJSON(); body.product_id = PID;
    return fetch('/push/watch', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf }, body: JSON.stringify(body) });
  }
  function hide(days) { sheet.classList.add('d-none'); ls(OFF, String(Date.now() + days * 86400000)); }
  function show() {
    if (!canPush) { document.getElementById('watchYes').classList.add('d-none'); document.getElementById('watchTxt').textContent = 'Account banao (free): order ki tracking aur is product ki price / stock ki khabar notification mein milegi.'; }
    sheet.classList.remove('d-none');
  }
  document.getElementById('watchX').addEventListener('click', function () { hide(3); });
  document.getElementById('watchYes').addEventListener('click', function () {
    var btn = this; btn.disabled = true;
    Promise.all([navigator.serviceWorker.ready, fetch('/push/key').then(function (r) { return r.ok ? r.json() : null; })]).then(function (res) {
      var reg = res[0], k = res[1];
      if (!k || !k.key) throw new Error('nopush');
      return Notification.requestPermission().then(function (perm) {
        if (perm !== 'granted') { document.getElementById('watchTxt').textContent = 'Notification block hai. Browser settings mein allow karo, ya account bana lo.'; btn.classList.add('d-none'); return; }
        return reg.pushManager.getSubscription().then(function (s) { return s || reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: bytes(k.key) }); })
          .then(function (s) { return send(s); })
          .then(function (r) {
            if (!r.ok) throw new Error('save');
            ls(KEY, 'done');
            document.getElementById('watchTxt').textContent = 'Ho gaya! Is product ki khabar aap ko notification mein milegi.';
            btn.classList.add('d-none'); document.getElementById('watchSignup').classList.add('d-none');
            try { reg.showNotification('✅ ' + NAME, { body: 'Ab is product ki khabar aap ko yahin milegi.', data: { url: location.pathname } }); } catch (e) {}
            setTimeout(function () { sheet.classList.add('d-none'); }, 3500);
          });
      });
    }).catch(function () { document.getElementById('watchTxt').textContent = 'Abhi notification on nahi ho saki. Account bana lo, usse bhi khabar milegi.'; btn.classList.add('d-none'); });
  });
  var t = setTimeout(show, 7000);
  window.addEventListener('pageshow', function (ev) { if (ev.persisted) clearTimeout(t); });
})();
</script>
<% } %>

<%- include('partials/footer') %>
