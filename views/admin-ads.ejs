<%- include('partials/header') %>

<% const fmt = (d) => new Date(d).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }); %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 fw-bold mb-0">📣 Ads admin</h1>
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

<% if (msg) { %><div class="alert alert-success" role="status"><%= msg %></div><% } %>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-body-secondary">Fixed packages paid</div><div class="fs-5 fw-bold">Rs <%= totals.fixed_rs.toLocaleString('en-PK') %></div></div></div></div>
  <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-body-secondary">Wallet top-ups</div><div class="fs-5 fw-bold">Rs <%= totals.topup_rs.toLocaleString('en-PK') %></div></div></div></div>
  <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-body-secondary">Waiting for review</div><div class="fs-5 fw-bold"><%= pending.length %></div></div></div></div>
  <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-body-secondary">Running now</div><div class="fs-5 fw-bold"><%= active.length %></div></div></div></div>
</div>

<h2 class="h5 mb-2">Wallet top-ups to confirm <% if (topups.length) { %><span class="badge bg-danger"><%= topups.length %></span><% } %></h2>
<p class="small text-body-secondary">Check your JazzCash / Easypaisa app first. Approve only if the money has really arrived and the transaction ID matches.</p>
<% if (!topups.length) { %><div class="text-body-secondary mb-4">No top-ups waiting.</div><% } %>
<% topups.forEach(t => { %>
  <div class="card border-0 shadow-sm mb-2"><div class="card-body d-flex flex-wrap align-items-center gap-2">
    <span class="fs-5 fw-bold">Rs <%= t.amount_rs.toLocaleString('en-PK') %></span>
    <span class="badge text-bg-secondary"><%= t.method %></span>
    <span class="small">Txn: <strong class="text-break"><%= t.txn_ref %></strong></span>
    <span class="small text-body-secondary">by <a href="/u/<%= encodeURIComponent(t.username) %>"><%= t.username %></a> &middot; <%= fmt(t.created_at) %></span>
    <span class="ms-auto d-flex gap-2">
      <form action="/admin/ads/topups/<%= t.id %>/approve" method="POST" class="mb-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-success btn-sm" onclick="return confirm('Did Rs <%= t.amount_rs %> arrive?')">Approve</button></form>
      <form action="/admin/ads/topups/<%= t.id %>/reject" method="POST" class="mb-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger btn-sm">Reject</button></form>
    </span>
  </div></div>
<% }) %>

<h2 class="h5 mt-4 mb-2">Waiting for review <% if (pending.length) { %><span class="badge bg-danger"><%= pending.length %></span><% } %></h2>
<% if (!pending.length) { %><div class="text-body-secondary mb-3">Nothing to review. 🎉</div><% } %>
<% pending.forEach(a => { %><%- include('partials/admin-ad-row', { a, mode: 'pending', rs, KIND_LABEL }) %><% }) %>

<h2 class="h5 mt-4 mb-2">Approved, waiting for payment</h2>
<% if (!awaiting.length) { %><div class="text-body-secondary mb-3">None.</div><% } %>
<% awaiting.forEach(a => { %><%- include('partials/admin-ad-row', { a, mode: 'awaiting', rs, KIND_LABEL }) %><% }) %>

<h2 class="h5 mt-4 mb-2">Running and paused</h2>
<% if (!active.length) { %><div class="text-body-secondary mb-3">None.</div><% } %>
<% active.forEach(a => { %><%- include('partials/admin-ad-row', { a, mode: 'live', rs, KIND_LABEL }) %><% }) %>

<h2 class="h5 mt-4 mb-2">Recently finished or rejected</h2>
<% if (!recent.length) { %><div class="text-body-secondary mb-3">None.</div><% } %>
<% recent.forEach(a => { %><%- include('partials/admin-ad-row', { a, mode: 'done', rs, KIND_LABEL }) %><% }) %>

<%- include('partials/footer') %>
