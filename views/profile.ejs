<%- include('partials/header') %>

<% const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); %>
<% const link = '/u/' + encodeURIComponent(profile.username); %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">

    <% if (followMsg) { %><div class="alert alert-success"><%= followMsg %></div><% } %>
    <% if (locals.reportedFlash) { %><div class="alert alert-success">Thanks, your report was sent to the site owner.</div><% } %>

    <!-- Header card -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center gap-3">
          <span class="avatar" style="width:72px;height:72px;font-size:2rem;"><%= profile.username.charAt(0).toUpperCase() %><img src="/a/<%= encodeURIComponent(profile.username) %><%= avatarVer ? '?v=' + avatarVer : '' %>" alt="" onerror="this.remove()"></span>
          <div class="flex-grow-1">
            <h1 class="h3 fw-bold mb-1"><%= profile.username %>
              <% if (profile.role === 'admin') { %><span class="badge text-bg-primary align-middle fs-6">Owner</span><% } %>
            </h1>
            <div class="text-body-secondary">Member since <%= fmt(profile.created_at) %></div>
            <% if (userLocation) { %><div class="text-body-secondary small">📍 <%= userLocation %></div><% } %>
            <% if (bio) { %><p class="mt-2 mb-1" style="white-space: pre-line;"><%= bio %></p><% } %>
            <div class="mt-1">
              <strong><%= stats.followers %></strong> <span class="text-body-secondary">follower<%= stats.followers === 1 ? '' : 's' %></span>
              <span class="text-body-secondary mx-1">·</span>
              <strong><%= stats.following %></strong> <span class="text-body-secondary">following</span>
              <span class="text-body-secondary mx-1">·</span>
              <a href="/?user=<%= encodeURIComponent(profile.username) %>" class="text-reset text-decoration-none"><strong><%= locals.feedCount || 0 %></strong> <span class="text-body-secondary">post<%= (locals.feedCount || 0) === 1 ? '' : 's' %></span></a>
            </div>
            <% if (mutual && mutual.count > 0) { %>
              <div class="small text-body-secondary mt-1">
                👥 <strong><%= mutual.count %></strong> mutual friend<%= mutual.count === 1 ? '' : 's' %>:
                <% mutual.list.forEach((m, i) => { %><a href="/u/<%= encodeURIComponent(m.username) %>" class="text-reset"><%= m.username %></a><%= i < mutual.list.length - 1 ? ', ' : '' %><% }) %><% if (mutual.count > mutual.list.length) { %> and <%= mutual.count - mutual.list.length %> more<% } %>
              </div>
            <% } %>
          </div>

          <div class="d-flex flex-column align-items-end gap-2">
            <% if (isMe) { %>
              <a href="/settings/profile" class="btn btn-outline-primary">✏️ Edit profile</a>
              <a href="/invite" class="btn btn-primary">🎁 Invite friends</a>
              <div class="d-flex align-items-center gap-2">
                <input type="file" id="avatarFile" accept="image/*" class="d-none">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="avatarBtn">📷 <%= avatarVer ? 'Change photo' : 'Add photo' %></button>
                <% if (avatarVer) { %>
                  <form action="/avatar/remove" method="POST" class="mb-0" onsubmit="return confirm('Remove your profile photo?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-link text-danger text-decoration-none p-0">Remove</button>
                  </form>
                <% } %>
              </div>
              <div class="small text-danger" id="avatarMsg"></div>
            <% } else if (user && blockState === 'by_me') { %>
              <form action="/friends/unblock/<%= encodeURIComponent(profile.username) %>" method="POST" class="mb-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="ret" value="<%= link %>">
                <button class="btn btn-outline-secondary">⛔ Blocked · Unblock</button>
              </form>
            <% } else if (user && blockState === 'me') { %>
              <span class="text-body-secondary small">Not available</span>
            <% } else if (!user) { %>
              <a href="/login" class="btn btn-primary">➕ Follow</a>
            <% } else if (isFollowing) { %>
              <form action="<%= link %>/unfollow" method="POST" class="mb-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-outline-secondary">✓ Following</button>
              </form>
              <form action="<%= link %>/follow-email" method="POST" class="mb-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-link btn-sm p-0 text-decoration-none"><%= notifyEmail ? '📧 Email alerts: on (turn off)' : '📧 Email alerts: off (turn on)' %></button>
              </form>
            <% } else { %>
              <form action="<%= link %>/follow" method="POST" class="mb-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-primary">➕ Follow</button>
              </form>
            <% } %>
            <% if (user && !isMe && blockState === 'none') { %>
              <% const fAct = (a, label, cls) => `<form action="/friends/${a}/${encodeURIComponent(profile.username)}" method="POST" class="mb-0 d-inline"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="ret" value="${link}"><button class="btn ${cls}">${label}</button></form>`; %>
              <% if (friendState === 'none') { %><%- fAct('request', '👋 Add friend', 'btn-outline-primary') %>
              <% } else if (friendState === 'sent') { %><div class="d-flex align-items-center gap-2"><span class="text-body-secondary small">Request sent</span><%- fAct('decline', 'Cancel', 'btn-outline-secondary btn-sm') %></div>
              <% } else if (friendState === 'received') { %><div class="d-flex gap-2"><%- fAct('accept', 'Accept request', 'btn-success') %><%- fAct('decline', 'Decline', 'btn-outline-secondary') %></div>
              <% } else { %><div class="d-flex align-items-center gap-2"><a href="/messages/<%= encodeURIComponent(profile.username) %>" class="btn btn-primary">💬 Message</a><span class="badge text-bg-success">✓ Friends</span><%- fAct('remove', 'Unfriend', 'btn-link btn-sm text-danger text-decoration-none') %></div>
              <% } %>
              <div class="dropdown">
                <button class="btn btn-sm btn-link text-body-secondary text-decoration-none p-0" data-bs-toggle="dropdown" aria-expanded="false">⋯ More</button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#reportModal" data-report-type="user" data-report-id="<%= profile.id %>">🚩 Report user</button></li>
                  <li>
                    <form action="/friends/block/<%= encodeURIComponent(profile.username) %>" method="POST" class="mb-0"
                          onsubmit="return confirm('Block this user? You will stop being friends and they cannot message you.')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="ret" value="<%= link %>">
                      <button class="dropdown-item text-danger">⛔ Block user</button>
                    </form>
                  </li>
                </ul>
              </div>
            <% } %>
          </div>
        </div>

        <% if (badges.length) { %>
          <hr>
          <div class="d-flex flex-wrap gap-2">
            <% badges.forEach(b => { %>
              <span class="badge rounded-pill text-bg-light border fs-6 fw-normal" title="<%= b.desc %>"><%= b.icon %> <%= b.name %></span>
            <% }) %>
          </div>
        <% } else { %>
          <hr><div class="text-body-secondary small">No badges yet. Vote, predict and comment to earn them!</div>
        <% } %>
      </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
      <% [
        ['League rank', stats.rank ? '#' + stats.rank : '–', stats.rank ? 'of ' + stats.ranked + ' players' : 'no scored predictions'],
        ['Prediction points', stats.pts, stats.correct + '/' + stats.played + ' correct'],
        ['Contest votes', stats.votes, ''],
        ['Comments', stats.comments, '']
      ].forEach(s => { %>
        <div class="col-6 col-md-3">
          <div class="card border-0 shadow-sm text-center h-100"><div class="card-body">
            <div class="h2 fw-bold text-primary mb-0"><%= s[1] %></div>
            <div class="text-body-secondary"><%= s[0] %></div>
            <% if (s[2]) { %><div class="small text-body-secondary"><%= s[2] %></div><% } %>
          </div></div>
        </div>
      <% }) %>
    </div>

    <!-- Created by this user (owner) -->
    <% if (posts.length || polls.length) { %>
      <div class="row g-3 mb-4">
        <% if (posts.length) { %>
          <div class="col-12 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h5 class="mb-3">📝 Latest posts</h5>
            <% posts.forEach(p => { %>
              <div class="mb-2"><a href="/posts/<%= p.slug %>" class="text-decoration-none"><%= p.title %></a>
                <div class="small text-body-secondary"><%= fmt(p.publish_at) %></div></div>
            <% }) %>
          </div></div></div>
        <% } %>
        <% if (polls.length) { %>
          <div class="col-12 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h5 class="mb-3">🗳️ Latest contests</h5>
            <% polls.forEach(p => { %>
              <div class="mb-2"><a href="/votes/<%= p.id %>" class="text-decoration-none"><%= p.title %></a>
                <div class="small text-body-secondary"><%= fmt(p.created_at) %></div></div>
            <% }) %>
          </div></div></div>
        <% } %>
      </div>
    <% } %>

    <div class="row g-3">
      <!-- Votes -->
      <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
          <h5 class="mb-3">🗳️ Recent votes</h5>
          <% if (votes.length === 0) { %>
            <p class="text-body-secondary mb-0">No votes yet.</p>
          <% } else { %>
            <div class="list-group list-group-flush">
              <% votes.forEach(v => { %>
                <a href="/votes/<%= v.poll_id %>" class="list-group-item list-group-item-action px-0">
                  <div class="fw-semibold text-truncate"><%= v.title %></div>
                  <div class="small text-body-secondary">Voted for <strong class="text-body"><%= v.option_name %></strong> · <%= fmt(v.created_at) %></div>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div></div>
      </div>

      <!-- Predictions -->
      <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
          <h5 class="mb-3">🎯 Predictions</h5>
          <% if (predictions.length === 0) { %>
            <p class="text-body-secondary mb-0">No predictions to show yet. Picks for matches that have not started stay private.</p>
          <% } else { %>
            <div class="list-group list-group-flush">
              <% predictions.forEach(p => {
                   const pickName = p.pick === 'draw' ? 'Draw' : (p.pick === 'a' ? p.team_a : p.team_b); %>
                <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                  <div class="overflow-hidden">
                    <div class="fw-semibold text-truncate"><%= p.team_a %> vs <%= p.team_b %></div>
                    <div class="small text-body-secondary">Picked <strong class="text-body"><%= pickName %></strong></div>
                  </div>
                  <% if (!p.winner) { %><span class="badge text-bg-secondary">Pending</span>
                  <% } else if (p.points > 0) { %><span class="badge text-bg-success">+<%= p.points %></span>
                  <% } else { %><span class="badge text-bg-danger">Wrong</span><% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div></div>
      </div>
    </div>

  </div>
</div>

<%- include('partials/report-modal') %>

<% if (isMe) { %>
<script>
(function () {
  var btn = document.getElementById('avatarBtn'), file = document.getElementById('avatarFile'), msg = document.getElementById('avatarMsg');
  var token = '<%= csrfToken %>';
  btn.addEventListener('click', function () { file.click(); });
  file.addEventListener('change', function () {
    var f = file.files[0]; if (!f) return;
    msg.textContent = '';
    if (!/^image\//.test(f.type)) { msg.textContent = 'Please choose an image.'; return; }
    var img = new Image(), url = URL.createObjectURL(f);
    img.onload = function () {
      // Beech se square crop, 256x256 JPEG (chhoti file, tez load)
      var size = Math.min(img.width, img.height), sx = (img.width - size) / 2, sy = (img.height - size) / 2;
      var c = document.createElement('canvas'); c.width = c.height = 256;
      var ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, 256, 256);
      ctx.drawImage(img, sx, sy, size, size, 0, 0, 256, 256);
      URL.revokeObjectURL(url);
      btn.disabled = true; btn.textContent = 'Uploading...';
      c.toBlob(function (blob) {
        if (!blob) { msg.textContent = 'Could not read this image.'; btn.disabled = false; return; }
        fetch('/upload-avatar', { method: 'POST', headers: { 'Content-Type': 'image/jpeg', 'x-csrf-token': token }, body: blob, credentials: 'same-origin' })
          .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (x) {
            if (x.ok) { location.reload(); return; }
            msg.textContent = (x.j && x.j.error) || 'Upload failed. Please try again.';
            btn.disabled = false; btn.textContent = '📷 Change photo';
          })
          .catch(function () { msg.textContent = 'Upload failed. Please try again.'; btn.disabled = false; btn.textContent = '📷 Change photo'; });
      }, 'image/jpeg', 0.85);
    };
    img.onerror = function () { msg.textContent = 'Could not read this image.'; };
    img.src = url;
  });
})();
</script>
<% } %>

<%- include('partials/footer') %>
