<%- include('partials/header') %>
<%- include('partials/shop-style') %>
<%- include('partials/seller-nav') %>

<%
  const pct = (a, b) => (b > 0 ? (a * 100 / b).toFixed(1) + '%' : '-');
  const ICON = { whatsapp: '💬', facebook: '📘', telegram: '✈️', instagram: '📸', other: '🔗' };
  const gmax = Math.max(1, ...byGroup.map(g => g.orders));
%>
<style>
  .an-t { width: 100%; font-size: .88rem; }
  .an-t th { font-size: .74rem; text-transform: uppercase; letter-spacing: .03em; color: var(--bs-secondary-color); font-weight: 600; padding: .35rem .5rem; border-bottom: 1px solid var(--bs-border-color); white-space: nowrap; }
  .an-t td { padding: .45rem .5rem; border-bottom: 1px solid var(--bs-border-color); }
  .an-t .r { text-align: right; }
  .an-bar { height: 5px; border-radius: 99px; background: var(--bs-tertiary-bg); margin-top: .25rem; overflow: hidden; }
  .an-bar span { display: block; height: 100%; background: #12a37f; }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="fs-4 fw-bold mb-0">📊 Shop analytics</h1>
  <div class="btn-group btn-group-sm">
    <% [7, 30, 90].forEach(d => { %><a class="btn <%= days === d ? 'btn-dark' : 'btn-outline-secondary' %>" href="/seller/analytics?days=<%= d %>"><%= d %> din</a><% }) %>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="sh-card text-center mb-0"><div class="fs-3 fw-bold"><%= tot.people %></div><div class="sh-stat">Log aaye (<%= tot.visits %> visits)</div></div></div>
  <div class="col-6 col-md-3"><div class="sh-card text-center mb-0"><div class="fs-3 fw-bold"><%= tot.orders %></div><div class="sh-stat">Orders</div></div></div>
  <div class="col-6 col-md-3"><div class="sh-card text-center mb-0"><div class="fs-3 fw-bold"><%= pct(tot.orders, tot.people) %></div><div class="sh-stat">Order / visitor</div></div></div>
  <div class="col-6 col-md-3"><div class="sh-card text-center mb-0"><div class="fs-3 fw-bold" style="color:#12a37f;">Rs <%= rs(tot.revenue) %></div><div class="sh-stat">Sale (without returns)</div></div></div>
</div>

<div class="sh-card" id="groups">
  <h2 class="sh-h">👥 Group-wise sales <a href="/seller/share" class="small ms-2">📣 Share</a></h2>
  <% if (byGroup.length === 0) { %>
    <p class="text-body-secondary mb-0">not now group <a href="/seller/share">Share</a> Add your groups to the page. Each group gets a unique UTM tracking link, allowing you to see visitors and orders from each group separately.</p>
  <% } else { %>
    <div class="table-responsive"><table class="an-t">
      <thead><tr><th>Group</th><th class="r">Visitors Arrived</th><th class="r">Orders</th><th class="r">Order / Peopleo</th><th class="r">Units</th><th class="r">Sale (Rs)</th><th class="r">back</th></tr></thead>
      <tbody>
        <% byGroup.forEach(g => { %>
          <tr>
            <td style="min-width:190px;"><%= ICON[g.platform] || '🔗' %> <b><%= g.name %></b>
              <div class="an-bar"><span style="width:<%= g.orders ? Math.max(4, Math.round(g.orders * 100 / gmax)) : 0 %>%"></span></div></td>
            <td class="r"><%= g.people %><div class="sh-stat"><%= g.visits %> visits</div></td>
            <td class="r"><b><%= g.orders %></b></td>
            <td class="r"><%= pct(g.orders, g.people) %></td>
            <td class="r"><%= g.units %></td>
            <td class="r"><b><%= rs(g.revenue) %></b></td>
            <td class="r"><%= g.returned %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <p class="sh-stat mb-0 mt-2">"Visitors Arrived" = people who clicked on the group's link (not just those who viewed messages). Orders are attributed to the group whose link the customer used, within 7 days.</p>
  <% } %>
</div>

<div class="sh-card">
  <h2 class="sh-h">🌐 Source-wise</h2>
  <% if (bySource.length === 0) { %><p class="text-body-secondary mb-0">No data available yet.</p><% } else { %>
    <div class="table-responsive"><table class="an-t">
      <thead><tr><th>Source</th><th class="r">Visitors</th><th class="r">Orders</th><th class="r">Order / Visitor</th><th class="r">Sale (Rs)</th></tr></thead>
      <tbody>
        <% bySource.forEach(s => { %>
          <tr><td><b><%= s.source %></b></td><td class="r"><%= s.people %></td><td class="r"><b><%= s.orders %></b></td><td class="r"><%= pct(s.orders, s.people) %></td><td class="r"><%= rs(s.revenue) %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>

<% if (byPost.length) { %>
<div class="sh-card">
  <h2 class="sh-h">📰 Blog posts ke product card se</h2>
  <div class="table-responsive"><table class="an-t">
    <thead><tr><th>Post</th><th class="r">Clicks</th><th class="r">Orders</th></tr></thead>
    <tbody>
      <% byPost.forEach(p => { const sl = p.campaign.replace(/^post-/, ''); %>
        <tr><td><a href="/posts/<%= sl %>"><%= sl %></a></td><td class="r"><%= p.visits %></td><td class="r"><b><%= p.orders %></b></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</div>
<% } %>

<div class="sh-card">
  <h2 class="sh-h">🧑‍💻 Recent visitors <small class="text-body-secondary fw-normal">(kon aaya, kahan se)</small></h2>
  <% if (!locals.recent || recent.length === 0) { %>
    <p class="text-body-secondary mb-0">Abhi IP data nahi. <code>migration_v50.sql</code> chalayen; uske baad naye visits yahan dikhenge.</p>
  <% } else { %>
    <div class="table-responsive"><table class="an-t">
      <thead><tr><th>Time</th><th>Visitor</th><th>IP</th><th>Requests (is IP ki)</th><th>Location</th><th>Browser / Device</th><th>Source</th><th>Referrer</th><th>Product</th></tr></thead>
      <tbody>
        <% recent.forEach(v => { %>
          <tr>
            <td class="small text-body-secondary"><%= new Date(v.created_at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
            <td><%= v.who %></td>
            <td><code><%= v.ipShown %></code></td>
            <td class="small"><b><%= v.reqs %></b> req &middot; <%= v.products %> product<%= v.products === 1 ? '' : 's' %></td>
            <td><%= v.flag %> <%= v.city ? v.city + ', ' : '' %><%= v.countryName %></td>
            <td class="small"><%= v.ua %></td>
            <td><%= v.source || 'direct' %></td>
            <td class="small text-body-secondary"><%= v.referrer || '-' %></td>
            <td><%= v.product %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>

<div class="sh-card">
  <h2 class="sh-h">📦 Product-wise</h2>
  <% if (byProduct.length === 0) { %><p class="text-body-secondary mb-0">Abhi koi product nahi.</p><% } else { %>
    <div class="table-responsive"><table class="an-t">
      <thead><tr><th>Product</th><th class="r">Visits</th><th class="r">Orders</th><th class="r">Sale (Rs)</th><th class="r">Stock</th></tr></thead>
      <tbody>
        <% byProduct.forEach(p => { %>
          <tr><td><a class="text-decoration-none" href="/seller/products/<%= p.id %>/edit"><%= p.name %></a></td><td class="r"><%= p.visits %></td><td class="r"><b><%= p.orders %></b></td><td class="r"><%= rs(p.revenue) %></td><td class="r"><%= p.stock <= 0 ? 'Sold out' : p.stock %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>

<%- include('partials/footer') %>
