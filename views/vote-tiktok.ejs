<%- include('partials/header') %>

<style>
  .tt-canvas-wrap { max-width: 340px; margin: 0 auto; }
  .tt-canvas-wrap canvas, .tt-canvas-wrap video { width: 100%; aspect-ratio: 9 / 16; border-radius: 18px; background: #0f172a; display: block; box-shadow: 0 10px 30px rgba(0,0,0,.25); }
  .tt-step { display: flex; gap: .6rem; align-items: flex-start; }
  .tt-step .n { flex: 0 0 28px; height: 28px; border-radius: 50%; background: #fe2c55; color: #fff; font-weight: 700; display: grid; place-items: center; font-size: .85rem; }
</style>

<div class="row justify-content-center">
  <div class="col-12 col-lg-10">
    <div class="mb-3"><a href="/votes/<%= st.id %>" class="text-decoration-none">&larr; Back to contest</a></div>
    <h1 class="fw-bold h3 mb-1">🎵 TikTok vote video</h1>
    <p class="text-body-secondary mb-4"><%= st.title %></p>

    <div class="row g-4">
      <!-- Left: video -->
      <div class="col-12 col-md-5">
        <div class="tt-canvas-wrap">
          <canvas id="ttCanvas" width="720" height="1280"></canvas>
          <video id="ttVideo" class="d-none" controls playsinline loop></video>
        </div>
        <div class="d-grid gap-2 mt-3 tt-canvas-wrap">
          <div class="form-check small">
            <input class="form-check-input" type="checkbox" id="ttShowPct">
            <label class="form-check-label" for="ttShowPct">Show current result % on the video</label>
          </div>
          <button type="button" class="btn btn-lg text-white fw-bold" style="background:#fe2c55" id="ttMake">▶ Create video (60 sec)</button>
          <div id="ttProgress" class="progress d-none" style="height:8px"><div class="progress-bar bg-danger" style="width:0%"></div></div>
          <div id="ttMsg" class="small text-body-secondary"></div>
          <div id="ttDone" class="d-none">
            <div class="d-grid gap-2">
              <button type="button" class="btn btn-dark fw-semibold d-none" id="ttShare">📤 Share video to TikTok</button>
              <a class="btn btn-outline-dark fw-semibold" id="ttDownload" download>⬇ Download video</a>
              <a class="btn btn-outline-secondary" href="https://www.tiktok.com/upload" target="_blank" rel="noopener">Open TikTok upload page ↗</a>
            </div>
            <div class="alert alert-warning small mt-2 mb-0 d-none" id="ttWebmNote">
              Your browser made a .webm file. TikTok may not accept it. Open this page in Chrome on Android (it makes .mp4), or convert the file with CapCut.
            </div>
          </div>
        </div>
      </div>

      <!-- Right: steps, caption, link -->
      <div class="col-12 col-md-7">
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">
            <h6 class="fw-bold mb-1">🎙️ Funny voice (optional)</h6>
            <p class="small text-body-secondary mb-2">Pick a funny script, make the voice file (free, see the command), upload it here. The voice is mixed into the video and the script shows as subtitles.</p>
            <div class="d-flex flex-wrap gap-2 mb-2" id="ttPresets">
              <% presets.forEach(function (p) { %><button type="button" class="btn btn-outline-dark btn-sm" data-preset="<%= p.key %>"><%= p.label %></button><% }) %>
            </div>
            <textarea class="form-control mb-2" id="ttScript" rows="4" dir="auto" placeholder="Script (Urdu script works best with voice generators)"></textarea>
            <div class="row g-2 mb-2">
              <div class="col-6">
                <select class="form-select form-select-sm" id="ttVoice">
                  <option value="ur-PK-AsadNeural">Male (Asad)</option>
                  <option value="ur-PK-UzmaNeural">Female (Uzma)</option>
                </select>
              </div>
              <div class="col-6">
                <select class="form-select form-select-sm" id="ttRate">
                  <option value="+0%">Normal speed</option>
                  <option value="+10%" selected>A bit faster</option>
                  <option value="+20%">Fast</option>
                </select>
              </div>
            </div>
            <label class="small fw-semibold mb-1">1. Free voice command (run in terminal, needs <code>pip install --break-system-packages edge-tts</code> once)</label>
            <textarea class="form-control form-control-sm font-monospace mb-1" id="ttCmd" rows="3" readonly></textarea>
            <button class="btn btn-outline-secondary btn-sm mb-3" type="button" data-copy="ttCmd">Copy command</button>
            <label class="small fw-semibold d-block mb-1">2. Upload the voice file (mp3 / wav / m4a)</label>
            <input type="file" class="form-control form-control-sm" id="ttAudio" accept="audio/*">
            <audio id="ttAudioPrev" class="w-100 mt-2 d-none" controls></audio>
            <div class="small text-body-secondary mt-1" id="ttAudioInfo"></div>
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="ttFunny" checked>
              <label class="form-check-label" for="ttFunny">😂 Funny mode (wobbling cards, floating emojis, auto captions)</label>
            </div>
            <div class="form-check mt-1">
              <input class="form-check-input" type="checkbox" id="ttSfx" checked>
              <label class="form-check-label" for="ttSfx">🔊 Auto funny sounds (siren, boing, airhorn, beat) - no voice file needed</label>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">
            <h6 class="fw-bold mb-3">How to get TikTok traffic to this vote</h6>
            <div class="tt-step mb-2"><span class="n">1</span><div>Press <strong>Create video</strong>. Keep this tab open until it finishes.</div></div>
            <div class="tt-step mb-2"><span class="n">2</span><div>Press <strong>Share video to TikTok</strong> (phone) or <strong>Download</strong>, then upload it on TikTok. Add a trending sound there.</div></div>
            <div class="tt-step mb-2"><span class="n">3</span><div>Paste the <strong>caption</strong> below into the TikTok description.</div></div>
            <div class="tt-step mb-0"><span class="n">4</span><div>Put the <strong>bio link</strong> below in your TikTok profile bio. The video says &ldquo;link in bio&rdquo;, so viewers tap your profile, click the link and vote.</div></div>
          </div>
        </div>

        <div class="alert alert-info small">
          TikTok does <strong>not</strong> make links clickable inside a video description or comments, so the link has to go in your <strong>profile bio</strong>.
          A Business account can add a bio link right away (personal accounts need enough followers). Check TikTok's current rules in your account settings.
        </div>

        <label class="fw-semibold small mb-1">🔗 Bio link (counts as source &ldquo;tiktok&rdquo; in analytics)</label>
        <div class="input-group mb-3">
          <input class="form-control" id="ttLink" value="<%= shortUrl %>" readonly>
          <button class="btn btn-outline-secondary" type="button" data-copy="ttLink">Copy</button>
        </div>

        <label class="fw-semibold small mb-1">📝 Caption</label>
        <textarea class="form-control mb-2" id="ttCaption" rows="5"><%= caption %>

<%= tags %></textarea>
        <button class="btn btn-outline-secondary btn-sm" type="button" data-copy="ttCaption">Copy caption</button>

        <% if (!st.open) { %><div class="alert alert-secondary small mt-3 mb-0">Voting is closed for this contest, so the video will say so only if you reopen it first.</div><% } %>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var D = <%- JSON.stringify(studio).replace(/</g, '\\u003c') %>;
  var CSRF = <%- JSON.stringify(csrfToken) %>;
  var W = 720, H = 1280, BASE = 60, DUR = 60, VOICE_AT = 0.6;
  var PRESETS = <%- JSON.stringify(presets).replace(/</g, '\\u003c') %>;
  var funny = true, sfxOn = true, audioBuf = null, audioCtx = null, subs = [], cues = [];
  var FONT = "'Segoe UI', Roboto, 'Noto Sans', Arial, sans-serif";
  var cv = document.getElementById('ttCanvas'), ctx = cv.getContext('2d');
  var $ = function (id) { return document.getElementById(id); };
  var showPct = false;

  // ---- images ----
  var imgs = D.options.map(function (o) {
    var im = new Image(); im.crossOrigin = 'anonymous';
    im.onload = function () { if (!recording) draw(previewT()); };
    im.onerror = function () { im.failed = true; };
    im.src = o.image;
    return im;
  });

  // ---- helpers ----
  var c01 = function (x) { return Math.min(1, Math.max(0, x)); };
  var easeOut = function (x) { x = c01(x); return 1 - Math.pow(1 - x, 3); };
  var back = function (x) { x = c01(x); var c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2); };
  function rr(x, y, w, h, r) {
    ctx.beginPath(); ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
  }
  function wrap(text, maxW) {
    var words = String(text).split(/\s+/), lines = [], cur = '';
    words.forEach(function (w) {
      var test = cur ? cur + ' ' + w : w;
      if (ctx.measureText(test).width > maxW && cur) { lines.push(cur); cur = w; } else cur = test;
    });
    if (cur) lines.push(cur);
    return lines;
  }
  function cover(im, x, y, w, h, r) {
    ctx.save(); rr(x, y, w, h, r); ctx.clip();
    if (im && im.complete && im.naturalWidth && !im.failed) {
      var s = Math.max(w / im.naturalWidth, h / im.naturalHeight);
      var dw = im.naturalWidth * s, dh = im.naturalHeight * s;
      ctx.drawImage(im, x + (w - dw) / 2, y + (h - dh) * 0.2, dw, dh);
    } else {
      var g = ctx.createLinearGradient(x, y, x + w, y + h); g.addColorStop(0, '#334155'); g.addColorStop(1, '#1e293b');
      ctx.fillStyle = g; ctx.fillRect(x, y, w, h);
    }
    ctx.restore();
  }
  function text(str, x, y, size, color, align, weight) {
    ctx.font = (weight || '800') + ' ' + size + 'px ' + FONT;
    ctx.fillStyle = color; ctx.textAlign = align || 'center'; ctx.textBaseline = 'alphabetic';
    ctx.fillText(str, x, y);
  }

  // ---- timeline: 60-second scale (scaled automatically if the video is longer) ----
  var TL = 60, SPOT_A = 12, SPOT_B = 32, FIGHT_B = 40, DEB_B = 50, CD_B = 54, CTA_AT = 50;
  var curT = 0;
  var LINES = ['Main hi jeetoonga! 😎', 'Bhai pehle mujhe dekh lo! 🙄', 'Mera bhi haq banta hai! 🤝', 'Mujhe kam mat samjho! 💪'];
  function spotCount() { return Math.min(4, D.options.length); }
  function oname(i) {
    var s = String(D.options[i % D.options.length].name || '').replace(/[^\p{L}\p{N}\s]/gu, '').replace(/\s+/g, ' ').trim() || 'Option';
    return s.length > 22 ? s.slice(0, 21) + '…' : s;
  }
  // Auto captions (no voice needed). Times are on the 60-second scale.
  function buildCues() {
    var k = spotCount(), a = oname(0), b = oname(1), span = (SPOT_B - SPOT_A) / k;
    var cues = [[0, 3, 'Ruko ruko ruko! 🛑'], [3, 5, 'Pehle ye dekho… 👀'], [5, 8, 'Aaj ka sab se bada muqabla! 🔥'], [8, 12, 'Dil thaam ke baithiye! 💔']];
    for (var i = 0; i < k; i++) cues.push([SPOT_A + i * span, SPOT_A + (i + 1) * span, oname(i) + ': "' + LINES[i] + '"']);
    cues.push([32, 36, 'Aur ab… aamne saamne! 🥊'], [36, 40, 'Dono ke fans ne shor macha diya! 📢'],
      [40, 43, 'Chacha: ' + a + ' hi jeetay ga!'], [43, 46, 'Phupho: Nahi, ' + b + '! 🙄'], [46, 50, 'Dadi: Chup! Chai lao! ☕'],
      [50, 54, 'Waqt khatam hone wala hai ⏰'], [54, 60, 'Link in bio, abhi vote karo! 👆']);
    return cues;
  }

  // card layout (2 options = stacked with VS, more = grid). tin = seconds since this scene started.
  function layout(top, h, tin, wob) {
    var n = D.options.length;
    if (n === 2) {
      var cw = 560, gap = 56, ch = Math.min(300, (h - gap) / 2), x = (W - cw) / 2;
      for (var k = 0; k < 2; k++) {
        var p = easeOut((tin - k * 0.3) / 0.6);
        if (p <= 0) continue;
        var y = top + k * (ch + gap), off = (1 - p) * (k === 0 ? -W : W), mx = x + cw / 2, my = y + ch / 2;
        ctx.save(); ctx.translate(mx + off, my);
        if (wob && p >= 1) { ctx.translate(Math.sin(curT * 14 + k * 3) * 2, 0); ctx.rotate(Math.sin(curT * 5 + k * 2) * 0.03); }
        ctx.translate(-mx, -my);
        drawCard(k, x, y, cw, ch, 24, 46);
        ctx.restore();
      }
      var vp = back((tin - 1.0) / 0.5);
      if (vp > 0) {
        var vy = top + ch + gap / 2, rad = 46 * vp;
        ctx.fillStyle = '#facc15'; ctx.beginPath(); ctx.arc(W / 2, vy, rad, 0, Math.PI * 2); ctx.fill();
        ctx.save(); ctx.translate(W / 2, vy); ctx.scale(vp, vp); text('VS', 0, 14, 40, '#111'); ctx.restore();
      }
    } else {
      var cols = 2, rows = Math.ceil(n / cols), gx = 24, gy = 24;
      var cw2 = (W - 100 - gx) / cols, ch2 = Math.min(250, (h - gy * (rows - 1)) / rows);
      for (var k2 = 0; k2 < n; k2++) {
        var pp = easeOut((tin - k2 * 0.25) / 0.6);
        if (pp <= 0) continue;
        var cxx = 50 + (k2 % cols) * (cw2 + gx), cyy = top + Math.floor(k2 / cols) * (ch2 + gy), mx2 = cxx + cw2 / 2, my2 = cyy + ch2 / 2;
        ctx.save(); ctx.globalAlpha = pp; ctx.translate(mx2, my2 + (1 - pp) * 50);
        if (wob && pp >= 1) ctx.rotate(Math.sin(curT * 5 + k2 * 2) * 0.025);
        ctx.translate(-mx2, -my2);
        drawCard(k2, cxx, cyy, cw2, ch2, 20, 34);
        ctx.restore();
      }
      if (tin > 1.0) { var fp = back((tin - 1.0) / 0.5); ctx.save(); ctx.translate(W / 2, top - 6); ctx.scale(fp, fp); text('VS', 0, 0, 40, '#facc15'); ctx.restore(); }
    }
  }

  function sceneHook(u, top, h) {
    var cy = top + h / 2, s = 1 + 0.08 * Math.sin(u * 18);
    ctx.fillStyle = 'rgba(254,44,85,' + (0.08 + 0.1 * Math.abs(Math.sin(u * 6))) + ')'; ctx.fillRect(0, 0, W, H);
    ctx.save(); ctx.translate(W / 2 + Math.sin(u * 40) * 5, cy - 10); ctx.scale(s, s); ctx.rotate(Math.sin(u * 9) * 0.05);
    text('😱', 0, -50, 150); text('RUKO!', 0, 100, 120, '#fde047');
    ctx.restore();
  }

  function sceneSpot(u, top, h) {
    var k = spotCount(), span = (SPOT_B - SPOT_A) / k, idx = Math.min(k - 1, Math.floor((u - SPOT_A) / span)), loc = u - SPOT_A - idx * span;
    var w = 560, hh = Math.min(h - 40, 470), x = (W - w) / 2, y = top + (h - hh) / 2;
    var p = back(loc / 0.6), mx = W / 2, my = y + hh / 2;
    var em = ['⭐', '🎉', '✨', '🔥', '💥', '🎊'];
    for (var i = 0; i < 6; i++) {
      var a = curT * 1.6 + i * 1.047;
      ctx.globalAlpha = c01(loc / 0.5); ctx.font = '48px ' + FONT; ctx.textAlign = 'center';
      ctx.fillText(em[i], mx + Math.cos(a) * 320, my + Math.sin(a) * (hh / 2 + 25));
    }
    ctx.globalAlpha = 1;
    ctx.save(); ctx.translate(mx, my); ctx.scale(p, p); ctx.rotate(Math.sin(curT * 4) * 0.035 + (1 - c01(p)) * -0.25); ctx.translate(-mx, -my);
    drawCard(idx, x, y, w, hh, 28, 54);
    ctx.fillStyle = '#facc15'; rr(x + 18, y + 18, 150, 46, 23); ctx.fill();
    text('#' + (idx + 1) + ' 🔥', x + 93, y + 51, 28, '#111');
    ctx.restore();
  }

  function sceneDebate(u, top, h) {
    layout(top, h - 130, 99, true);
    var who = u < 43 ? ['👴', 0] : u < 46 ? ['👩', 1] : ['👵', 2];
    var loc = u < 43 ? u - 40 : u < 46 ? u - 43 : u - 46;
    var bx = [150, W - 150, W / 2][who[1]], by = top + h - 12, bounce = Math.abs(Math.sin(loc * 9)) * 22, pp = back(loc / 0.35);
    ctx.save(); ctx.translate(bx, by - bounce); ctx.scale(pp, pp); ctx.rotate(Math.sin(loc * 12) * 0.08);
    text(who[0], 0, 0, 120);
    ctx.restore();
    ctx.save(); ctx.globalAlpha = c01(loc / 0.3);
    text('💬', bx + (who[1] === 1 ? -95 : 95), by - 90 - bounce, 56);
    ctx.restore();
  }

  function sceneCount(u, top, h) {
    var i = Math.min(3, Math.max(0, Math.floor(u - DEB_B))), loc = (u - DEB_B) % 1, labels = ['3', '2', '1', 'VOTE!'];
    var lab = labels[i], s = back(loc / 0.35) * (1 + 0.04 * Math.sin(curT * 20));
    ctx.save(); ctx.translate(W / 2, top + h / 2 + 40); ctx.scale(s, s);
    text(lab, 0, 0, lab.length > 1 ? 150 : 300, i === 3 ? '#facc15' : '#fff');
    ctx.restore();
    text('⏰', W / 2, top + 90, 80);
  }

  // ---- one frame ----
  function draw(t) {
    curT = t;
    var u = t * TL / DUR; // time on the 60-second scale
    // background
    var g = ctx.createLinearGradient(0, 0, W, H);
    g.addColorStop(0, '#0f172a'); g.addColorStop(0.55, '#3b0764'); g.addColorStop(1, '#831843');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    for (var i = 0; i < 3; i++) {
      var cx = W * (0.2 + 0.3 * i) + Math.sin(t * 0.7 + i * 2) * 60;
      var cy = H * (0.25 + 0.25 * i) + Math.cos(t * 0.6 + i) * 80;
      var rg = ctx.createRadialGradient(cx, cy, 0, cx, cy, 300);
      rg.addColorStop(0, 'rgba(254,44,85,0.22)'); rg.addColorStop(1, 'rgba(254,44,85,0)');
      ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);
    }

    // floating emojis (funny mode), behind the cards
    if (funny) {
      var em = ['😂', '🤣', '🔥', '🏏', '🍵', '🗳️'];
      ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic'; ctx.font = '46px ' + FONT;
      for (var e = 0; e < 8; e++) {
        var ph = (t * 0.22 + e * 0.125) % 1;
        ctx.globalAlpha = Math.sin(ph * Math.PI) * 0.9;
        ctx.fillText(em[e % em.length], 70 + ((e * 89) % 580) + Math.sin(t * 2 + e) * 18, H - 60 - ph * (H - 220));
      }
      ctx.globalAlpha = 1;
    }

    // progress bar
    ctx.fillStyle = 'rgba(255,255,255,.18)'; rr(40, 34, W - 80, 8, 4); ctx.fill();
    ctx.fillStyle = '#fe2c55'; rr(40, 34, Math.max(8, (W - 80) * c01(t / DUR)), 8, 4); ctx.fill();

    // top pill
    var a0 = easeOut(t / 0.4);
    ctx.save(); ctx.globalAlpha = a0;
    ctx.fillStyle = '#fe2c55'; rr(W / 2 - 110, 70, 220, 56, 28); ctx.fill();
    text(funny ? '😂 VOTE NOW' : '🗳️ VOTE NOW', W / 2, 109, 30, '#fff');
    ctx.restore();

    // title (stays on screen the whole video)
    var ta = easeOut((t - 0.3) / 0.6);
    ctx.save(); ctx.globalAlpha = ta; ctx.translate(0, (1 - ta) * 30);
    var tsz = funny ? 46 : 54, tlh = funny ? 54 : 64;
    ctx.font = '800 ' + tsz + 'px ' + FONT;
    var tl = wrap(D.title, W - 120).slice(0, 4);
    var ty = 200;
    tl.forEach(function (ln, i) { text(ln, W / 2, ty + i * tlh, tsz, '#fff'); });
    ctx.restore();
    var areaTop = ty + tl.length * tlh + 10, areaBottom = funny ? 790 : 900, areaH = areaBottom - areaTop;

    // stage: changes scene every few seconds
    var shk = (u >= 33 && u < 34.3) ? (1 - (u - 33) / 1.3) * 14 : 0;
    ctx.save();
    if (shk) ctx.translate(Math.sin(t * 95) * shk, Math.cos(t * 83) * shk);
    if (u < 5) sceneHook(u, areaTop, areaH);
    else if (u < SPOT_A) layout(areaTop, areaH, u - 5, true);
    else if (u < SPOT_B) sceneSpot(u, areaTop, areaH);
    else if (u < FIGHT_B) layout(areaTop, areaH, u - SPOT_B, true);
    else if (u < DEB_B) sceneDebate(u, areaTop, areaH);
    else if (u < CD_B) sceneCount(u, areaTop, areaH);
    else layout(areaTop, areaH, 99, true);
    ctx.restore();

    // captions: your script (voice) if you wrote one, else the automatic funny captions
    if (funny) {
      var list = subs.length ? subs : cues, hit = null;
      for (var si = 0; si < list.length; si++) { if (t >= list[si].a && t < list[si].b) { hit = list[si]; break; } }
      if (hit) drawSub(hit.s, easeOut((t - hit.a) / 0.25));
    }

    // call to action
    var cy0 = funny ? 985 : 960, ly = cy0 + 90;
    var ca = easeOut((u - CTA_AT) / 0.6);
    if (ca > 0) {
      var pulse = 1 + 0.04 * Math.sin(t * 6);
      ctx.save(); ctx.globalAlpha = ca; ctx.translate(W / 2, cy0); ctx.scale(pulse, pulse);
      ctx.fillStyle = '#fff'; rr(-290, -50, 580, 100, 50); ctx.fill();
      text('🔗 Link in bio to vote 👆', 0, 15, 40, '#be123c');
      ctx.restore();
      var la = easeOut((u - CTA_AT - 0.8) / 0.6);
      ctx.save(); ctx.globalAlpha = la;
      text(D.shortUrl.replace(/^https?:\/\//, ''), W / 2, ly, 30, '#fde68a', 'center', '700');
      if (D.siteName) text(D.siteName, W / 2, ly + 42, 26, 'rgba(255,255,255,.7)', 'center', '600');
      ctx.restore();
    }
  }

  function drawSub(str, pop) {
    var rtl = /[\u0600-\u06FF]/.test(str), size = 38;
    ctx.save();
    ctx.direction = rtl ? 'rtl' : 'ltr';
    ctx.font = '800 ' + size + 'px ' + FONT;
    var lines = wrap(str, W - 170);
    if (lines.length > 2) { size = 32; ctx.font = '800 ' + size + 'px ' + FONT; lines = wrap(str, W - 170).slice(0, 3); }
    var lh = size + 12, bh = lines.length * lh + 26, by = 805;
    ctx.globalAlpha = pop;
    ctx.fillStyle = 'rgba(0,0,0,.62)'; rr(50, by, W - 100, bh, 22); ctx.fill();
    lines.forEach(function (ln, i) { text(ln, W / 2, by + 20 + size + i * lh - 6, size, '#fde047'); });
    ctx.restore();
  }
  function computeSubs() {
    subs = [];
    var raw = ($('ttScript').value || '').trim();
    if (!raw) return;
    var parts = (raw.match(/[^۔!؟?.\n]+[۔!؟?.]?/g) || [raw]).map(function (x) { return x.trim(); }).filter(Boolean);
    var total = parts.reduce(function (a, x) { return a + x.length; }, 0) || 1;
    var span = audioBuf ? audioBuf.duration : Math.max(6, DUR - VOICE_AT - 1.5), cur = VOICE_AT;
    parts.forEach(function (x) { var d = span * x.length / total; subs.push({ s: x, a: cur, b: cur + d }); cur += d; });
  }
  function previewT() { return DUR * 0.95; }
  function computeCues() { var k = DUR / TL; cues = buildCues().map(function (c) { return { a: c[0] * k, b: c[1] * k, s: c[2] }; }); }
  function setLabel() { $('ttMake').textContent = '▶ Create video (' + DUR + ' sec)'; }
  function cmdText() {
    var txt = ($('ttScript').value || '').replace(/\s*\n\s*/g, ' ').replace(/(["\\$`])/g, '\\$1').trim() || 'اپنا متن یہاں لکھیں';
    return 'edge-tts --voice ' + $('ttVoice').value + ' --rate=' + $('ttRate').value + ' --text "' + txt + '" --write-media voice.mp3';
  }
  function refreshVoiceUi() { $('ttCmd').value = cmdText(); computeSubs(); computeCues(); if (!recording) draw(previewT()); }

  function drawCard(k, x, y, w, h, r, nameSize) {
    var o = D.options[k];
    cover(imgs[k], x, y, w, h, r);
    // dark bottom gradient + name
    ctx.save(); rr(x, y, w, h, r); ctx.clip();
    var gg = ctx.createLinearGradient(0, y + h * 0.45, 0, y + h);
    gg.addColorStop(0, 'rgba(0,0,0,0)'); gg.addColorStop(1, 'rgba(0,0,0,.8)');
    ctx.fillStyle = gg; ctx.fillRect(x, y, w, h);
    ctx.restore();
    ctx.font = '800 ' + nameSize + 'px ' + FONT;
    var nm = o.name; while (ctx.measureText(nm).width > w - 40 && nm.length > 3) nm = nm.slice(0, -2);
    if (nm !== o.name) nm += '…';
    text(nm, x + 22, y + h - 22, nameSize, '#fff', 'left');
    if (showPct) {
      ctx.font = '800 ' + (nameSize + 6) + 'px ' + FONT;
      text(o.pct + '%', x + w - 22, y + h - 22, nameSize + 6, '#facc15', 'right');
    }
    ctx.strokeStyle = 'rgba(255,255,255,.55)'; ctx.lineWidth = 3; rr(x, y, w, h, r); ctx.stroke();
  }


  // ---- automatic funny sounds (made in the browser, no files needed) ----
  function tone(dest, when, type, f0, f1, dur, vol) {
    var o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.type = type; o.frequency.setValueAtTime(f0, when); o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), when + dur);
    g.gain.setValueAtTime(vol, when); g.gain.exponentialRampToValueAtTime(0.0001, when + dur);
    o.connect(g); g.connect(dest); o.start(when); o.stop(when + dur + 0.05);
  }
  function noise(dest, when, dur, vol, f0, f1) {
    var len = Math.floor(audioCtx.sampleRate * dur), b = audioCtx.createBuffer(1, len, audioCtx.sampleRate), d = b.getChannelData(0);
    for (var i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    var s = audioCtx.createBufferSource(), f = audioCtx.createBiquadFilter(), g = audioCtx.createGain();
    s.buffer = b; f.type = 'bandpass'; f.Q.value = 1.2;
    f.frequency.setValueAtTime(f0, when); f.frequency.exponentialRampToValueAtTime(f1, when + dur);
    g.gain.setValueAtTime(vol, when); g.gain.exponentialRampToValueAtTime(0.0001, when + dur);
    s.connect(f); f.connect(g); g.connect(dest); s.start(when);
  }
  function sfx(type, when, dest) {
    if (type === 'pop') tone(dest, when, 'sine', 700, 180, 0.18, 0.5);
    else if (type === 'boing') { tone(dest, when, 'sine', 180, 650, 0.35, 0.5); tone(dest, when + 0.18, 'sine', 650, 260, 0.3, 0.35); }
    else if (type === 'whoosh') noise(dest, when, 0.5, 0.6, 300, 4000);
    else if (type === 'drum') { for (var i = 0; i < 4; i++) tone(dest, when + i * 0.12, 'sine', 170, 45, 0.3, 0.8); }
    else if (type === 'beep') tone(dest, when, 'square', 880, 880, 0.18, 0.22);
    else if (type === 'ding') { tone(dest, when, 'triangle', 1175, 1175, 0.5, 0.4); tone(dest, when + 0.12, 'triangle', 1568, 1568, 0.7, 0.35); }
    else if (type === 'horn') [440, 554, 659].forEach(function (f) { tone(dest, when, 'sawtooth', f, f * 0.97, 0.7, 0.12); });
    else if (type === 'siren') { tone(dest, when, 'sawtooth', 500, 900, 0.6, 0.14); tone(dest, when + 0.6, 'sawtooth', 900, 500, 0.6, 0.14); }
  }
  function sfxPlan() {
    var k = spotCount(), span = (SPOT_B - SPOT_A) / k;
    var ev = [[0, 'siren'], [3.2, 'pop'], [5, 'whoosh'], [8, 'drum']];
    for (var i = 0; i < k; i++) ev.push([SPOT_A + i * span, 'boing']);
    return ev.concat([[32, 'whoosh'], [33, 'horn'], [36, 'pop'], [40, 'whoosh'], [40.3, 'boing'], [43, 'boing'], [46, 'boing'],
      [50, 'beep'], [51, 'beep'], [52, 'beep'], [53, 'horn'], [54, 'ding'], [56, 'pop'], [58, 'ding']]);
  }
  function scheduleSounds(dest, base, quiet) {
    var k = DUR / TL, master = audioCtx.createGain();
    master.gain.value = quiet ? 0.5 : 1; master.connect(dest);
    sfxPlan().forEach(function (e) { sfx(e[1], base + e[0] * k, master); });
    // light party beat under everything
    var bg = audioCtx.createGain(); bg.gain.value = quiet ? 0.45 : 0.8; bg.connect(dest);
    var bass = [110, 110, 147, 165, 110, 110, 196, 165];
    for (var i = 0, tt = 0.2; tt < DUR - 0.3; i++, tt += 0.5) {
      tone(bg, base + tt, 'sine', 130, 45, 0.16, 0.22);
      if (i % 2 === 1) noise(bg, base + tt, 0.05, 0.07, 7000, 9000);
      if (i % 2 === 0) tone(bg, base + tt, 'square', bass[(i >> 1) % bass.length], bass[(i >> 1) % bass.length], 0.2, 0.035);
    }
  }

  // ---- recording ----
  var recording = false, blobUrl = null;
  function pickMime(withAudio) {
    var list = (withAudio ? ['video/mp4;codecs=avc1.42E01E,mp4a.40.2', 'video/mp4;codecs=avc1,mp4a.40.2', 'video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus'] : [])
      .concat(['video/mp4;codecs=avc1', 'video/mp4', 'video/webm;codecs=vp9', 'video/webm;codecs=vp8', 'video/webm']);
    if (!window.MediaRecorder) return null;
    for (var i = 0; i < list.length; i++) { if (MediaRecorder.isTypeSupported(list[i])) return list[i]; }
    return '';
  }
  function count() {
    try { var fd = new URLSearchParams(); fd.set('ch', 'tiktok'); fd.set('_csrf', CSRF); navigator.sendBeacon('/votes/' + D.id + '/share', fd); } catch (e) {}
  }

  $('ttShowPct').addEventListener('change', function () { showPct = this.checked; if (!recording) draw(previewT()); });
  $('ttSfx').addEventListener('change', function () { sfxOn = this.checked; });
  $('ttFunny').addEventListener('change', function () { funny = this.checked; if (!recording) draw(previewT()); });
  document.getElementById('ttPresets').addEventListener('click', function (e) {
    var b = e.target.closest('[data-preset]'); if (!b) return;
    var p = PRESETS.filter(function (x) { return x.key === b.dataset.preset; })[0];
    if (p) { $('ttScript').value = p.ur; refreshVoiceUi(); }
  });
  $('ttScript').addEventListener('input', refreshVoiceUi);
  $('ttVoice').addEventListener('change', refreshVoiceUi);
  $('ttRate').addEventListener('change', refreshVoiceUi);
  $('ttAudio').addEventListener('change', function () {
    var f = this.files && this.files[0], info = $('ttAudioInfo'), prev = $('ttAudioPrev');
    audioBuf = null; DUR = BASE; setLabel();
    if (!f) { prev.classList.add('d-none'); info.textContent = ''; refreshVoiceUi(); return; }
    if (f.size > 15 * 1024 * 1024) { info.textContent = 'File is too big (max 15 MB).'; return; }
    var AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) { info.textContent = 'This browser cannot mix audio. Use Chrome.'; return; }
    audioCtx = audioCtx || new AC();
    prev.src = URL.createObjectURL(f); prev.classList.remove('d-none');
    info.textContent = 'Reading audio…';
    f.arrayBuffer().then(function (ab) { return audioCtx.decodeAudioData(ab); }).then(function (buf) {
      if (buf.duration > 72) { info.textContent = 'Audio is longer than 72 seconds. Please use a shorter one.'; return; }
      audioBuf = buf;
      DUR = Math.min(75, Math.max(BASE, Math.ceil(buf.duration + VOICE_AT + 1.5)));
      info.textContent = 'Voice: ' + buf.duration.toFixed(1) + ' sec. Video will be ' + DUR + ' sec.';
      setLabel(); refreshVoiceUi();
    }).catch(function () { info.textContent = 'Could not read this audio file. Try mp3 or wav.'; });
  });

  $('ttMake').addEventListener('click', function () {
    var AC0 = window.AudioContext || window.webkitAudioContext;
    var useSfx = funny && sfxOn && !!AC0;
    var btn = this, mime = pickMime(!!audioBuf || useSfx);
    if (mime === null || !cv.captureStream) {
      $('ttMsg').textContent = 'This browser cannot record video. Please open this page in Chrome (Android / desktop) or Safari 14.1+.';
      return;
    }
    recording = true; btn.disabled = true; btn.textContent = 'Recording…';
    $('ttDone').classList.add('d-none'); $('ttVideo').classList.add('d-none'); cv.classList.remove('d-none');
    $('ttMsg').textContent = 'Keep this tab open and visible…';
    var bar = $('ttProgress'); bar.classList.remove('d-none');
    var chunks = [], stream = cv.captureStream(30), rec, vsrc = null;
    computeSubs(); computeCues();
    var dest = null;
    if (audioBuf || useSfx) {
      try {
        audioCtx = audioCtx || new AC0();
        audioCtx.resume();
        dest = audioCtx.createMediaStreamDestination();
        if (audioBuf) { vsrc = audioCtx.createBufferSource(); vsrc.buffer = audioBuf; vsrc.connect(dest); } // speakers se nahi chalta
        dest.stream.getAudioTracks().forEach(function (tr) { stream.addTrack(tr); });
      } catch (e) { vsrc = null; dest = null; }
    }
    try { rec = new MediaRecorder(stream, mime ? { mimeType: mime, videoBitsPerSecond: 4000000 } : {}); }
    catch (e) { rec = new MediaRecorder(stream); }
    rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
    rec.onstop = function () {
      recording = false; btn.disabled = false; btn.textContent = '🔁 Create again (' + DUR + ' sec)'; bar.classList.add('d-none');
      var type = rec.mimeType || mime || 'video/webm';
      var ext = /mp4/.test(type) ? 'mp4' : 'webm';
      var blob = new Blob(chunks, { type: type });
      if (blobUrl) URL.revokeObjectURL(blobUrl);
      blobUrl = URL.createObjectURL(blob);
      var v = $('ttVideo'); v.src = blobUrl; cv.classList.add('d-none'); v.classList.remove('d-none'); v.play().catch(function () {});
      var a = $('ttDownload'); a.href = blobUrl; a.download = 'vote-' + D.id + '.' + ext;
      a.onclick = count;
      $('ttWebmNote').classList.toggle('d-none', ext === 'mp4');
      var file = null;
      try { file = new File([blob], 'vote-' + D.id + '.' + ext, { type: type }); } catch (e) {}
      var sh = $('ttShare');
      if (file && navigator.canShare && navigator.canShare({ files: [file] })) {
        sh.classList.remove('d-none');
        sh.onclick = function () {
          count();
          navigator.share({ files: [file], text: $('ttCaption').value }).catch(function () {});
        };
      } else { sh.classList.add('d-none'); }
      $('ttDone').classList.remove('d-none');
      $('ttMsg').textContent = 'Done! Share it, then put the bio link in your TikTok profile.';
    };
    rec.start(250);
    var t0 = performance.now();
    if (vsrc) vsrc.start(audioCtx.currentTime + VOICE_AT);
    if (dest && useSfx) { try { scheduleSounds(dest, audioCtx.currentTime + 0.05, !!audioBuf); } catch (e) {} }
    (function loop() {
      var t = (performance.now() - t0) / 1000;
      draw(Math.min(t, DUR));
      bar.firstElementChild.style.width = (c01(t / DUR) * 100) + '%';
      if (t < DUR) requestAnimationFrame(loop);
      else setTimeout(function () { rec.stop(); }, 150);
    })();
  });

  // ---- copy buttons ----
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-copy]'); if (!b) return;
    var el = $(b.dataset.copy), old = b.textContent;
    (navigator.clipboard ? navigator.clipboard.writeText(el.value) : Promise.reject()).then(function () {
      b.textContent = 'Copied ✅'; setTimeout(function () { b.textContent = old; }, 1800);
    }).catch(function () { el.select(); try { document.execCommand('copy'); } catch (x) {} });
  });

  setLabel();
  refreshVoiceUi(); // preview
})();
</script>

