# ---- Database (local) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=blog_db
# Online (Neon): DATABASE_URL set karein to upar wali DB_* settings ignore ho jati hain
# DATABASE_URL=postgres://...

SESSION_SECRET=koi-lamba-random-string

# ---- Site ----
# Live site ka poora URL (emails, sitemap, OG links ke liye zaroori)
SITE_URL=https://your-blog.onrender.com
SITE_NAME=My Blog
# Scheduled posts is timezone ke hisaab se publish hoti hain
SITE_TIMEZONE=Asia/Karachi
# Jab link share ho aur post mein cover image na ho, tab ye image dikhegi (optional)
DEFAULT_OG_IMAGE=

# ---- Community links ----
COMMUNITY_WHATSAPP_URL=https://chat.whatsapp.com/XXXXXXXX
COMMUNITY_FACEBOOK_URL=https://facebook.com/groups/XXXXXXXX
# Optional: WhatsApp Channel (sirf aap post karte hain)
WHATSAPP_CHANNEL_URL=

# ---- Email (newsletter + reply notifications) ----
# Brevo ya Resend ki SMTP details. Khali chhorein to email band rahegi (baaqi site chalti rahegi)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="My Blog <you@yourdomain.com>"

# ---- Home page pagination ----
# Ek page par kitni posts (default 6, max 30)
POSTS_PER_PAGE=6

# ---- Traffic features (V5) ----
# Share-card image: post mein cover na ho tab title wala card banta hai. Cover hone par bhi card chahiye to true:
OG_CARD_ALWAYS=false
# IndexNow key (optional): khali chhorein to khud ban jati hai
INDEXNOW_KEY=
# Push notification keys (optional): khali chhorein to pehli baar khud ban kar database mein save ho jati hain
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- V6: video upload + Hire Me ----
# Video upload ki hadd MB mein (default 30, max 100). Videos database mein save hoti hain, is liye chhoti rakhein.
VIDEO_MAX_MB=30
# Hire Me page ki services (comma se alag, max 10)
HIRE_SERVICES=Video Editing, Web Development, Odoo Customization, Content Creation, Other
# Inquiry kis email par aaye. Khali chhorein to admin account ki email par aayegi.
INQUIRY_EMAIL=

# ---- V10: Email verification + Google login ----
# Signup par verification email tabhi jati hai jab upar SMTP_* set ho (warna account seedha verified ho jata hai).
# Google login: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI bilkul aisi ho:  <SITE_URL>/auth/google/callback
# Khali chhorein to "Continue with Google" button nazar hi nahi aata.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- V12: Images Cloudinary par (free storage, Neon ka 0.5 GB bachta hai) ----
# cloudinary.com par free account -> Dashboard -> "API Environment variable" wali line copy karein.
# Khali chhorein to images pehle ki tarah database mein jati hain.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=blog

# ---- V13: Report / moderation ----
# Itne alag logon ki report par comment khud chhup jata hai (admin review tak). 2 se 20, default 3.
# REPORT_AUTOHIDE=3

# ---- V20: Stories, Groups, PWA ----
# Naya group kaun bana sakta hai. Khali = har login user (max 5 groups). 1 likhein to sirf admin.
# GROUPS_ADMIN_ONLY=1

# ---- Live (V27 / V28) ----
# LIVE_MAX_VIEWERS=6            # bina media server (p2p) ke max viewers (max 15)
# LIVE_ADMIN_ONLY=1             # live sirf admin kare
# LIVEKIT_URL=wss://your-project.livekit.cloud   # teeno set hon to bari audience (media server) mode
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVE_SFU_MAX_VIEWERS=200      # media server mode mein max viewers (max 2000)
# LIVE_RECORD_MAX_MB=60         # live recording ki hadd (0 = recording band, max 200)

# ---- V29: Creators ki kamayi (feed post ke views) + manual withdraw ----
# 1 likhein to kamayi chalu (default band). Pehle migration_v29.sql chalayein.
EARN_ENABLED=0
# Ek view ke kitne paisa. 1 = 100 views par Rs 1
EARN_PAISA_PER_VIEW=1
# Kam az kam withdraw (rupees)
EARN_MIN_WITHDRAW_RS=500
# Ek user ki roz ki zyada se zyada kamayi (rupees). 0 = koi hadd nahi
EARN_DAILY_CAP_RS=200

# ---- V30: Parhne ka inaam + invite ka inaam (migration_v30.sql chalayein) ----
# Post par kitne seconds rehna zaroori (har post sirf ek baar, har user ko)
EARN_READ_SECONDS=60
# Ek post parhne ke paisa (5 = Rs 0.05)
EARN_READ_PAISA=5
# Parhne se roz ki zyada se zyada kamayi (rupees)
EARN_READ_DAILY_CAP_RS=10
# Ek qualified dost ke paisa (100 = Rs 1, yani 10 dost = Rs 10)
EARN_INVITE_PAISA=100
# Invite se zyada se zyada kitne doston ka inaam
EARN_INVITE_MAX=100

# Facebook wall (V43): Facebook se aane wale bina-login visitor ko post ka shuru ka hissa dikhta hai, baqi ke liye signup
# FB_WALL=0 likhein to band. FB_WALL_BLOCKS = kitne paragraph free dikhein (default 3)
FB_WALL=1
FB_WALL_BLOCKS=3

# ---- V46: Shop (sab optional) ----
# 1 = nayi shop pehle "pending", aap /admin/shops se manzoor karein
# SHOP_APPROVAL=1
# 1 = nayi shop sirf admin bana sakta hai (default: har login user)
# SHOP_ADMIN_ONLY=1
# Ek shop mein max products (default 200)
# SHOP_MAX_PRODUCTS=200
